<% content_for :title, "Sign in" %>

<div class="min-h-screen flex items-center justify-center p-6 bg-surface-0 relative overflow-hidden">
  <%# Background layers %>
  <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
    <%= image_tag "bg.jpg", class: "absolute inset-0 w-full h-full object-cover opacity-40" %>
    <div class="absolute inset-0 bg-gradient-to-b from-surface-0/50 via-surface-0/60 to-surface-0"></div>
  </div>

  <div class="relative z-10 w-full max-w-sm" id="login-container">
    <%# Flash messages %>
    <% if flash[:notice] %>
      <div class="mb-4 bg-success/10 text-success px-4 py-3 rounded-lg text-sm font-medium flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        <%= flash[:notice] %>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div class="mb-4 bg-danger/10 text-danger px-4 py-3 rounded-lg text-sm font-medium flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%# Header %>
    <div class="text-center mb-8">
      <a href="<%= root_path %>" class="inline-flex items-center gap-2.5 text-surface-900 font-semibold text-base mb-6">
        <%= image_tag "phish-logo.png", alt: "phish.directory", class: "w-9 h-9 rounded-lg shadow-[0_0_15px_rgba(34,211,238,0.25)]" %>
        <span>phish.directory</span>
      </a>
      <h1 class="text-2xl font-semibold text-surface-900 mb-1">Welcome back</h1>
      <p class="text-surface-500 text-sm">Sign in to your account</p>
    </div>

    <%# Card %>
    <div class="bg-surface-100 rounded-lg p-6">
      <%# Toggle buttons %>
      <div class="flex rounded-md bg-surface-200 p-1 mb-5">
        <button type="button" id="magic-btn" onclick="showMagicForm()"
          class="flex-1 py-2 text-xs font-medium rounded transition-colors bg-surface-0 text-surface-900 shadow-sm">
          Magic Link
        </button>
        <button type="button" id="password-btn" onclick="showPasswordForm()"
          class="flex-1 py-2 text-xs font-medium rounded transition-colors text-surface-500 hover:text-surface-700">
          Password
        </button>
      </div>

      <%# Magic Link Form %>
      <div id="magic-form">
        <div class="bg-accent/5 rounded-md p-3 mb-5">
          <p class="text-xs text-surface-600 leading-relaxed">
            <span class="font-medium text-accent">Passwordless login</span> - We'll send a secure link to your email.
          </p>
        </div>

        <%= form_with url: login_path, method: :post do |f| %>
          <div class="mb-4">
            <label for="email" class="block text-xs font-medium text-surface-600 mb-1.5">Email address</label>
            <%= email_field_tag :email, params[:email],
              class: "w-full px-3 py-2.5 bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 placeholder-surface-500 text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-colors",
              placeholder: "you@example.com",
              autofocus: true,
              required: true %>
          </div>

          <%= submit_tag "Send magic link",
            class: "w-full py-2.5 bg-surface-900 text-surface-0 font-medium text-sm rounded-md hover:bg-surface-800 transition-colors cursor-pointer" %>
        <% end %>
      </div>

      <%# Password Form %>
      <div id="password-form" class="hidden">
        <%= form_with url: password_login_path, method: :post do |f| %>
          <div class="mb-4">
            <label for="email" class="block text-xs font-medium text-surface-600 mb-1.5">Email address</label>
            <%= email_field_tag :email, params[:email],
              class: "w-full px-3 py-2.5 bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 placeholder-surface-500 text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-colors",
              placeholder: "you@example.com",
              required: true %>
          </div>

          <div class="mb-4">
            <div class="flex items-center justify-between mb-1.5">
              <label for="password" class="block text-xs font-medium text-surface-600">Password</label>
              <%= link_to "Forgot password?", forgot_password_path, class: "text-xs text-accent hover:text-accent-dark transition-colors" %>
            </div>
            <%= password_field_tag :password, nil,
              class: "w-full px-3 py-2.5 bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 placeholder-surface-500 text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-colors",
              placeholder: "••••••••",
              required: true %>
          </div>

          <%= submit_tag "Sign in",
            class: "w-full py-2.5 bg-surface-900 text-surface-0 font-medium text-sm rounded-md hover:bg-surface-800 transition-colors cursor-pointer" %>
        <% end %>
      </div>
    </div>

    <%# Footer %>
    <p class="text-center mt-5 text-surface-500 text-sm">
      Don't have an account?
      <%= link_to "Sign up", signup_path, class: "text-surface-700 font-medium hover:text-surface-900 transition-colors" %>
    </p>
  </div>
</div>

<script>
  function showMagicForm() {
    document.getElementById('magic-form').classList.remove('hidden');
    document.getElementById('password-form').classList.add('hidden');
    document.getElementById('magic-btn').className = 'flex-1 py-2 text-xs font-medium rounded transition-colors bg-surface-0 text-surface-900 shadow-sm';
    document.getElementById('password-btn').className = 'flex-1 py-2 text-xs font-medium rounded transition-colors text-surface-500 hover:text-surface-700';
  }

  function showPasswordForm() {
    document.getElementById('magic-form').classList.add('hidden');
    document.getElementById('password-form').classList.remove('hidden');
    document.getElementById('password-btn').className = 'flex-1 py-2 text-xs font-medium rounded transition-colors bg-surface-0 text-surface-900 shadow-sm';
    document.getElementById('magic-btn').className = 'flex-1 py-2 text-xs font-medium rounded transition-colors text-surface-500 hover:text-surface-700';
  }
</script>
