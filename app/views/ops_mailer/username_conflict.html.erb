<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; line-height: 1.6; color: #1a1a1a; margin: 0; padding: 0; background-color: #f5f5f5;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #f5f5f5; padding: 40px 20px;">
    <tr>
      <td align="center">
        <table width="560" cellpadding="0" cellspacing="0" style="background: #ffffff; border-radius: 8px; overflow: hidden;">
          <!-- Header -->
          <tr>
            <td style="background: #f59e0b; padding: 20px 24px;">
              <span style="font-size: 16px; font-weight: 600; color: #ffffff;">Username Conflict - Action Required</span>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding: 24px;">
              <p style="margin: 0 0 16px; color: #4a4a4a; font-size: 14px;">A user signup failed because all username variants were taken.</p>

              <!-- Warning info block -->
              <table width="100%" cellpadding="0" cellspacing="0" style="background: #fef3c7; border: 1px solid #fcd34d; border-radius: 6px;">
                <tr>
                  <td style="padding: 16px;">
                    <table width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td style="padding: 6px 0;">
                          <span style="font-size: 11px; font-weight: 600; color: #92400e; text-transform: uppercase;">Email</span><br>
                          <span style="font-family: monospace; color: #1a1a1a; font-size: 14px;"><%= @email %></span>
                        </td>
                      </tr>
                      <tr>
                        <td style="padding: 6px 0; border-top: 1px solid #fcd34d;">
                          <span style="font-size: 11px; font-weight: 600; color: #92400e; text-transform: uppercase;">Desired Username</span><br>
                          <span style="font-family: monospace; color: #1a1a1a; font-size: 14px;">@<%= @desired_username %></span>
                        </td>
                      </tr>
                      <tr>
                        <td style="padding: 6px 0; border-top: 1px solid #fcd34d;">
                          <span style="font-size: 11px; font-weight: 600; color: #92400e; text-transform: uppercase;">Timestamp</span><br>
                          <span style="font-family: monospace; color: #1a1a1a; font-size: 14px;"><%= @timestamp.strftime("%Y-%m-%d %H:%M:%S UTC") %></span>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- Action block -->
              <table width="100%" cellpadding="0" cellspacing="0" style="background: #f9f9f9; border-radius: 6px; margin-top: 16px;">
                <tr>
                  <td style="padding: 16px;">
                    <span style="font-weight: 600; color: #1a1a1a;">Action Required:</span>
                    <span style="color: #4a4a4a;"> Please manually create a username for this user and reach out to them within 24 hours.</span>
                  </td>
                </tr>
              </table>

              <!-- Footer -->
              <p style="margin: 24px 0 0; font-size: 12px; color: #888888;">This is an automated notification from phish.directory ops.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
