<%# Command-K Quick Search Modal %>
<%# Include this partial in any layout where you want Command-K available %>

<% if user_signed_in? %>
<div data-controller="command-palette"
     data-command-palette-is-admin-value="<%= current_user.admin? %>"
     data-command-palette-search-url-value="<%= current_user.admin? ? admin_quick_search_path : "" %>">
<%# Embed navigation data directly - no API call needed for initial load %>
<script type="application/json" data-command-palette-data nonce="<%= content_security_policy_nonce %>">
{
  "navigation": [
    { "id": "nav-dashboard", "name": "Dashboard", "section": "Navigation", "url": "<%= dashboard_root_path %>", "keywords": "home main" },
    { "id": "nav-check-domain", "name": "Check Domain", "section": "Navigation", "url": "<%= dashboard_domain_check_path %>", "keywords": "scan phishing verify check domain" },
    { "id": "nav-check-url", "name": "Check URL", "section": "Navigation", "url": "<%= dashboard_url_check_path %>", "keywords": "scan phishing verify check url link" },
    { "id": "nav-check-email", "name": "Check Email", "section": "Navigation", "url": "<%= dashboard_email_check_path %>", "keywords": "scan fraud verify check email address" },
    { "id": "nav-check-phone", "name": "Check Phone", "section": "Navigation", "url": "<%= dashboard_phone_check_path %>", "keywords": "scan scam verify check phone number" },
    { "id": "nav-api-keys", "name": "API Keys", "section": "Navigation", "url": "<%= dashboard_api_keys_path %>", "keywords": "keys tokens auth" },
    { "id": "nav-profile", "name": "Profile Settings", "section": "Navigation", "url": "<%= dashboard_profile_path %>", "keywords": "account settings user" },
    { "id": "nav-sessions", "name": "Active Sessions", "section": "Navigation", "url": "<%= dashboard_sessions_path %>", "keywords": "devices login" },
    { "id": "nav-docs", "name": "API Documentation", "section": "Navigation", "url": "<%= docs_path %>", "keywords": "api reference help" }
  ],
  "trusted_navigation": <%= current_user.trusted? ? [
    { id: "trusted-classifications", name: "Classifications", section: "Trusted", url: dashboard_classifications_path, keywords: "classify scam category vote", role: "trusted" }
  ].to_json.html_safe : "[]" %>,
  "admin_navigation": <%= current_user.admin? ? [
    { id: "admin-dashboard", name: "Admin Dashboard", section: "Admin", url: admin_root_path, keywords: "admin panel", role: "admin" },
    { id: "admin-users", name: "Manage Users", section: "Admin: Management", url: admin_users_path, keywords: "users accounts", role: "admin" },
    { id: "admin-services", name: "Manage Services", section: "Admin: Management", url: admin_services_path, keywords: "services api clients", role: "admin" },
    { id: "admin-domains", name: "Phishing Domains", section: "Admin: Phishing Data", url: admin_domains_path, keywords: "domains phishing", role: "admin" },
    { id: "admin-urls", name: "Phishing URLs", section: "Admin: Phishing Data", url: admin_urls_path, keywords: "urls phishing links", role: "admin" },
    { id: "admin-verdicts", name: "Verdicts", section: "Admin: Phishing Data", url: admin_verdicts_path, keywords: "verdicts classifications confidence", role: "admin" },
    { id: "admin-protections", name: "Protected Domains", section: "Admin: Phishing Data", url: admin_protections_path, keywords: "protected whitelist safe", role: "admin" },
    { id: "admin-api-requests", name: "API Requests", section: "Admin: Monitoring", url: admin_api_requests_path, keywords: "api requests logs debug", role: "admin" },
    { id: "admin-webhook-deliveries", name: "Webhook Deliveries", section: "Admin: Monitoring", url: admin_webhook_deliveries_path, keywords: "webhooks deliveries retry", role: "admin" },
    { id: "admin-abuse-contacts", name: "Abuse Contacts", section: "Admin: Reporting", url: admin_report_abuse_contacts_path, keywords: "abuse contacts registrar hosting report", role: "admin" },
    { id: "admin-report-cases", name: "Report Cases", section: "Admin: Reporting", url: admin_report_cases_path, keywords: "cases reports submissions takedown", role: "admin" },
    { id: "admin-flipper", name: "Feature Flags", section: "Admin: Tools", url: "/admin/flipper", keywords: "flags features toggle", role: "admin" },
    { id: "admin-jobs", name: "Background Jobs", section: "Admin: Tools", url: "/admin/jobs", keywords: "jobs queue workers", role: "admin" },
    { id: "admin-blazer", name: "Analytics (Blazer)", section: "Admin: Tools", url: "/admin/blazer", keywords: "analytics sql queries", role: "admin" },
    { id: "admin-pghero", name: "Database (PgHero)", section: "Admin: Tools", url: "/admin/pghero", keywords: "database postgres", role: "admin" },
    { id: "admin-console", name: "Console Audits", section: "Admin: Tools", url: "/admin/console_audits", keywords: "console logs audit", role: "admin" }
  ].to_json.html_safe : "[]" %>,
  "is_admin": <%= current_user.admin? %>,
  "is_trusted": <%= current_user.trusted? %>
}
</script>

<%# Touch users cannot press Cmd-K, so the palette needs a visible way in. %>
<button type="button"
        data-action="command-palette#toggle"
        class="md:hidden fixed bottom-5 right-5 z-[90] w-12 h-12 rounded-full bg-accent text-surface-0 shadow-lg flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-surface-0"
        aria-label="Open quick search">
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
  </svg>
</button>

<div data-command-palette-target="modal"
     class="fixed inset-0 z-[100] hidden"
     role="dialog"
     aria-modal="true"
     aria-label="Quick search"
     aria-hidden="true">
  <%# Backdrop %>
  <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" data-action="click->command-palette#close"></div>

  <%# Modal %>
  <div class="absolute inset-0 flex items-start justify-center pt-[15vh] px-4 pointer-events-none">
    <div data-command-palette-target="container" class="pointer-events-auto w-full max-w-xl bg-surface-100 rounded-lg shadow-2xl overflow-hidden transform scale-95 opacity-0 transition-all duration-150">
      <%# Search Input %>
      <div class="flex items-center gap-3 px-4 py-3 border-b border-surface-200/50">
        <svg class="w-4 h-4 text-surface-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input
          data-command-palette-target="input"
          data-action="keydown->command-palette#navigate input->command-palette#search"
          type="text"
          aria-label="Search"
          placeholder="Search..."
          class="flex-1 bg-transparent text-surface-900 placeholder-surface-500 text-sm outline-none"
          autocomplete="off"
          spellcheck="false"
        >
        <kbd class="hidden sm:inline-flex items-center px-1.5 py-0.5 text-[10px] text-surface-500 bg-surface-200 rounded">esc</kbd>
      </div>

      <%# Results %>
      <div class="max-h-[50vh] overflow-y-auto" role="listbox" aria-label="Search results">
        <div data-command-palette-target="loading" class="hidden px-4 py-8 text-center">
          <div class="inline-block w-4 h-4 border-2 border-surface-300 border-t-accent rounded-full animate-spin"></div>
        </div>
        <div data-command-palette-target="content"></div>
        <div data-command-palette-target="empty" class="hidden px-4 py-8 text-center text-surface-500 text-sm">No results found</div>
      </div>

      <%# Footer %>
      <div class="px-4 py-2.5 border-t border-surface-200/50 flex items-center justify-between text-[10px] text-surface-500">
        <div class="flex items-center gap-3">
          <span class="flex items-center gap-1">
            <kbd class="px-1 py-0.5 bg-surface-200 rounded text-surface-600">&#8593;&#8595;</kbd>
            navigate
          </span>
          <span class="flex items-center gap-1">
            <kbd class="px-1 py-0.5 bg-surface-200 rounded text-surface-600">&#8629;</kbd>
            select
          </span>
        </div>
        <span class="flex items-center gap-1">
          <kbd class="px-1 py-0.5 bg-surface-200 rounded text-surface-600">&#8984;K</kbd>
        </span>
      </div>
    </div>
  </div>
</div>

</div>
<% end %>
