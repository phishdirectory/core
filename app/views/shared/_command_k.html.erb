<%# Command-K Quick Search Modal %>
<%# Include this partial in any layout where you want Command-K available %>

<% if user_signed_in? %>
<%# Embed navigation data directly - no API call needed for initial load %>
<script type="application/json" id="command-k-data" nonce="<%= content_security_policy_nonce %>">
{
  "navigation": [
    { "id": "nav-dashboard", "name": "Dashboard", "section": "Navigation", "url": "<%= dashboard_root_path %>", "keywords": "home main" },
    { "id": "nav-check", "name": "Check Domain/URL", "section": "Navigation", "url": "<%= dashboard_domain_check_path %>", "keywords": "scan phishing verify check" },
    { "id": "nav-api-keys", "name": "API Keys", "section": "Navigation", "url": "<%= dashboard_api_keys_path %>", "keywords": "keys tokens auth" },
    { "id": "nav-profile", "name": "Profile Settings", "section": "Navigation", "url": "<%= dashboard_profile_path %>", "keywords": "account settings user" },
    { "id": "nav-sessions", "name": "Active Sessions", "section": "Navigation", "url": "<%= dashboard_sessions_path %>", "keywords": "devices login" },
    { "id": "nav-docs", "name": "API Documentation", "section": "Navigation", "url": "<%= docs_path %>", "keywords": "api reference help" }
  ],
  "admin_navigation": <%= current_user.admin? ? [
    { id: "admin-dashboard", name: "Admin Dashboard", section: "Admin", url: admin_root_path, keywords: "admin panel" },
    { id: "admin-users", name: "Manage Users", section: "Admin", url: admin_users_path, keywords: "users accounts" },
    { id: "admin-services", name: "Manage Services", section: "Admin", url: admin_services_path, keywords: "services api clients" },
    { id: "admin-domains", name: "Phishing Domains", section: "Admin", url: admin_domains_path, keywords: "domains phishing" },
    { id: "admin-urls", name: "Phishing URLs", section: "Admin", url: admin_urls_path, keywords: "urls phishing links" },
    { id: "admin-abuse-contacts", name: "Abuse Contacts", section: "Admin", url: admin_report_abuse_contacts_path, keywords: "abuse contacts registrar hosting report" },
    { id: "admin-report-cases", name: "Report Cases", section: "Admin", url: admin_report_cases_path, keywords: "cases reports submissions takedown" },
    { id: "admin-flipper", name: "Feature Flags", section: "Admin Tools", url: "/admin/flipper", keywords: "flags features toggle" },
    { id: "admin-jobs", name: "Background Jobs", section: "Admin Tools", url: "/admin/jobs", keywords: "jobs queue workers" },
    { id: "admin-blazer", name: "Analytics (Blazer)", section: "Admin Tools", url: "/admin/blazer", keywords: "analytics sql queries" },
    { id: "admin-pghero", name: "Database (PgHero)", section: "Admin Tools", url: "/admin/pghero", keywords: "database postgres" },
    { id: "admin-console", name: "Console Audits", section: "Admin Tools", url: "/admin/console_audits", keywords: "console logs audit" }
  ].to_json.html_safe : "[]" %>,
  "is_admin": <%= current_user.admin? %>
}
</script>

<div id="command-k-modal" class="fixed inset-0 z-[100] hidden">
  <%# Backdrop %>
  <div id="command-k-backdrop" class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>

  <%# Modal %>
  <div class="absolute inset-0 flex items-start justify-center pt-[15vh] px-4">
    <div id="command-k-container" class="w-full max-w-xl bg-surface-100 rounded-lg shadow-2xl overflow-hidden transform scale-95 opacity-0 transition-all duration-150">
      <%# Search Input %>
      <div class="flex items-center gap-3 px-4 py-3 border-b border-surface-200/50">
        <svg class="w-4 h-4 text-surface-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input
          id="command-k-input"
          type="text"
          placeholder="Search..."
          class="flex-1 bg-transparent text-surface-900 placeholder-surface-500 text-sm outline-none"
          autocomplete="off"
          spellcheck="false"
        >
        <kbd class="hidden sm:inline-flex items-center px-1.5 py-0.5 text-[10px] text-surface-500 bg-surface-200 rounded">esc</kbd>
      </div>

      <%# Results %>
      <div id="command-k-results" class="max-h-[50vh] overflow-y-auto">
        <div id="command-k-loading" class="hidden px-4 py-8 text-center">
          <div class="inline-block w-4 h-4 border-2 border-surface-300 border-t-accent rounded-full animate-spin"></div>
        </div>
        <div id="command-k-content"></div>
        <div id="command-k-empty" class="hidden px-4 py-8 text-center text-surface-500 text-sm">No results found</div>
      </div>

      <%# Footer %>
      <div class="px-4 py-2.5 border-t border-surface-200/50 flex items-center justify-between text-[10px] text-surface-500">
        <div class="flex items-center gap-3">
          <span class="flex items-center gap-1">
            <kbd class="px-1 py-0.5 bg-surface-200 rounded text-surface-600">&#8593;&#8595;</kbd>
            navigate
          </span>
          <span class="flex items-center gap-1">
            <kbd class="px-1 py-0.5 bg-surface-200 rounded text-surface-600">&#8629;</kbd>
            select
          </span>
        </div>
        <span class="flex items-center gap-1">
          <kbd class="px-1 py-0.5 bg-surface-200 rounded text-surface-600">&#8984;K</kbd>
        </span>
      </div>
    </div>
  </div>
</div>

<script nonce="<%= content_security_policy_nonce %>">
(function() {
  var modal = document.getElementById('command-k-modal');
  if (!modal) return;

  var backdrop = document.getElementById('command-k-backdrop');
  var container = document.getElementById('command-k-container');
  var input = document.getElementById('command-k-input');
  var content = document.getElementById('command-k-content');
  var empty = document.getElementById('command-k-empty');
  var loadingEl = document.getElementById('command-k-loading');

  // Load embedded data
  var dataEl = document.getElementById('command-k-data');
  var data = JSON.parse(dataEl.textContent);
  var navigation = data.navigation || [];
  var adminNavigation = data.admin_navigation || [];
  var isAdmin = data.is_admin;
  var allItems = navigation.concat(adminNavigation);

  var selectedIndex = 0;
  var filteredItems = allItems;
  var searchTimeout = null;

  var badgeColors = {
    emerald: 'bg-success/10 text-success',
    amber: 'bg-warning/10 text-warning',
    red: 'bg-danger/10 text-danger',
    cyan: 'bg-accent/10 text-accent',
    purple: 'bg-purple-500/10 text-purple-400',
    slate: 'bg-surface-300 text-surface-600'
  };

  function openModal() {
    modal.classList.remove('hidden');
    setTimeout(function() {
      container.classList.remove('scale-95', 'opacity-0');
      container.classList.add('scale-100', 'opacity-100');
      input.focus();
      input.value = '';
      filteredItems = allItems;
      selectedIndex = 0;
      renderItems(allItems);
    }, 10);
  }

  function closeModal() {
    container.classList.remove('scale-100', 'opacity-100');
    container.classList.add('scale-95', 'opacity-0');
    setTimeout(function() {
      modal.classList.add('hidden');
    }, 150);
  }

  function escapeText(str) { return str ? String(str) : ''; }

  function createSectionHeader(name) {
    var h = document.createElement('div');
    h.className = 'px-4 py-2 text-[10px] font-semibold text-surface-500 uppercase tracking-wider bg-surface-200/50 sticky top-0';
    h.textContent = name;
    return h;
  }

  function createItem(item, index) {
    var el = document.createElement('div');
    el.className = 'command-k-item flex items-center gap-3 px-4 py-2.5 cursor-pointer transition-colors';
    el.dataset.index = index;
    el.dataset.url = item.url || '#';
    if (item.method) el.dataset.method = item.method;

    var textDiv = document.createElement('div');
    textDiv.className = 'flex-1 min-w-0';

    var nameDiv = document.createElement('div');
    nameDiv.className = 'text-sm font-medium text-surface-800';
    nameDiv.textContent = escapeText(item.name);
    textDiv.appendChild(nameDiv);

    if (item.subtitle) {
      var subDiv = document.createElement('div');
      subDiv.className = 'text-xs text-surface-500 truncate';
      subDiv.textContent = escapeText(item.subtitle);
      textDiv.appendChild(subDiv);
    }

    el.appendChild(textDiv);

    if (item.badge) {
      var badge = document.createElement('span');
      badge.className = 'px-1.5 py-0.5 text-[10px] rounded font-medium ' + (badgeColors[item.badge_color] || badgeColors.slate);
      badge.textContent = escapeText(item.badge);
      el.appendChild(badge);
    }

    el.addEventListener('mouseenter', function() { selectedIndex = index; updateSelection(); });
    el.addEventListener('click', function() { selectedIndex = index; selectItem(); });

    return el;
  }

  function renderItems(items) {
    filteredItems = items;
    while (content.firstChild) content.removeChild(content.firstChild);
    loadingEl.classList.add('hidden');

    if (items.length === 0) {
      content.classList.add('hidden');
      empty.classList.remove('hidden');
      return;
    }

    empty.classList.add('hidden');
    content.classList.remove('hidden');

    var currentSection = null;
    items.forEach(function(item, i) {
      var section = item.section || 'Results';
      if (section !== currentSection) {
        content.appendChild(createSectionHeader(section));
        currentSection = section;
      }
      content.appendChild(createItem(item, i));
    });

    updateSelection();
  }

  function updateSelection() {
    var items = content.querySelectorAll('.command-k-item');
    items.forEach(function(item, i) {
      if (i === selectedIndex) {
        item.classList.add('bg-surface-200');
        item.scrollIntoView({ block: 'nearest' });
      } else {
        item.classList.remove('bg-surface-200');
      }
    });
  }

  function selectItem() {
    if (filteredItems.length === 0 || !filteredItems[selectedIndex]) return;
    var item = filteredItems[selectedIndex];
    if (item.method === 'delete') {
      var form = document.createElement('form');
      form.method = 'post';
      form.action = item.url;
      var m = document.createElement('input'); m.type = 'hidden'; m.name = '_method'; m.value = 'delete';
      var t = document.createElement('input'); t.type = 'hidden'; t.name = 'authenticity_token';
      t.value = document.querySelector('meta[name="csrf-token"]').content;
      form.appendChild(m); form.appendChild(t);
      document.body.appendChild(form);
      form.submit();
    } else {
      window.location.href = item.url;
    }
  }

  function filterLocal(query) {
    if (!query) return allItems;
    var q = query.toLowerCase();
    return allItems.filter(function(item) {
      var text = (item.name + ' ' + (item.subtitle || '') + ' ' + (item.keywords || '')).toLowerCase();
      return text.indexOf(q) !== -1;
    });
  }

  function search(query) {
    if (!query) {
      renderItems(allItems);
      return;
    }

    // First filter local navigation
    var localResults = filterLocal(query);

    // Only search API for admin users when query looks like an ID or email
    var shouldSearchAPI = isAdmin && (
      query.indexOf('@') !== -1 ||
      query.match(/^(usr_|svc_|dom_|url_|PDU)/i) ||
      query.length >= 3
    );

    if (!shouldSearchAPI) {
      renderItems(localResults);
      return;
    }

    loadingEl.classList.remove('hidden');
    content.classList.add('hidden');

    fetch('/admin/quick_search?q=' + encodeURIComponent(query), { headers: { 'Accept': 'application/json' } })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        var apiResults = data.results || [];
        renderItems(localResults.concat(apiResults));
      })
      .catch(function() {
        renderItems(localResults);
      });
  }

  // Global keyboard shortcuts
  document.addEventListener('keydown', function(e) {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      modal.classList.contains('hidden') ? openModal() : closeModal();
    }
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
      e.preventDefault();
      closeModal();
    }
  });

  // Input-specific keyboard handling (arrow keys, enter)
  input.addEventListener('keydown', function(e) {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (selectedIndex < filteredItems.length - 1) { selectedIndex++; updateSelection(); }
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (selectedIndex > 0) { selectedIndex--; updateSelection(); }
    } else if (e.key === 'Enter') {
      e.preventDefault();
      selectItem();
    }
  });

  backdrop.addEventListener('click', closeModal);
  input.addEventListener('input', function(e) {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(function() { search(e.target.value.trim()); }, 150);
  });
})();
</script>
<% end %>
