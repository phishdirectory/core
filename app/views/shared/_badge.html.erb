<%#
  A status pill.

  Badges were inlined at least eight times across the dashboard with
  hand-written colour classes, which is how the account status badge ended up
  hardcoded to green regardless of the status it displayed.

  Accepts:
    label: text to show
    tone:  :success | :warning | :danger | :info | :accent | :neutral
%>
<% tones = {
     success: "bg-success/10 text-success",
     warning: "bg-warning/10 text-warning",
     danger:  "bg-danger/10 text-danger",
     info:    "bg-info/10 text-info",
     accent:  "bg-accent/10 text-accent",
     neutral: "bg-surface-200 text-surface-600"
   } %>
<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= tones.fetch(tone, tones[:neutral]) %>"><%= label %></span>
