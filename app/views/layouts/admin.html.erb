<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content_for?(:title) ? "#{yield(:title)} | Admin | phish.directory" : "Admin | phish.directory" %></title>

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
</head>
<body class="bg-surface-0 text-surface-800 font-sans min-h-screen antialiased overflow-x-hidden">
  <%# Background layers %>
  <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden">
    <%= image_tag "bg.jpg", class: "absolute inset-0 w-full h-full object-cover opacity-40" %>
    <div class="absolute inset-0 bg-surface-0/60"></div>
  </div>

  <div class="relative z-10 flex min-h-screen">
    <%# Sidebar %>
    <aside class="w-56 bg-surface-50/70 backdrop-blur-xl flex flex-col fixed top-0 left-0 bottom-0 z-50">
      <%# Logo %>
      <div class="h-14 px-4 flex items-center border-b border-surface-200/50">
        <a href="<%= admin_root_path %>" class="flex items-center gap-2.5 text-surface-900 font-semibold text-sm">
          <%= image_tag "phish-logo.png", alt: "phish.directory", class: "w-8 h-8 rounded-lg shadow-[0_0_15px_rgba(34,211,238,0.25)]" %>
          <span>Admin Panel</span>
        </a>
      </div>

      <%# Navigation %>
      <nav class="flex-1 px-3 py-4 overflow-y-auto">
        <div class="mb-6">
          <div class="text-[10px] font-semibold text-surface-500 uppercase tracking-wider px-2 mb-2">Overview</div>
          <%= link_to admin_root_path, class: "flex items-center gap-2.5 px-2.5 py-2 rounded-md text-sm font-medium transition-colors #{controller_path == 'admin/dashboard' ? 'bg-accent/10 text-accent' : 'text-surface-600 hover:bg-surface-100 hover:text-surface-800'}" do %>
            <svg class="w-4 h-4 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
            <span>Dashboard</span>
          <% end %>
        </div>

        <div class="mb-6">
          <div class="text-[10px] font-semibold text-surface-500 uppercase tracking-wider px-2 mb-2">Management</div>
          <%= link_to admin_users_path, class: "flex items-center gap-2.5 px-2.5 py-2 rounded-md text-sm font-medium transition-colors #{controller_path == 'admin/users' ? 'bg-accent/10 text-accent' : 'text-surface-600 hover:bg-surface-100 hover:text-surface-800'}" do %>
            <svg class="w-4 h-4 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            <span>Users</span>
          <% end %>
          <%= link_to admin_services_path, class: "flex items-center gap-2.5 px-2.5 py-2 rounded-md text-sm font-medium transition-colors #{controller_path == 'admin/services' ? 'bg-accent/10 text-accent' : 'text-surface-600 hover:bg-surface-100 hover:text-surface-800'}" do %>
            <svg class="w-4 h-4 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/></svg>
            <span>Services</span>
          <% end %>
        </div>

        <div class="mb-6">
          <div class="text-[10px] font-semibold text-surface-500 uppercase tracking-wider px-2 mb-2">Phishing Data</div>
          <%= link_to admin_protections_path, class: "flex items-center gap-2.5 px-2.5 py-2 rounded-md text-sm font-medium transition-colors #{controller_path == 'admin/protections' ? 'bg-accent/10 text-accent' : 'text-surface-600 hover:bg-surface-100 hover:text-surface-800'}" do %>
            <svg class="w-4 h-4 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            <span>Protected</span>
          <% end %>
        </div>

        <div class="mb-6">
          <div class="text-[10px] font-semibold text-surface-500 uppercase tracking-wider px-2 mb-2">Reporting</div>
          <%= link_to admin_report_abuse_contacts_path, class: "flex items-center gap-2.5 px-2.5 py-2 rounded-md text-sm font-medium transition-colors #{controller_path == 'admin/report/abuse_contacts' ? 'bg-accent/10 text-accent' : 'text-surface-600 hover:bg-surface-100 hover:text-surface-800'}" do %>
            <svg class="w-4 h-4 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <span>Abuse Contacts</span>
          <% end %>
          <%= link_to admin_report_cases_path, class: "flex items-center gap-2.5 px-2.5 py-2 rounded-md text-sm font-medium transition-colors #{controller_path == 'admin/report/cases' ? 'bg-accent/10 text-accent' : 'text-surface-600 hover:bg-surface-100 hover:text-surface-800'}" do %>
            <svg class="w-4 h-4 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
            <span>Report Cases</span>
          <% end %>
        </div>

        <div class="mb-6">
          <div class="text-[10px] font-semibold text-surface-500 uppercase tracking-wider px-2 mb-2">Tools</div>
          <a href="/admin/flipper" class="flex items-center gap-2.5 px-2.5 py-2 rounded-md text-sm font-medium text-surface-600 hover:bg-surface-100 hover:text-surface-800 transition-colors">
            <svg class="w-4 h-4 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
            <span>Feature Flags</span>
          </a>
          <a href="/admin/jobs" class="flex items-center gap-2.5 px-2.5 py-2 rounded-md text-sm font-medium text-surface-600 hover:bg-surface-100 hover:text-surface-800 transition-colors">
            <svg class="w-4 h-4 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            <span>Background Jobs</span>
          </a>
          <a href="/admin/blazer" class="flex items-center gap-2.5 px-2.5 py-2 rounded-md text-sm font-medium text-surface-600 hover:bg-surface-100 hover:text-surface-800 transition-colors">
            <svg class="w-4 h-4 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
            <span>Analytics</span>
          </a>
          <a href="/admin/console_audits" class="flex items-center gap-2.5 px-2.5 py-2 rounded-md text-sm font-medium text-surface-600 hover:bg-surface-100 hover:text-surface-800 transition-colors">
            <svg class="w-4 h-4 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span>Console Audits</span>
          </a>
          <a href="/admin/pghero" class="flex items-center gap-2.5 px-2.5 py-2 rounded-md text-sm font-medium text-surface-600 hover:bg-surface-100 hover:text-surface-800 transition-colors">
            <svg class="w-4 h-4 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/></svg>
            <span>Database Monitor</span>
          </a>
        </div>

        <div class="mb-6">
          <div class="text-[10px] font-semibold text-surface-500 uppercase tracking-wider px-2 mb-2">Navigation</div>
          <%= link_to docs_path, class: "flex items-center gap-2.5 px-2.5 py-2 rounded-md text-sm font-medium text-surface-600 hover:bg-surface-100 hover:text-surface-800 transition-colors" do %>
            <svg class="w-4 h-4 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
            <span>Documentation</span>
          <% end %>
          <%= link_to dashboard_root_path, class: "flex items-center gap-2.5 px-2.5 py-2 rounded-md text-sm font-medium text-surface-600 hover:bg-surface-100 hover:text-surface-800 transition-colors" do %>
            <svg class="w-4 h-4 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 17l-5-5m0 0l5-5m-5 5h12"/></svg>
            <span>Back to Dashboard</span>
          <% end %>
        </div>
      </nav>

      <%# User section %>
      <div class="p-3 border-t border-surface-200/50">
        <%= link_to dashboard_profile_path, class: "flex items-center gap-2.5 px-2 py-2 rounded-md hover:bg-surface-100 transition-colors" do %>
          <div class="w-8 h-8 bg-surface-200 rounded-full flex items-center justify-center font-medium text-xs text-surface-600">
            <%= current_user.initials %>
          </div>
          <div class="flex-1 min-w-0">
            <div class="font-medium text-sm text-surface-800 truncate"><%= current_user.full_name %></div>
            <div class="text-xs text-surface-500 truncate"><%= current_user.email %></div>
          </div>
        <% end %>
        <%= button_to logout_path, method: :delete, class: "w-full mt-2 px-3 py-2 text-sm font-medium text-surface-600 bg-surface-100 rounded-md hover:bg-surface-200 hover:text-surface-700 transition-colors cursor-pointer" do %>
          Sign out
        <% end %>
      </div>
    </aside>

    <%# Main Content %>
    <main class="flex-1 ml-56 min-h-screen">
      <% if impersonating? %>
        <div class="bg-warning/10 px-6 py-2 flex items-center justify-between text-sm text-warning">
          <span>Impersonating <%= current_user.full_name %></span>
          <%= button_to "Stop", admin_stop_impersonating_path, method: :delete, class: "px-2.5 py-1 text-xs font-medium bg-surface-100 text-surface-700 rounded-md hover:bg-surface-200 transition-colors cursor-pointer" %>
        </div>
      <% end %>

      <% if flash[:notice] || flash[:alert] %>
        <div class="px-8 pt-4">
          <% if flash[:notice] %>
            <div class="bg-success/10 text-success px-4 py-3 rounded-lg text-sm font-medium flex items-center gap-2 mb-4 animate-slide-down">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <%= flash[:notice] %>
            </div>
          <% end %>
          <% if flash[:alert] %>
            <div class="bg-danger/10 text-danger px-4 py-3 rounded-lg text-sm font-medium flex items-center gap-2 mb-4 animate-slide-down">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
              <%= flash[:alert] %>
            </div>
          <% end %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </div>

  <%= render "shared/command_k" %>
</body>
</html>
