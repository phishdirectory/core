      <%# Collapsible navigation JavaScript %>
      <script nonce="<%= content_security_policy_nonce %>">
        (function() {
          const STORAGE_KEY = 'admin_nav_collapsed_v2';

          function getCollapsedState() {
            try {
              return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {};
            } catch {
              return {};
            }
          }

          function saveCollapsedState(state) {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
          }

          function initNav() {
            const sections = document.querySelectorAll('[data-nav-section]');
            const state = getCollapsedState();

            sections.forEach(section => {
              const sectionName = section.dataset.navSection;
              const toggle = section.querySelector('[data-nav-toggle]');
              const content = section.querySelector('[data-nav-content]');
              const chevron = section.querySelector('[data-nav-chevron]');
              const defaultCollapsed = section.dataset.navDefaultCollapsed === 'true';

              // Determine initial state (use saved state if exists, otherwise use default)
              let isCollapsed = state.hasOwnProperty(sectionName)
                ? state[sectionName]
                : defaultCollapsed;

              // Store current state on the element for toggle logic
              section.dataset.collapsed = isCollapsed;

              // Apply initial state
              if (isCollapsed) {
                content.style.maxHeight = '0';
                content.style.opacity = '0';
                chevron.style.transform = 'rotate(-90deg)';
              } else {
                content.style.maxHeight = content.scrollHeight + 'px';
                content.style.opacity = '1';
                chevron.style.transform = 'rotate(0deg)';
              }

              // Add click handler (only once)
              if (!toggle.dataset.initialized) {
                toggle.dataset.initialized = 'true';
                toggle.addEventListener('click', () => {
                  const wasCollapsed = section.dataset.collapsed === 'true';
                  const nowCollapsed = !wasCollapsed;

                  if (nowCollapsed) {
                    content.style.maxHeight = '0';
                    content.style.opacity = '0';
                    chevron.style.transform = 'rotate(-90deg)';
                  } else {
                    content.style.maxHeight = content.scrollHeight + 'px';
                    content.style.opacity = '1';
                    chevron.style.transform = 'rotate(0deg)';
                  }

                  section.dataset.collapsed = nowCollapsed;
                  const currentState = getCollapsedState();
                  currentState[sectionName] = nowCollapsed;
                  saveCollapsedState(currentState);
                });
              }
            });
          }

          // Initialize on DOM ready
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initNav);
          } else {
            initNav();
          }

          // Re-initialize on Turbo navigation
          document.addEventListener('turbo:load', initNav);
        })();
      </script>

      <%# User section %>
      <div class="p-3 border-t border-surface-200/50">
        <%= link_to dashboard_profile_path, class: "flex items-center gap-2.5 px-2 py-2 rounded-md hover:bg-surface-100 transition-colors" do %>
          <div class="w-8 h-8 bg-surface-200 rounded-full flex items-center justify-center font-medium text-xs text-surface-600">
            <% if current_user.has_profile_photo? %>
              <%= image_tag current_user.profile_photo_url(variant: :thumb), class: "w-full h-full object-cover rounded-full" %>
            <% else %>
              <%= current_user.initials %>
            <% end %>
          </div>
          <div class="flex-1 min-w-0">
            <div class="font-medium text-sm text-surface-800 truncate"><%= current_user.full_name %></div>
            <div class="text-xs text-surface-500 truncate"><%= current_user.pd_id %></div>
          </div>
        <% end %>
        <%= button_to logout_path, method: :delete, class: "w-full mt-2 px-3 py-2 text-sm font-medium text-surface-600 bg-surface-100 rounded-md hover:bg-surface-200 hover:text-surface-700 transition-colors cursor-pointer" do %>
          Sign out
        <% end %>
      </div>
    </aside>

    <%# Main Content %>
    <main class="flex-1 ml-56 min-h-screen">
      <% if impersonating? %>
        <div class="bg-warning/10 px-6 py-2 flex items-center justify-between text-sm text-warning">
          <span>Impersonating <%= current_user.full_name %></span>
          <%= button_to "Stop", admin_stop_impersonating_path, method: :delete, class: "px-2.5 py-1 text-xs font-medium bg-surface-100 text-surface-700 rounded-md hover:bg-surface-200 transition-colors cursor-pointer" %>
        </div>
      <% end %>

      <% if flash[:notice] || flash[:alert] %>
        <div class="px-8 pt-4">
          <% if flash[:notice] %>
            <div class="bg-success/10 text-success px-4 py-3 rounded-lg text-sm font-medium flex items-center gap-2 mb-4 animate-slide-down">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <%= flash[:notice] %>
            </div>
          <% end %>
          <% if flash[:alert] %>
            <div class="bg-danger/10 text-danger px-4 py-3 rounded-lg text-sm font-medium flex items-center gap-2 mb-4 animate-slide-down">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
              <%= flash[:alert] %>
            </div>
          <% end %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </div>

  <%= render "shared/command_k" %>
</body>
</html>
