<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>phish.directory Case Report</title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      font-size: 12px;
      line-height: 1.5;
      color: #1a1a1a;
      margin: 0;
      padding: 20px;
    }

    h1 {
      font-size: 24px;
      margin: 0 0 10px;
      color: #111;
    }

    h2 {
      font-size: 16px;
      margin: 20px 0 10px;
      padding-bottom: 5px;
      border-bottom: 2px solid #e5e5e5;
      color: #333;
    }

    header {
      margin-bottom: 20px;
      padding-bottom: 15px;
      border-bottom: 3px solid #dc2626;
    }

    .case-number {
      font-size: 14px;
      font-weight: bold;
      color: #dc2626;
      margin: 5px 0;
    }

    .generated {
      font-size: 11px;
      color: #666;
      margin: 0;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin: 10px 0;
    }

    th, td {
      padding: 8px 12px;
      text-align: left;
      border: 1px solid #ddd;
    }

    th {
      background: #f5f5f5;
      font-weight: 600;
      width: 30%;
    }

    td {
      background: #fff;
    }

    ul {
      margin: 0;
      padding-left: 20px;
    }

    li {
      margin: 2px 0;
    }

    ol {
      margin: 10px 0;
      padding-left: 25px;
    }

    ol li {
      margin: 8px 0;
    }

    section {
      margin: 20px 0;
    }

    .action-required {
      background: #fef3c7;
      border: 1px solid #f59e0b;
      border-radius: 4px;
      padding: 15px;
      margin-top: 30px;
    }

    .action-required h2 {
      color: #b45309;
      border-bottom-color: #f59e0b;
      margin-top: 0;
    }

    footer {
      margin-top: 40px;
      padding-top: 20px;
      border-top: 1px solid #ddd;
      text-align: center;
      font-size: 10px;
      color: #666;
    }
  </style>
</head>
<body>
  <%= yield %>
</body>
</html>
