<% content_for :title, "Sign up" %>

<div class="min-h-screen flex items-center justify-center p-6 bg-surface-0 relative overflow-hidden">
  <%# Background layers %>
  <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
    <%= image_tag "bg.jpg", class: "absolute inset-0 w-full h-full object-cover opacity-40" %>
    <div class="absolute inset-0 bg-gradient-to-b from-surface-0/50 via-surface-0/60 to-surface-0"></div>
  </div>

  <div class="relative z-10 w-full max-w-md">
    <%# Header %>
    <div class="text-center mb-8">
      <a href="<%= root_path %>" class="inline-flex items-center gap-2.5 text-surface-900 font-semibold text-base mb-6">
        <%= image_tag "phish-logo.png", alt: "phish.directory", class: "w-9 h-9 rounded-lg shadow-[0_0_15px_rgba(34,211,238,0.25)]" %>
        <span>phish.directory</span>
      </a>
      <h1 class="text-2xl font-semibold text-surface-900 mb-1">Create your account</h1>
      <p class="text-surface-500 text-sm">Start protecting your users from phishing</p>
    </div>

    <%# Card %>
    <div class="bg-surface-100 rounded-lg p-6">
      <%# Benefits box %>
      <div class="bg-accent/5 rounded-md p-4 mb-5">
        <div class="text-xs font-medium text-accent mb-3">What you get</div>
        <ul class="text-xs text-surface-600 space-y-2">
          <li class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Free API access with generous rate limits
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Real-time domain and URL verification
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Multi-source threat intelligence
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Developer dashboard with analytics
          </li>
        </ul>
      </div>

      <%# Error messages %>
      <% if @user.errors.any? %>
        <div class="bg-danger/10 text-danger rounded-md p-3 mb-4 text-sm">
          <ul class="list-disc pl-4 space-y-1">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%# Form %>
      <%= form_with model: @user, url: signup_path, method: :post do |f| %>
        <div class="grid grid-cols-2 gap-3 mb-4">
          <div>
            <label for="user_first_name" class="block text-xs font-medium text-surface-600 mb-1.5">First Name</label>
            <%= f.text_field :first_name,
              class: "w-full px-3 py-2.5 bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 placeholder-surface-500 text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-colors",
              placeholder: "Jane",
              required: true,
              autofocus: true %>
          </div>
          <div>
            <label for="user_last_name" class="block text-xs font-medium text-surface-600 mb-1.5">Last Name</label>
            <%= f.text_field :last_name,
              class: "w-full px-3 py-2.5 bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 placeholder-surface-500 text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-colors",
              placeholder: "Doe",
              required: true %>
          </div>
        </div>

        <div class="mb-4">
          <label for="user_email" class="block text-xs font-medium text-surface-600 mb-1.5">Email address</label>
          <%= f.email_field :email,
            class: "w-full px-3 py-2.5 bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 placeholder-surface-500 text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-colors",
            placeholder: "you@example.com",
            required: true %>
        </div>

        <%= f.submit "Create account",
          class: "w-full py-2.5 bg-surface-900 text-surface-0 font-medium text-sm rounded-md hover:bg-surface-800 transition-colors cursor-pointer" %>
      <% end %>

      <p class="mt-4 text-xs text-surface-500 text-center">
        By signing up, you agree to our Terms of Service and Privacy Policy.
      </p>
    </div>

    <%# Footer %>
    <p class="text-center mt-5 text-surface-500 text-sm">
      Already have an account?
      <%= link_to "Sign in", login_path, class: "text-surface-700 font-medium hover:text-surface-900 transition-colors" %>
    </p>
  </div>
</div>
