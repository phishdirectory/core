<% content_for :title, "Real-time Phishing Detection API" %>
<% content_for :description, "Protect your users from phishing attacks. Real-time domain and URL verification API trusted by security teams worldwide." %>

<%# Navigation %>
<nav class="fixed top-0 left-0 right-0 px-6 lg:px-12 py-4 flex items-center justify-between z-50 bg-surface-0/80 backdrop-blur-xl">
  <a href="<%= root_path %>" class="flex items-center gap-2.5 text-surface-900 font-semibold text-base tracking-tight">
    <%= image_tag "phish-logo.png", alt: "phish.directory", class: "w-8 h-8 rounded-lg shadow-[0_0_15px_rgba(34,211,238,0.25)]" %>
    <span>phish.directory</span>
  </a>
  <div class="flex items-center gap-1">
    <a href="/docs" class="px-4 py-2 text-surface-600 text-sm font-medium hover:text-surface-800 transition-colors rounded-lg hover:bg-surface-100">Docs</a>
    <% if user_signed_in? %>
      <%= link_to "Dashboard", dashboard_root_path, class: "ml-2 px-4 py-2 bg-surface-900 text-surface-0 text-sm font-medium rounded-lg hover:bg-surface-800 transition-colors" %>
    <% else %>
      <%= link_to "Sign in", login_path, class: "px-4 py-2 text-surface-600 text-sm font-medium hover:text-surface-800 transition-colors rounded-lg hover:bg-surface-100" %>
      <%= link_to "Get Started", signup_path, class: "ml-2 px-4 py-2 bg-surface-900 text-surface-0 text-sm font-medium rounded-lg hover:bg-surface-800 transition-colors" %>
    <% end %>
  </div>
</nav>

<%# Hero Section %>
<section class="min-h-screen flex flex-col justify-center items-center text-center px-6 pt-24 pb-16 relative overflow-hidden">
  <%# Background layers %>
  <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
    <%= image_tag "bg.jpg", class: "absolute inset-0 w-full h-full object-cover opacity-40" %>
    <div class="absolute inset-0 bg-gradient-to-b from-accent/[0.02] via-surface-0/60 to-surface-0"></div>
  </div>

  <div class="relative z-10 max-w-3xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-surface-100 rounded-full text-xs font-medium text-surface-600 mb-8 animate-fade-up">
      <span class="w-1.5 h-1.5 bg-success rounded-full animate-pulse-subtle"></span>
      <span>All systems operational</span>
    </div>

    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-[1.1] tracking-tight text-surface-900 mb-6 animate-fade-up-1">
      Stop phishing attacks<br>
      <span class="text-accent">before they start</span>
    </h1>

    <p class="text-lg text-surface-600 max-w-xl mx-auto mb-10 leading-relaxed animate-fade-up-2">
      Real-time domain and URL verification API. Aggregate intelligence from multiple threat feeds to protect your users.
    </p>

    <div class="flex flex-col sm:flex-row gap-3 justify-center animate-fade-up-3">
      <% if user_signed_in? %>
        <%= link_to "Go to Dashboard", dashboard_root_path, class: "px-6 py-3 bg-surface-900 text-surface-0 font-semibold rounded-lg hover:bg-surface-800 transition-colors" %>
      <% else %>
        <%= link_to "Start for free", signup_path, class: "px-6 py-3 bg-surface-900 text-surface-0 font-semibold rounded-lg hover:bg-surface-800 transition-colors" %>
        <%= link_to "Read the docs", "/docs", class: "px-6 py-3 text-surface-700 font-medium rounded-lg hover:bg-surface-100 transition-colors" %>
      <% end %>
    </div>
  </div>
</section>

<%# API Demo Section %>
<section class="py-20 px-6 max-w-3xl mx-auto">
  <div class="bg-surface-100 rounded-xl overflow-hidden shadow-xl">
    <%# Terminal header %>
    <div class="px-4 py-3 bg-surface-200 flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-surface-400"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-surface-400"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-surface-400"></span>
      <span class="flex-1 text-center font-mono text-xs text-surface-500">api request</span>
    </div>
    <%# Terminal body %>
    <div class="p-6 font-mono text-sm leading-relaxed">
      <div class="text-surface-500 mb-4"># Check if a domain is malicious</div>
      <div class="mb-1">
        <span class="text-accent">$</span>
        <span class="text-surface-800"> curl -X POST https://phish.directory/api/v1/domain/check \</span>
      </div>
      <div class="pl-4 text-surface-600">-H "Authorization: Bearer pdat_xxx" \</div>
      <div class="pl-4 text-surface-600 mb-6">-d '{"domain": "suspicious-site.com"}'</div>

      <div class="text-surface-600">
        <div class="text-surface-500"># Response</div>
        <div class="mt-2">{</div>
        <div class="pl-4">"domain": <span class="text-surface-700">"suspicious-site.com"</span>,</div>
        <div class="pl-4">"verdict": <span class="text-danger">"malicious"</span>,</div>
        <div class="pl-4">"confidence": <span class="text-surface-700">0.94</span>,</div>
        <div class="pl-4">"sources": [<span class="text-surface-700">"google_safe_browsing"</span>, <span class="text-surface-700">"virustotal"</span>]</div>
        <div>}</div>
      </div>
    </div>
  </div>
</section>

<%# Footer %>
<footer class="py-12 px-6 text-center">
  <p class="text-surface-500 text-sm">&copy; <%= Date.current.year %> phish.directory</p>
</footer>
