<% content_for :title, "Emails" %>

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div>
    <h1 class="text-xl font-semibold text-surface-900">Emails</h1>
    <p class="text-sm text-surface-500 mt-0.5"><%= Phish::Email.count %> emails tracked</p>
  </div>
  <div class="flex items-center gap-4">
    <div class="flex items-center gap-2 text-sm">
      <span class="px-2 py-0.5 rounded bg-danger/10 text-danger font-mono text-xs"><%= Phish::Email.phishing.count %></span>
      <span class="text-surface-500">phishing</span>
      <span class="px-2 py-0.5 rounded bg-warning/10 text-warning font-mono text-xs ml-2"><%= Phish::Email.suspicious.count %></span>
      <span class="text-surface-500">suspicious</span>
      <span class="px-2 py-0.5 rounded bg-success/10 text-success font-mono text-xs ml-2"><%= Phish::Email.clean.count %></span>
      <span class="text-surface-500">clean</span>
    </div>
  </div>
</header>

<div class="p-8">
  <% if @emails.any? %>
    <div class="bg-surface-100 rounded-lg overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-surface-200/50">
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Email</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Classification</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Confidence</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Attributes</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Last Checked</th>
              <th class="px-5 py-2.5 text-right text-xs font-medium text-surface-500">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @emails.each do |email| %>
              <tr class="border-b border-surface-200/50 hover:bg-surface-200/30 transition-colors">
                <td class="px-5 py-3">
                  <code class="text-sm text-surface-800 font-mono"><%= email.email %></code>
                  <div class="text-xs text-surface-500 font-mono mt-0.5"><%= email.public_id %></div>
                </td>
                <td class="px-5 py-3">
                  <% if email.verdict %>
                    <% case email.classification %>
                    <% when 'phishing' %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-danger/10 text-danger">Fraudulent</span>
                    <% when 'suspicious' %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-warning/10 text-warning">Suspicious</span>
                    <% when 'clean' %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-success/10 text-success">Clean</span>
                    <% when 'unknown' %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-surface-300 text-surface-600">Unknown</span>
                    <% end %>
                  <% else %>
                    <span class="text-surface-500">&mdash;</span>
                  <% end %>
                </td>
                <td class="px-5 py-3">
                  <% if email.confidence_score %>
                    <div class="flex items-center gap-2">
                      <div class="w-16 h-1.5 bg-surface-200 rounded-full overflow-hidden">
                        <div class="h-full rounded-full <%= email.confidence_score >= 0.8 ? 'bg-success' : email.confidence_score >= 0.5 ? 'bg-warning' : 'bg-danger' %>" style="width: <%= (email.confidence_score * 100).to_i %>%"></div>
                      </div>
                      <span class="text-surface-600 text-sm font-mono"><%= (email.confidence_score * 100).to_i %>%</span>
                    </div>
                  <% else %>
                    <span class="text-surface-500">&mdash;</span>
                  <% end %>
                </td>
                <td class="px-5 py-3">
                  <div class="flex flex-wrap gap-1">
                    <% if email.disposable %>
                      <span class="px-1.5 py-0.5 rounded text-xs bg-warning/10 text-warning">Disposable</span>
                    <% end %>
                    <% if email.free_provider %>
                      <span class="px-1.5 py-0.5 rounded text-xs bg-surface-300 text-surface-600">Free</span>
                    <% end %>
                    <% if email.deliverable == false %>
                      <span class="px-1.5 py-0.5 rounded text-xs bg-danger/10 text-danger">Undeliverable</span>
                    <% end %>
                    <% if email.valid_mx == false %>
                      <span class="px-1.5 py-0.5 rounded text-xs bg-danger/10 text-danger">Invalid MX</span>
                    <% end %>
                    <% if !email.disposable && !email.free_provider && email.deliverable != false && email.valid_mx != false %>
                      <span class="text-surface-500">&mdash;</span>
                    <% end %>
                  </div>
                </td>
                <td class="px-5 py-3 text-surface-600 text-sm">
                  <%= email.last_checked_at ? time_ago_in_words(email.last_checked_at) + " ago" : "Never" %>
                </td>
                <td class="px-5 py-3 text-right">
                  <%= link_to "View", admin_email_path(email), class: "px-2.5 py-1.5 text-xs font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <%# Pagination %>
    <% if @emails.respond_to?(:total_pages) && @emails.total_pages > 1 %>
      <div class="mt-6 flex items-center justify-center gap-2">
        <% if @emails.current_page > 1 %>
          <%= link_to "&larr; Previous".html_safe, admin_emails_path(page: @emails.current_page - 1), class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
        <% end %>
        <span class="px-4 py-2 text-sm text-surface-500">
          Page <%= @emails.current_page %> of <%= @emails.total_pages %>
        </span>
        <% if @emails.current_page < @emails.total_pages %>
          <%= link_to "Next &rarr;".html_safe, admin_emails_path(page: @emails.current_page + 1), class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="bg-surface-100 rounded-lg p-12 text-center">
      <svg class="w-10 h-10 mx-auto text-surface-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      <div class="text-sm font-medium text-surface-600 mb-1">No emails tracked</div>
      <p class="text-xs text-surface-500">Emails will appear here as they are checked via the API</p>
    </div>
  <% end %>
</div>
