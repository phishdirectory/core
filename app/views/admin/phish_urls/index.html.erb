<% content_for :title, "URLs" %>

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div>
    <h1 class="text-xl font-semibold text-surface-900">Phishing URLs</h1>
    <p class="text-sm text-surface-500 mt-0.5"><%= Phish::Url.count %> URLs tracked</p>
  </div>
  <div class="flex items-center gap-4">
    <div class="flex items-center gap-2 text-sm">
      <span class="px-2 py-0.5 rounded bg-danger/10 text-danger font-mono text-xs"><%= Phish::Url.phishing.count %></span>
      <span class="text-surface-500">phishing</span>
      <span class="px-2 py-0.5 rounded bg-warning/10 text-warning font-mono text-xs ml-2"><%= Phish::Url.suspicious.count %></span>
      <span class="text-surface-500">suspicious</span>
      <span class="px-2 py-0.5 rounded bg-success/10 text-success font-mono text-xs ml-2"><%= Phish::Url.clean.count %></span>
      <span class="text-surface-500">clean</span>
    </div>
  </div>
</header>

<div class="p-8">
  <% if @urls.any? %>
    <div class="bg-surface-100 rounded-lg overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-surface-200/50">
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">URL</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Classification</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Confidence</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Last Checked</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Added</th>
              <th class="px-5 py-2.5 text-right text-xs font-medium text-surface-500">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @urls.each do |url| %>
              <tr class="border-b border-surface-200/50 hover:bg-surface-200/30 transition-colors">
                <td class="px-5 py-3 max-w-md">
                  <code class="text-sm text-surface-800 font-mono block truncate" title="<%= url.url %>"><%= url.url.truncate(60) %></code>
                  <div class="text-xs text-surface-500 mt-0.5"><%= url.domain %> &middot; <span class="font-mono"><%= url.public_id %></span></div>
                </td>
                <td class="px-5 py-3">
                  <% if url.verdict %>
                    <% case url.classification %>
                    <% when 'phishing' %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-danger/10 text-danger">Phishing</span>
                    <% when 'suspicious' %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-warning/10 text-warning">Suspicious</span>
                    <% when 'clean' %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-success/10 text-success">Clean</span>
                    <% when 'unknown' %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-surface-300 text-surface-600">Unknown</span>
                    <% end %>
                  <% else %>
                    <span class="text-surface-500">—</span>
                  <% end %>
                </td>
                <td class="px-5 py-3">
                  <% if url.confidence_score %>
                    <div class="flex items-center gap-2">
                      <div class="w-16 h-1.5 bg-surface-200 rounded-full overflow-hidden">
                        <div class="h-full rounded-full <%= url.confidence_score >= 0.8 ? 'bg-success' : url.confidence_score >= 0.5 ? 'bg-warning' : 'bg-danger' %>" style="width: <%= (url.confidence_score * 100).to_i %>%"></div>
                      </div>
                      <span class="text-surface-600 text-sm font-mono"><%= (url.confidence_score * 100).to_i %>%</span>
                    </div>
                  <% else %>
                    <span class="text-surface-500">—</span>
                  <% end %>
                </td>
                <td class="px-5 py-3 text-surface-600 text-sm">
                  <%= url.last_checked_at ? time_ago_in_words(url.last_checked_at) + " ago" : "Never" %>
                </td>
                <td class="px-5 py-3 text-surface-600 text-sm">
                  <%= url.created_at.strftime("%b %d, %Y") %>
                </td>
                <td class="px-5 py-3 text-right">
                  <%= link_to "View", admin_url_path(url), class: "px-2.5 py-1.5 text-xs font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <%# Pagination %>
    <% if @urls.respond_to?(:total_pages) && @urls.total_pages > 1 %>
      <div class="mt-6 flex items-center justify-center gap-2">
        <% if @urls.current_page > 1 %>
          <%= link_to "&larr; Previous".html_safe, admin_urls_path(page: @urls.current_page - 1), class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
        <% end %>
        <span class="px-4 py-2 text-sm text-surface-500">
          Page <%= @urls.current_page %> of <%= @urls.total_pages %>
        </span>
        <% if @urls.current_page < @urls.total_pages %>
          <%= link_to "Next &rarr;".html_safe, admin_urls_path(page: @urls.current_page + 1), class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="bg-surface-100 rounded-lg p-12 text-center">
      <svg class="w-10 h-10 mx-auto text-surface-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
      <div class="text-sm font-medium text-surface-600 mb-1">No URLs tracked</div>
      <p class="text-xs text-surface-500">URLs will appear here as they are checked via the API</p>
    </div>
  <% end %>
</div>
