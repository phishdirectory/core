<% content_for :title, "Case #{@case.case_number}" %>

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div class="flex items-center gap-4">
    <%= link_to admin_report_cases_path, class: "text-surface-500 hover:text-surface-900 transition-colors" do %>
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"/></svg>
    <% end %>
    <div>
      <h1 class="text-xl font-semibold text-surface-900">Case <%= @case.case_number %></h1>
      <p class="text-sm text-surface-500 mt-0.5">
        <%= @case.domain_name %> &middot;
        <%= @case.status.titleize %> &middot;
        <span class="font-mono"><%= @case.public_id %></span>
      </p>
    </div>
  </div>
  <div class="flex items-center gap-3">
    <% if @case.may_escalate? %>
      <%= button_to "Escalate", escalate_admin_report_case_path(@case), method: :post, class: "px-4 py-2 text-sm font-medium text-warning bg-warning/10 rounded-md hover:bg-warning/20 transition-colors cursor-pointer" %>
    <% end %>
    <% if @case.may_resolve? %>
      <%= button_to "Mark Resolved", resolve_admin_report_case_path(@case), method: :post, class: "px-4 py-2 text-sm font-medium text-success bg-success/10 rounded-md hover:bg-success/20 transition-colors cursor-pointer" %>
    <% end %>
  </div>
</header>

<div class="p-8">
  <% if @case.requires_manual_review? %>
    <div class="bg-warning/10 rounded-md p-4 mb-6">
      <h4 class="text-sm font-medium text-warning mb-1">Manual Review Required</h4>
      <p class="text-sm text-surface-600">No abuse contacts could be automatically identified. Please investigate and add appropriate contacts.</p>
    </div>
  <% end %>

  <div class="grid grid-cols-4 gap-6 mb-6">
    <div class="bg-surface-100 rounded-lg p-5">
      <div class="text-xs font-medium text-surface-500 mb-1.5">Status</div>
      <% status_colors = { "pending" => "text-surface-600", "submitting" => "text-info", "awaiting_response" => "text-warning", "partially_resolved" => "text-success", "resolved" => "text-success", "escalated" => "text-danger" } %>
      <div class="text-xl font-semibold <%= status_colors[@case.status] %>"><%= @case.status.titleize %></div>
    </div>
    <div class="bg-surface-100 rounded-lg p-5">
      <div class="text-xs font-medium text-surface-500 mb-1.5">Confidence</div>
      <div class="text-xl font-semibold text-accent"><%= (@case.confidence_at_creation * 100).round(1) %>%</div>
    </div>
    <div class="bg-surface-100 rounded-lg p-5">
      <div class="text-xs font-medium text-surface-500 mb-1.5">Submissions</div>
      <div class="text-xl font-semibold text-surface-800"><%= @case.submissions_count %></div>
    </div>
    <div class="bg-surface-100 rounded-lg p-5">
      <div class="text-xs font-medium text-surface-500 mb-1.5">Created</div>
      <div class="text-lg font-semibold text-surface-700"><%= @case.created_at.strftime("%b %d, %Y") %></div>
      <div class="text-xs text-surface-500 mt-0.5"><%= time_ago_in_words(@case.created_at) %> ago</div>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-6 mb-6">
    <div class="bg-surface-100 rounded-lg overflow-hidden">
      <div class="px-5 py-4 border-b border-surface-200/50">
        <h2 class="text-sm font-semibold text-surface-900">Domain Details</h2>
      </div>
      <div class="p-5 space-y-3">
        <div class="flex justify-between">
          <span class="text-sm text-surface-500">Domain</span>
          <span class="text-sm text-surface-700 font-mono"><%= @case.domain_name %></span>
        </div>
        <% if @case.url_value.present? %>
          <div class="flex justify-between">
            <span class="text-sm text-surface-500">URL</span>
            <span class="text-sm text-surface-700 font-mono truncate max-w-xs"><%= @case.url_value %></span>
          </div>
        <% end %>
        <div class="flex justify-between">
          <span class="text-sm text-surface-500">Type</span>
          <span class="text-sm text-surface-700"><%= @case.reportable_type.demodulize %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-surface-500">Email CC</span>
          <span class="text-sm text-surface-700 font-mono"><%= @case.email_address %></span>
        </div>
      </div>
    </div>

    <div class="bg-surface-100 rounded-lg overflow-hidden">
      <div class="px-5 py-4 border-b border-surface-200/50">
        <h2 class="text-sm font-semibold text-surface-900">WHOIS/RDAP Info</h2>
      </div>
      <div class="p-5">
        <% if @case.domain_info.present? %>
          <div class="space-y-3">
            <% @case.domain_info.each do |key, value| %>
              <% next if value.blank? %>
              <div class="flex justify-between">
                <span class="text-sm text-surface-500"><%= key.to_s.humanize %></span>
                <span class="text-sm text-surface-700 truncate max-w-xs"><%= value.is_a?(Array) ? value.join(", ") : value %></span>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-surface-500 italic">No domain info available</p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="mb-6">
    <div class="bg-surface-100 rounded-lg overflow-hidden">
      <div class="px-5 py-4 border-b border-surface-200/50">
        <h2 class="text-sm font-semibold text-surface-900">Submissions</h2>
      </div>
      <% if @submissions.any? %>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-surface-200/50">
                <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Contact</th>
                <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Method</th>
                <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Status</th>
                <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Attempts</th>
                <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Sent</th>
                <th class="px-5 py-2.5 text-right text-xs font-medium text-surface-500">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @submissions.each do |submission| %>
                <tr class="border-b border-surface-200/50 hover:bg-surface-200/30 transition-colors">
                  <td class="px-5 py-3">
                    <%= link_to submission.abuse_contact.name, admin_report_abuse_contact_path(submission.abuse_contact), class: "text-accent hover:underline" %>
                  </td>
                  <td class="px-5 py-3 text-surface-600 text-sm">
                    <%= submission.abuse_contact.method.titleize %>
                  </td>
                  <td class="px-5 py-3">
                    <% sub_colors = { "pending" => "bg-surface-300 text-surface-600", "queued" => "bg-info/10 text-info", "sent" => "bg-accent/10 text-accent", "acknowledged" => "bg-success/10 text-success", "resolved" => "bg-success/10 text-success", "failed" => "bg-danger/10 text-danger", "skipped" => "bg-surface-300 text-surface-500" } %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= sub_colors[submission.status] %>">
                      <%= submission.status.titleize %>
                    </span>
                    <% if submission.submission_reference.present? %>
                      <div class="text-xs text-surface-500 mt-1 font-mono">Ref: <%= submission.submission_reference %></div>
                    <% end %>
                  </td>
                  <td class="px-5 py-3 text-surface-600 text-sm font-mono">
                    <%= submission.attempts %>/<%= submission.max_attempts %>
                  </td>
                  <td class="px-5 py-3 text-surface-600 text-sm">
                    <%= submission.sent_at ? time_ago_in_words(submission.sent_at) + " ago" : "Not sent" %>
                  </td>
                  <td class="px-5 py-3 text-right">
                    <% if submission.status_failed? %>
                      <%= button_to "Retry", retry_submission_admin_report_case_path(@case, submission_id: submission.public_id), method: :post, class: "px-2.5 py-1.5 text-xs font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors cursor-pointer" %>
                    <% end %>
                  </td>
                </tr>
                <% if submission.last_error.present? %>
                  <tr>
                    <td colspan="6" class="px-5 py-2 border-b border-surface-200/50 bg-danger/5">
                      <div class="text-xs text-danger">Error: <%= submission.last_error %></div>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="p-8 text-center">
          <p class="text-sm text-surface-500">No submissions created yet.</p>
        </div>
      <% end %>
    </div>
  </div>

  <% if @emails.any? %>
    <div class="bg-surface-100 rounded-lg overflow-hidden">
      <div class="px-5 py-4 border-b border-surface-200/50">
        <h2 class="text-sm font-semibold text-surface-900">Email History</h2>
      </div>
      <div class="divide-y divide-surface-200/50">
        <% @emails.each do |email| %>
          <div class="p-4 hover:bg-surface-200/30 transition-colors">
            <div class="flex items-center justify-between mb-2">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= email.direction_inbound? ? 'bg-success/10 text-success' : 'bg-info/10 text-info' %>">
                <%= email.direction.titleize %>
              </span>
              <span class="text-xs text-surface-500"><%= email.received_at&.strftime("%b %d, %Y %H:%M") %></span>
            </div>
            <div class="text-sm text-surface-800 font-medium"><%= email.subject %></div>
            <div class="text-xs text-surface-500 mt-1">From: <%= email.from_address %></div>
            <% if email.body_preview.present? %>
              <div class="text-xs text-surface-600 mt-2 line-clamp-2"><%= email.body_preview %></div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
