<% content_for :title, "Report Cases" %>

<header class="px-10 py-6 border-b border-slate-700/20 flex items-center justify-between bg-pd-secondary sticky top-0 z-40">
  <div>
    <h1 class="text-2xl font-bold text-slate-100">Report Cases</h1>
    <p class="text-sm text-slate-500 mt-1"><%= Report::Case.count %> total cases</p>
  </div>
  <div class="flex items-center gap-3">
    <%= form_with url: admin_report_cases_path, method: :get, class: "flex items-center gap-2" do |f| %>
      <%= f.text_field :q, placeholder: "Search cases...", value: params[:q], class: "px-4 py-2 text-sm bg-pd-elevated border border-slate-700/30 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-accent/50 w-64" %>
      <%= f.select :status, options_for_select([["All Statuses", ""], ["Pending", "pending"], ["Submitting", "submitting"], ["Awaiting Response", "awaiting_response"], ["Resolved", "resolved"], ["Escalated", "escalated"]], params[:status]), {}, class: "px-4 py-2 text-sm bg-pd-elevated border border-slate-700/30 rounded-xl text-slate-100 focus:outline-none" %>
      <%= f.submit "Filter", class: "px-4 py-2 text-sm font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-xl hover:bg-pd-hover hover:border-slate-600/50 transition-all cursor-pointer" %>
    <% end %>
    <% if Report::Case.needs_manual_review.count > 0 %>
      <%= link_to "#{Report::Case.needs_manual_review.count} Need Review", admin_report_cases_path(manual_review: true), class: "px-4 py-2 text-sm font-medium text-amber-400 bg-amber-500/10 border border-amber-500/20 rounded-xl hover:bg-amber-500/20 transition-all" %>
    <% end %>
  </div>
</header>

<div class="p-8 px-10">
  <% if @cases.any? %>
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Case</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Domain</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Confidence</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Status</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Submissions</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Created</th>
              <th class="px-6 py-4 text-right text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @cases.each do |report_case| %>
              <tr class="hover:bg-pd-tertiary transition-colors">
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <div class="font-mono text-sm text-cyan-accent"><%= report_case.case_number %></div>
                  <% if report_case.requires_manual_review? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-amber-500/15 text-amber-400 mt-1">Needs Review</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <div class="font-mono text-slate-300"><%= report_case.domain_name %></div>
                  <div class="text-xs text-slate-500"><%= report_case.reportable_type.demodulize %></div>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20 text-slate-400 text-sm font-mono">
                  <%= (report_case.confidence_at_creation * 100).round(1) %>%
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <% status_colors = { "pending" => "bg-slate-600/30 text-slate-400", "submitting" => "bg-blue-500/15 text-blue-400", "awaiting_response" => "bg-amber-500/15 text-amber-400", "partially_resolved" => "bg-emerald-500/15 text-emerald-400", "resolved" => "bg-emerald-500/15 text-emerald-500", "escalated" => "bg-red-500/15 text-red-400" } %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide <%= status_colors[report_case.status] %>">
                    <%= report_case.status.titleize %>
                  </span>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20 text-slate-400 text-sm">
                  <%= report_case.submissions_count %> total
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20 text-slate-400 text-sm">
                  <%= time_ago_in_words(report_case.created_at) %> ago
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20 text-right">
                  <%= link_to "View", admin_report_case_path(report_case), class: "px-3 py-1.5 text-xs font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-lg hover:bg-pd-hover transition-all" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <% if @cases.respond_to?(:total_pages) && @cases.total_pages > 1 %>
      <div class="mt-6 flex items-center justify-center gap-2">
        <% if @cases.current_page > 1 %>
          <%= link_to "&larr; Previous".html_safe, admin_report_cases_path(page: @cases.current_page - 1, q: params[:q], status: params[:status]), class: "px-4 py-2 text-sm font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-xl hover:bg-pd-hover transition-all" %>
        <% end %>
        <span class="px-4 py-2 text-sm text-slate-500">
          Page <%= @cases.current_page %> of <%= @cases.total_pages %>
        </span>
        <% if @cases.current_page < @cases.total_pages %>
          <%= link_to "Next &rarr;".html_safe, admin_report_cases_path(page: @cases.current_page + 1, q: params[:q], status: params[:status]), class: "px-4 py-2 text-sm font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-xl hover:bg-pd-hover transition-all" %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl p-16 text-center">
      <div class="text-5xl mb-4 opacity-50">&#128269;</div>
      <div class="text-lg font-semibold text-slate-400 mb-2">No cases found</div>
      <p class="text-slate-500">Cases will appear here when phishing is detected and auto-reporting is enabled.</p>
    </div>
  <% end %>
</div>
