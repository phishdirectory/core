<% content_for :title, "Report Cases" %>

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div>
    <h1 class="text-xl font-semibold text-surface-900">Report Cases</h1>
    <p class="text-sm text-surface-500 mt-0.5"><%= Report::Case.count %> total cases</p>
  </div>
  <div class="flex items-center gap-3">
    <%= form_with url: admin_report_cases_path, method: :get, class: "flex items-center gap-2" do |f| %>
      <%= f.text_field :q, placeholder: "Search cases...", value: params[:q], class: "px-3 py-2 text-sm bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 placeholder-surface-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 w-56" %>
      <%= f.select :status, options_for_select([["All Statuses", ""], ["Pending", "pending"], ["Submitting", "submitting"], ["Awaiting Response", "awaiting_response"], ["Resolved", "resolved"], ["Escalated", "escalated"]], params[:status]), {}, class: "px-3 py-2 text-sm bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 focus:outline-none focus:border-accent" %>
      <%= f.submit "Filter", class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors cursor-pointer" %>
    <% end %>
    <% if Report::Case.needs_manual_review.count > 0 %>
      <%= link_to "#{Report::Case.needs_manual_review.count} Need Review", admin_report_cases_path(manual_review: true), class: "px-4 py-2 text-sm font-medium text-warning bg-warning/10 rounded-md hover:bg-warning/20 transition-colors" %>
    <% end %>
  </div>
</header>

<div class="p-8">
  <% if @cases.any? %>
    <div class="bg-surface-100 rounded-lg overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-surface-200/50">
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Case</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Domain</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Confidence</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Status</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Submissions</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Created</th>
              <th class="px-5 py-2.5 text-right text-xs font-medium text-surface-500">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @cases.each do |report_case| %>
              <tr class="border-b border-surface-200/50 hover:bg-surface-200/30 transition-colors">
                <td class="px-5 py-3">
                  <div class="font-mono text-sm text-accent"><%= report_case.case_number %></div>
                  <% if report_case.requires_manual_review? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-warning/10 text-warning mt-1">Needs Review</span>
                  <% end %>
                </td>
                <td class="px-5 py-3">
                  <div class="font-mono text-surface-800"><%= report_case.domain_name %></div>
                  <div class="text-xs text-surface-500"><%= report_case.reportable_type.demodulize %></div>
                </td>
                <td class="px-5 py-3 text-surface-600 text-sm font-mono">
                  <%= (report_case.confidence_at_creation * 100).round(1) %>%
                </td>
                <td class="px-5 py-3">
                  <% status_colors = { "pending" => "bg-surface-300 text-surface-600", "submitting" => "bg-info/10 text-info", "awaiting_response" => "bg-warning/10 text-warning", "partially_resolved" => "bg-success/10 text-success", "resolved" => "bg-success/10 text-success", "escalated" => "bg-danger/10 text-danger" } %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= status_colors[report_case.status] %>">
                    <%= report_case.status.titleize %>
                  </span>
                </td>
                <td class="px-5 py-3 text-surface-600 text-sm">
                  <%= report_case.submissions_count %> total
                </td>
                <td class="px-5 py-3 text-surface-600 text-sm">
                  <%= time_ago_in_words(report_case.created_at) %> ago
                </td>
                <td class="px-5 py-3 text-right">
                  <%= link_to "View", admin_report_case_path(report_case), class: "px-2.5 py-1.5 text-xs font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <% if @cases.respond_to?(:total_pages) && @cases.total_pages > 1 %>
      <div class="mt-6 flex items-center justify-center gap-2">
        <% if @cases.current_page > 1 %>
          <%= link_to "&larr; Previous".html_safe, admin_report_cases_path(page: @cases.current_page - 1, q: params[:q], status: params[:status]), class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
        <% end %>
        <span class="px-4 py-2 text-sm text-surface-500">
          Page <%= @cases.current_page %> of <%= @cases.total_pages %>
        </span>
        <% if @cases.current_page < @cases.total_pages %>
          <%= link_to "Next &rarr;".html_safe, admin_report_cases_path(page: @cases.current_page + 1, q: params[:q], status: params[:status]), class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="bg-surface-100 rounded-lg p-12 text-center">
      <svg class="w-10 h-10 mx-auto text-surface-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      <div class="text-sm font-medium text-surface-600 mb-1">No cases found</div>
      <p class="text-xs text-surface-500">Cases will appear here when phishing is detected and auto-reporting is enabled.</p>
    </div>
  <% end %>
</div>
