<% content_for :title, "Import Abuse Contacts" %>

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div class="flex items-center gap-4">
    <%= link_to admin_report_abuse_contacts_path, class: "text-surface-500 hover:text-surface-900 transition-colors" do %>
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"/></svg>
    <% end %>
    <div>
      <h1 class="text-xl font-semibold text-surface-900">Import Abuse Contacts</h1>
      <p class="text-sm text-surface-500 mt-0.5">Upload a CSV file to import or update contacts</p>
    </div>
  </div>
</header>

<div class="p-8 max-w-2xl">
  <div class="bg-surface-100 rounded-lg overflow-hidden">
    <div class="px-5 py-4 border-b border-surface-200/50">
      <h2 class="text-sm font-semibold text-surface-900">Upload CSV</h2>
    </div>
    <div class="p-5">
      <%= form_with url: import_admin_report_abuse_contacts_path, method: :post, multipart: true, class: "space-y-5" do |f| %>
        <div>
          <label class="block text-xs font-medium text-surface-600 mb-1.5">CSV File</label>
          <%= f.file_field :file, accept: ".csv", class: "block w-full text-sm text-surface-600 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-medium file:bg-surface-900 file:text-surface-0 hover:file:bg-surface-800 cursor-pointer" %>
          <p class="text-xs text-surface-500 mt-1.5">
            Upload a CSV file with columns: Name, Type, Report Method, Report Email, Report Contact Form, Notes
          </p>
        </div>

        <div class="bg-surface-200 rounded-md p-4">
          <h4 class="text-xs font-medium text-surface-700 mb-2">Expected CSV Format</h4>
          <pre class="text-xs text-surface-500 overflow-x-auto font-mono">Name,Type,Report Method,Report Email,Report Contact Form,Notes
Cloudflare,Registrar,Contact Form,,https://abuse.cloudflare.com/,
Google Safe Browsing,Other,Contact Form,,https://safebrowsing.google.com/,</pre>
        </div>

        <div class="bg-warning/10 rounded-md p-4">
          <h4 class="text-xs font-medium text-warning mb-1">Smart Merge</h4>
          <p class="text-xs text-surface-600">
            Existing contacts with the same name will be updated with new non-empty values.
            Blank fields in the CSV will not overwrite existing data.
          </p>
        </div>

        <div class="flex justify-end pt-4 border-t border-surface-200/50">
          <%= f.submit "Import Contacts", class: "px-5 py-2.5 bg-surface-900 text-surface-0 font-medium text-sm rounded-md hover:bg-surface-800 transition-colors cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>

  <% if @import_stats.present? %>
    <div class="mt-6 bg-surface-100 rounded-lg overflow-hidden">
      <div class="px-5 py-4 border-b border-surface-200/50">
        <h2 class="text-sm font-semibold text-surface-900">Import Results</h2>
      </div>
      <div class="p-5">
        <div class="grid grid-cols-3 gap-4 mb-5">
          <div class="bg-surface-200 rounded-md p-4 text-center">
            <div class="text-xl font-semibold text-success"><%= @import_stats[:created] %></div>
            <div class="text-xs text-surface-500 mt-1">Created</div>
          </div>
          <div class="bg-surface-200 rounded-md p-4 text-center">
            <div class="text-xl font-semibold text-info"><%= @import_stats[:updated] %></div>
            <div class="text-xs text-surface-500 mt-1">Updated</div>
          </div>
          <div class="bg-surface-200 rounded-md p-4 text-center">
            <div class="text-xl font-semibold text-surface-600"><%= @import_stats[:skipped] %></div>
            <div class="text-xs text-surface-500 mt-1">Skipped</div>
          </div>
        </div>

        <% if @import_stats[:errors].any? %>
          <div class="bg-danger/10 rounded-md p-4">
            <h4 class="text-xs font-medium text-danger mb-2">Errors (<%= @import_stats[:errors].length %>)</h4>
            <ul class="text-xs text-surface-600 space-y-1 max-h-40 overflow-y-auto">
              <% @import_stats[:errors].each do |error| %>
                <li>Line <%= error[:line] %>: <%= error[:name] %> - <%= error[:error] %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
