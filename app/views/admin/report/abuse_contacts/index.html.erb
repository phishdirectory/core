<% content_for :title, "Abuse Contacts" %>

<header class="px-10 py-6 border-b border-slate-700/20 flex items-center justify-between bg-pd-secondary sticky top-0 z-40">
  <div>
    <h1 class="text-2xl font-bold text-slate-100">Abuse Contacts</h1>
    <p class="text-sm text-slate-500 mt-1"><%= Report::AbuseContact.count %> total contacts</p>
  </div>
  <div class="flex items-center gap-3">
    <%= form_with url: admin_report_abuse_contacts_path, method: :get, class: "flex items-center gap-2" do |f| %>
      <%= f.text_field :q, placeholder: "Search contacts...", value: params[:q], class: "px-4 py-2 text-sm bg-pd-elevated border border-slate-700/30 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-accent/50 w-64" %>
      <%= f.select :type, options_for_select([["All Types", ""], ["Registrar", "registrar"], ["Hosting", "hosting"], ["Security Vendor", "security_vendor"], ["Other", "other"]], params[:type]), {}, class: "px-4 py-2 text-sm bg-pd-elevated border border-slate-700/30 rounded-xl text-slate-100 focus:outline-none" %>
      <%= f.submit "Filter", class: "px-4 py-2 text-sm font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-xl hover:bg-pd-hover hover:border-slate-600/50 transition-all cursor-pointer" %>
    <% end %>
    <%= link_to "Import CSV", import_admin_report_abuse_contacts_path, class: "px-4 py-2 text-sm font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-xl hover:bg-pd-hover transition-all" %>
    <%= link_to "New Contact", new_admin_report_abuse_contact_path, class: "px-4 py-2.5 text-sm font-semibold text-pd-primary bg-cyan-accent rounded-xl hover:shadow-[0_0_20px_rgba(63,196,224,0.4)] transition-all" %>
  </div>
</header>

<div class="p-8 px-10">
  <% if @abuse_contacts.any? %>
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Contact</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Type</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Method</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Priority</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Reports</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Status</th>
              <th class="px-6 py-4 text-right text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @abuse_contacts.each do |contact| %>
              <tr class="hover:bg-pd-tertiary transition-colors">
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <div>
                    <div class="font-semibold text-slate-100"><%= contact.name %></div>
                    <% if contact.organization.present? %>
                      <div class="text-xs text-slate-500"><%= contact.organization %></div>
                    <% end %>
                    <div class="text-xs text-slate-600 font-mono">
                      <% if contact.contact_email? %>
                        <%= contact.email %>
                      <% elsif contact.contact_web_form? %>
                        <%= truncate(contact.web_form_url, length: 40) %>
                      <% end %>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide <%= contact.contact_type_registrar? ? 'bg-blue-500/15 text-blue-400' : contact.contact_type_hosting? ? 'bg-purple-500/15 text-purple-400' : contact.contact_type_security_vendor? ? 'bg-emerald-500/15 text-emerald-400' : 'bg-slate-600/30 text-slate-400' %>">
                    <%= contact.contact_type.titleize %>
                  </span>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20 text-slate-400 text-sm">
                  <%= contact.method.titleize %>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20 text-slate-400 text-sm font-mono">
                  <%= contact.priority %>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20 text-slate-400 text-sm">
                  <%= contact.reports_sent %> sent / <%= contact.reports_acknowledged %> ack
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <% if contact.active? %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-emerald-500/15 text-emerald-500">Active</span>
                  <% else %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-slate-600/30 text-slate-400">Inactive</span>
                  <% end %>
                  <% if contact.trusted_reporter? %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-amber-500/15 text-amber-400 ml-1">Trusted</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <%= link_to "View", admin_report_abuse_contact_path(contact), class: "px-3 py-1.5 text-xs font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-lg hover:bg-pd-hover transition-all" %>
                    <%= link_to "Edit", edit_admin_report_abuse_contact_path(contact), class: "px-3 py-1.5 text-xs font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-lg hover:bg-pd-hover transition-all" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <% if @abuse_contacts.respond_to?(:total_pages) && @abuse_contacts.total_pages > 1 %>
      <div class="mt-6 flex items-center justify-center gap-2">
        <% if @abuse_contacts.current_page > 1 %>
          <%= link_to "&larr; Previous".html_safe, admin_report_abuse_contacts_path(page: @abuse_contacts.current_page - 1, q: params[:q], type: params[:type]), class: "px-4 py-2 text-sm font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-xl hover:bg-pd-hover transition-all" %>
        <% end %>
        <span class="px-4 py-2 text-sm text-slate-500">
          Page <%= @abuse_contacts.current_page %> of <%= @abuse_contacts.total_pages %>
        </span>
        <% if @abuse_contacts.current_page < @abuse_contacts.total_pages %>
          <%= link_to "Next &rarr;".html_safe, admin_report_abuse_contacts_path(page: @abuse_contacts.current_page + 1, q: params[:q], type: params[:type]), class: "px-4 py-2 text-sm font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-xl hover:bg-pd-hover transition-all" %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl p-16 text-center">
      <div class="text-5xl mb-4 opacity-50">&#128233;</div>
      <div class="text-lg font-semibold text-slate-400 mb-2">No abuse contacts found</div>
      <p class="text-slate-500 mb-4">Import contacts from a CSV or add them manually.</p>
      <%= link_to "Import CSV", import_admin_report_abuse_contacts_path, class: "px-4 py-2 text-sm font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-xl hover:bg-pd-hover transition-all" %>
    </div>
  <% end %>
</div>
