<% content_for :title, "Abuse Contacts" %>

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div>
    <h1 class="text-xl font-semibold text-surface-900">Abuse Contacts</h1>
    <p class="text-sm text-surface-500 mt-0.5"><%= Report::AbuseContact.count %> total contacts</p>
  </div>
  <div class="flex items-center gap-3">
    <%= form_with url: admin_report_abuse_contacts_path, method: :get, class: "flex items-center gap-2" do |f| %>
      <%= f.text_field :q, placeholder: "Search contacts...", value: params[:q], class: "px-3 py-2 text-sm bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 placeholder-surface-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 w-56" %>
      <%= f.select :type, options_for_select([["All Types", ""], ["Registrar", "registrar"], ["Hosting", "hosting"], ["Security Vendor", "security_vendor"], ["Other", "other"]], params[:type]), {}, class: "px-3 py-2 text-sm bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 focus:outline-none focus:border-accent" %>
      <%= f.submit "Filter", class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors cursor-pointer" %>
    <% end %>
    <%= link_to "Import CSV", import_admin_report_abuse_contacts_path, class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
    <%= link_to "New Contact", new_admin_report_abuse_contact_path, class: "px-4 py-2.5 text-sm font-medium text-surface-0 bg-surface-900 rounded-md hover:bg-surface-800 transition-colors" %>
  </div>
</header>

<div class="p-8">
  <% if @abuse_contacts.any? %>
    <div class="bg-surface-100 rounded-lg overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-surface-200/50">
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Contact</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Type</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Method</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Priority</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Reports</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Status</th>
              <th class="px-5 py-2.5 text-right text-xs font-medium text-surface-500">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @abuse_contacts.each do |contact| %>
              <tr class="border-b border-surface-200/50 hover:bg-surface-200/30 transition-colors">
                <td class="px-5 py-3">
                  <div>
                    <div class="font-medium text-surface-900"><%= contact.name %></div>
                    <% if contact.organization.present? %>
                      <div class="text-xs text-surface-500"><%= contact.organization %></div>
                    <% end %>
                    <div class="text-xs text-surface-500 font-mono mt-0.5">
                      <% if contact.contact_email? %>
                        <%= contact.email %>
                      <% elsif contact.contact_web_form? %>
                        <%= truncate(contact.web_form_url, length: 40) %>
                      <% end %>
                    </div>
                  </div>
                </td>
                <td class="px-5 py-3">
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= contact.contact_type_registrar? ? 'bg-info/10 text-info' : contact.contact_type_hosting? ? 'bg-accent/10 text-accent' : contact.contact_type_security_vendor? ? 'bg-success/10 text-success' : 'bg-surface-300 text-surface-600' %>">
                    <%= contact.contact_type.titleize %>
                  </span>
                </td>
                <td class="px-5 py-3 text-surface-600 text-sm">
                  <%= contact.method.titleize %>
                </td>
                <td class="px-5 py-3 text-surface-600 text-sm font-mono">
                  <%= contact.priority %>
                </td>
                <td class="px-5 py-3 text-surface-600 text-sm">
                  <%= contact.reports_sent %> sent / <%= contact.reports_acknowledged %> ack
                </td>
                <td class="px-5 py-3">
                  <% if contact.active? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-success/10 text-success">Active</span>
                  <% else %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-surface-300 text-surface-600">Inactive</span>
                  <% end %>
                  <% if contact.trusted_reporter? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-warning/10 text-warning ml-1">Trusted</span>
                  <% end %>
                </td>
                <td class="px-5 py-3 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <%= link_to "View", admin_report_abuse_contact_path(contact), class: "px-2.5 py-1.5 text-xs font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
                    <%= link_to "Edit", edit_admin_report_abuse_contact_path(contact), class: "px-2.5 py-1.5 text-xs font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <% if @abuse_contacts.respond_to?(:total_pages) && @abuse_contacts.total_pages > 1 %>
      <div class="mt-6 flex items-center justify-center gap-2">
        <% if @abuse_contacts.current_page > 1 %>
          <%= link_to "&larr; Previous".html_safe, admin_report_abuse_contacts_path(page: @abuse_contacts.current_page - 1, q: params[:q], type: params[:type]), class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
        <% end %>
        <span class="px-4 py-2 text-sm text-surface-500">
          Page <%= @abuse_contacts.current_page %> of <%= @abuse_contacts.total_pages %>
        </span>
        <% if @abuse_contacts.current_page < @abuse_contacts.total_pages %>
          <%= link_to "Next &rarr;".html_safe, admin_report_abuse_contacts_path(page: @abuse_contacts.current_page + 1, q: params[:q], type: params[:type]), class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="bg-surface-100 rounded-lg p-12 text-center">
      <svg class="w-10 h-10 mx-auto text-surface-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      <div class="text-sm font-medium text-surface-600 mb-1">No abuse contacts found</div>
      <p class="text-xs text-surface-500 mb-4">Import contacts from a CSV or add them manually.</p>
      <%= link_to "Import CSV", import_admin_report_abuse_contacts_path, class: "px-5 py-2.5 bg-surface-900 text-surface-0 font-medium text-sm rounded-md hover:bg-surface-800 transition-colors" %>
    </div>
  <% end %>
</div>
