<% content_for :title, @abuse_contact.name %>

<header class="px-10 py-6 border-b border-slate-700/20 flex items-center justify-between bg-pd-secondary sticky top-0 z-40">
  <div>
    <h1 class="text-2xl font-bold text-slate-100"><%= @abuse_contact.name %></h1>
    <p class="text-sm text-slate-500 mt-1">
      <%= @abuse_contact.contact_type.titleize %> &middot;
      <%= @abuse_contact.method.titleize %> &middot;
      <span class="font-mono"><%= @abuse_contact.public_id %></span>
    </p>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to "Edit", edit_admin_report_abuse_contact_path(@abuse_contact), class: "px-4 py-2 text-sm font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-xl hover:bg-pd-hover transition-all" %>
    <%= link_to "&larr; Back".html_safe, admin_report_abuse_contacts_path, class: "px-4 py-2 text-sm font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-xl hover:bg-pd-hover transition-all" %>
  </div>
</header>

<div class="p-8 px-10">
  <div class="grid grid-cols-3 gap-6 mb-8">
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl p-6">
      <div class="text-3xl font-bold text-cyan-accent"><%= @abuse_contact.reports_sent %></div>
      <div class="text-sm text-slate-500 mt-1">Reports Sent</div>
    </div>
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl p-6">
      <div class="text-3xl font-bold text-emerald-400"><%= @abuse_contact.reports_acknowledged %></div>
      <div class="text-sm text-slate-500 mt-1">Acknowledged</div>
    </div>
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl p-6">
      <div class="text-3xl font-bold text-slate-400">
        <%= @abuse_contact.avg_response_hours ? "#{@abuse_contact.avg_response_hours.round(1)}h" : "N/A" %>
      </div>
      <div class="text-sm text-slate-500 mt-1">Avg Response Time</div>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-6">
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl p-6">
      <h3 class="text-lg font-semibold text-slate-100 mb-4">Contact Details</h3>
      <dl class="space-y-3 text-sm">
        <div class="flex justify-between">
          <dt class="text-slate-500">Status</dt>
          <dd>
            <% if @abuse_contact.active? %>
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/15 text-emerald-500">Active</span>
            <% else %>
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-600/30 text-slate-400">Inactive</span>
            <% end %>
            <% if @abuse_contact.trusted_reporter? %>
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-500/15 text-amber-400 ml-1">Trusted</span>
            <% end %>
          </dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-slate-500">Type</dt>
          <dd class="text-slate-300"><%= @abuse_contact.contact_type.titleize %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-slate-500">Method</dt>
          <dd class="text-slate-300"><%= @abuse_contact.method.titleize %></dd>
        </div>
        <% if @abuse_contact.email.present? %>
          <div class="flex justify-between">
            <dt class="text-slate-500">Email</dt>
            <dd class="text-slate-300 font-mono"><%= @abuse_contact.email %></dd>
          </div>
        <% end %>
        <% if @abuse_contact.web_form_url.present? %>
          <div class="flex justify-between">
            <dt class="text-slate-500">Web Form</dt>
            <dd class="text-slate-300 font-mono text-xs">
              <% if (url = safe_external_url(@abuse_contact.web_form_url)) %>
                <%= link_to truncate(url, length: 40), url, target: "_blank", rel: "noopener noreferrer", class: "text-cyan-accent hover:underline" %>
              <% else %>
                <span class="text-slate-500"><%= truncate(@abuse_contact.web_form_url, length: 40) %> (invalid URL)</span>
              <% end %>
            </dd>
          </div>
        <% end %>
        <div class="flex justify-between">
          <dt class="text-slate-500">Priority</dt>
          <dd class="text-slate-300 font-mono"><%= @abuse_contact.priority %></dd>
        </div>
      </dl>
    </div>

    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl p-6">
      <h3 class="text-lg font-semibold text-slate-100 mb-4">Notes</h3>
      <% if @abuse_contact.notes.present? %>
        <p class="text-sm text-slate-400 whitespace-pre-wrap"><%= @abuse_contact.notes %></p>
      <% else %>
        <p class="text-sm text-slate-500 italic">No notes</p>
      <% end %>
    </div>
  </div>

  <% if @submissions.any? %>
    <div class="mt-8">
      <h3 class="text-lg font-semibold text-slate-100 mb-4">Recent Submissions</h3>
      <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl overflow-hidden">
        <table class="w-full">
          <thead>
            <tr>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Case</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Status</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Sent</th>
            </tr>
          </thead>
          <tbody>
            <% @submissions.each do |submission| %>
              <tr class="hover:bg-pd-tertiary transition-colors">
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <%= link_to submission.case.case_number, admin_report_case_path(submission.case), class: "font-mono text-cyan-accent hover:underline" %>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold <%= submission.status_sent? || submission.status_acknowledged? || submission.status_resolved? ? 'bg-emerald-500/15 text-emerald-500' : submission.status_failed? ? 'bg-red-500/15 text-red-500' : 'bg-slate-600/30 text-slate-400' %>">
                    <%= submission.status.titleize %>
                  </span>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20 text-sm text-slate-400">
                  <%= submission.sent_at ? time_ago_in_words(submission.sent_at) + " ago" : "Not sent" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>
