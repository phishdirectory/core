<% content_for :title, @abuse_contact.name %>

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div class="flex items-center gap-4">
    <%= link_to admin_report_abuse_contacts_path, class: "text-surface-500 hover:text-surface-900 transition-colors" do %>
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"/></svg>
    <% end %>
    <div>
      <h1 class="text-xl font-semibold text-surface-900"><%= @abuse_contact.name %></h1>
      <p class="text-sm text-surface-500 mt-0.5">
        <%= @abuse_contact.contact_type.titleize %> &middot;
        <%= @abuse_contact.method.titleize %> &middot;
        <span class="font-mono"><%= @abuse_contact.public_id %></span>
      </p>
    </div>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to "Edit", edit_admin_report_abuse_contact_path(@abuse_contact), class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
  </div>
</header>

<div class="p-8">
  <div class="grid grid-cols-3 gap-6 mb-6">
    <div class="bg-surface-100 rounded-lg p-5">
      <div class="text-2xl font-semibold text-accent"><%= @abuse_contact.reports_sent %></div>
      <div class="text-sm text-surface-500 mt-1">Reports Sent</div>
    </div>
    <div class="bg-surface-100 rounded-lg p-5">
      <div class="text-2xl font-semibold text-success"><%= @abuse_contact.reports_acknowledged %></div>
      <div class="text-sm text-surface-500 mt-1">Acknowledged</div>
    </div>
    <div class="bg-surface-100 rounded-lg p-5">
      <div class="text-2xl font-semibold text-surface-700">
        <%= @abuse_contact.avg_response_hours ? "#{@abuse_contact.avg_response_hours.round(1)}h" : "N/A" %>
      </div>
      <div class="text-sm text-surface-500 mt-1">Avg Response Time</div>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-6">
    <div class="bg-surface-100 rounded-lg overflow-hidden">
      <div class="px-5 py-4 border-b border-surface-200/50">
        <h2 class="text-sm font-semibold text-surface-900">Contact Details</h2>
      </div>
      <div class="p-5 space-y-4">
        <div class="flex justify-between items-center">
          <span class="text-sm text-surface-500">Status</span>
          <div>
            <% if @abuse_contact.active? %>
              <span class="inline-flex items-center px-2.5 py-1 rounded text-xs font-medium bg-success/10 text-success">Active</span>
            <% else %>
              <span class="inline-flex items-center px-2.5 py-1 rounded text-xs font-medium bg-surface-300 text-surface-600">Inactive</span>
            <% end %>
            <% if @abuse_contact.trusted_reporter? %>
              <span class="inline-flex items-center px-2.5 py-1 rounded text-xs font-medium bg-warning/10 text-warning ml-1">Trusted</span>
            <% end %>
          </div>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-surface-500">Type</span>
          <span class="text-sm text-surface-700"><%= @abuse_contact.contact_type.titleize %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-surface-500">Method</span>
          <span class="text-sm text-surface-700"><%= @abuse_contact.method.titleize %></span>
        </div>
        <% if @abuse_contact.email.present? %>
          <div class="flex justify-between">
            <span class="text-sm text-surface-500">Email</span>
            <span class="text-sm text-surface-700 font-mono"><%= @abuse_contact.email %></span>
          </div>
        <% end %>
        <% if @abuse_contact.web_form_url.present? %>
          <div class="flex justify-between">
            <span class="text-sm text-surface-500">Web Form</span>
            <span class="text-sm font-mono">
              <% if (url = safe_external_url(@abuse_contact.web_form_url)) %>
                <%= link_to truncate(url, length: 40), url, target: "_blank", rel: "noopener noreferrer", class: "text-accent hover:underline" %>
              <% else %>
                <span class="text-surface-500"><%= truncate(@abuse_contact.web_form_url, length: 40) %> (invalid URL)</span>
              <% end %>
            </span>
          </div>
        <% end %>
        <div class="flex justify-between">
          <span class="text-sm text-surface-500">Priority</span>
          <span class="text-sm text-surface-700 font-mono"><%= @abuse_contact.priority %></span>
        </div>
      </div>
    </div>

    <div class="bg-surface-100 rounded-lg overflow-hidden">
      <div class="px-5 py-4 border-b border-surface-200/50">
        <h2 class="text-sm font-semibold text-surface-900">Notes</h2>
      </div>
      <div class="p-5">
        <% if @abuse_contact.notes.present? %>
          <p class="text-sm text-surface-600 whitespace-pre-wrap"><%= @abuse_contact.notes %></p>
        <% else %>
          <p class="text-sm text-surface-500 italic">No notes</p>
        <% end %>
      </div>
    </div>
  </div>

  <% if @submissions.any? %>
    <div class="mt-6">
      <div class="bg-surface-100 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-surface-200/50">
          <h2 class="text-sm font-semibold text-surface-900">Recent Submissions</h2>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-surface-200/50">
                <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Case</th>
                <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Status</th>
                <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Sent</th>
              </tr>
            </thead>
            <tbody>
              <% @submissions.each do |submission| %>
                <tr class="border-b border-surface-200/50 hover:bg-surface-200/30 transition-colors">
                  <td class="px-5 py-3">
                    <%= link_to submission.case.case_number, admin_report_case_path(submission.case), class: "font-mono text-accent hover:underline" %>
                  </td>
                  <td class="px-5 py-3">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= submission.status_sent? || submission.status_acknowledged? || submission.status_resolved? ? 'bg-success/10 text-success' : submission.status_failed? ? 'bg-danger/10 text-danger' : 'bg-surface-300 text-surface-600' %>">
                      <%= submission.status.titleize %>
                    </span>
                  </td>
                  <td class="px-5 py-3 text-sm text-surface-600">
                    <%= submission.sent_at ? time_ago_in_words(submission.sent_at) + " ago" : "Not sent" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>
</div>
