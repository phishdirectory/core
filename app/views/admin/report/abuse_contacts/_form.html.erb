<%= form_with model: [:admin, :report, @abuse_contact], class: "space-y-6" do |f| %>
  <% if @abuse_contact.errors.any? %>
    <div class="bg-red-500/10 border border-red-500/20 rounded-xl p-4">
      <h4 class="text-sm font-semibold text-red-400 mb-2"><%= pluralize(@abuse_contact.errors.count, "error") %> prohibited this contact from being saved:</h4>
      <ul class="text-xs text-red-300 list-disc list-inside">
        <% @abuse_contact.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-2 gap-6">
    <div>
      <%= f.label :name, class: "block text-sm font-semibold text-slate-300 mb-2" %>
      <%= f.text_field :name, class: "w-full px-4 py-2 text-sm bg-pd-elevated border border-slate-700/30 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-accent/50", placeholder: "e.g., Cloudflare" %>
    </div>

    <div>
      <%= f.label :organization, class: "block text-sm font-semibold text-slate-300 mb-2" %>
      <%= f.text_field :organization, class: "w-full px-4 py-2 text-sm bg-pd-elevated border border-slate-700/30 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-accent/50", placeholder: "Parent company (optional)" %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-6">
    <div>
      <%= f.label :contact_type, "Type", class: "block text-sm font-semibold text-slate-300 mb-2" %>
      <%= f.select :contact_type, options_for_select([["Registrar", "registrar"], ["Hosting Provider", "hosting"], ["Security Vendor", "security_vendor"], ["Other", "other"]], @abuse_contact.contact_type), {}, class: "w-full px-4 py-2 text-sm bg-pd-elevated border border-slate-700/30 rounded-xl text-slate-100 focus:outline-none focus:border-cyan-accent/50" %>
    </div>

    <div>
      <%= f.label :method, "Contact Method", class: "block text-sm font-semibold text-slate-300 mb-2" %>
      <%= f.select :method, options_for_select([["Email", "email"], ["Web Form", "web_form"], ["API", "api"]], @abuse_contact.method), {}, class: "w-full px-4 py-2 text-sm bg-pd-elevated border border-slate-700/30 rounded-xl text-slate-100 focus:outline-none focus:border-cyan-accent/50" %>
    </div>
  </div>

  <div>
    <%= f.label :email, class: "block text-sm font-semibold text-slate-300 mb-2" %>
    <%= f.email_field :email, class: "w-full px-4 py-2 text-sm bg-pd-elevated border border-slate-700/30 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-accent/50", placeholder: "abuse@example.com" %>
    <p class="text-xs text-slate-500 mt-1">Required if contact method is Email</p>
  </div>

  <div>
    <%= f.label :web_form_url, "Web Form URL", class: "block text-sm font-semibold text-slate-300 mb-2" %>
    <%= f.url_field :web_form_url, class: "w-full px-4 py-2 text-sm bg-pd-elevated border border-slate-700/30 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-accent/50", placeholder: "https://example.com/abuse" %>
    <p class="text-xs text-slate-500 mt-1">Required if contact method is Web Form</p>
  </div>

  <div class="grid grid-cols-3 gap-6">
    <div>
      <%= f.label :priority, class: "block text-sm font-semibold text-slate-300 mb-2" %>
      <%= f.number_field :priority, class: "w-full px-4 py-2 text-sm bg-pd-elevated border border-slate-700/30 rounded-xl text-slate-100 focus:outline-none focus:border-cyan-accent/50", min: 1, max: 100 %>
      <p class="text-xs text-slate-500 mt-1">Lower = higher priority (10=registrar, 30=hosting, 50=other)</p>
    </div>

    <div class="flex items-center pt-8">
      <%= f.check_box :trusted_reporter, class: "w-4 h-4 rounded border-slate-700/30 bg-pd-elevated text-cyan-accent focus:ring-cyan-accent focus:ring-offset-0" %>
      <%= f.label :trusted_reporter, "Trusted Reporter", class: "ml-2 text-sm text-slate-300" %>
    </div>

    <div class="flex items-center pt-8">
      <%= f.check_box :active, class: "w-4 h-4 rounded border-slate-700/30 bg-pd-elevated text-cyan-accent focus:ring-cyan-accent focus:ring-offset-0" %>
      <%= f.label :active, "Active", class: "ml-2 text-sm text-slate-300" %>
    </div>
  </div>

  <div>
    <%= f.label :notes, class: "block text-sm font-semibold text-slate-300 mb-2" %>
    <%= f.text_area :notes, rows: 3, class: "w-full px-4 py-2 text-sm bg-pd-elevated border border-slate-700/30 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-accent/50", placeholder: "Additional notes..." %>
  </div>

  <div class="flex justify-end gap-3">
    <%= link_to "Cancel", admin_report_abuse_contacts_path, class: "px-4 py-2 text-sm font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-xl hover:bg-pd-hover transition-all" %>
    <%= f.submit @abuse_contact.new_record? ? "Create Contact" : "Update Contact", class: "px-6 py-2.5 text-sm font-semibold text-pd-primary bg-cyan-accent rounded-xl hover:shadow-[0_0_20px_rgba(63,196,224,0.4)] transition-all cursor-pointer" %>
  </div>
<% end %>
