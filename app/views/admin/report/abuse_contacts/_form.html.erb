<%= form_with model: @abuse_contact, url: @abuse_contact.new_record? ? admin_report_abuse_contacts_path : admin_report_abuse_contact_path(@abuse_contact), class: "space-y-5" do |f| %>
  <% if @abuse_contact.errors.any? %>
    <div class="bg-danger/10 text-danger rounded-md p-3 text-sm">
      <div class="font-medium mb-2"><%= pluralize(@abuse_contact.errors.count, "error") %> prohibited this contact from being saved:</div>
      <ul class="list-disc pl-4 space-y-1">
        <% @abuse_contact.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-2 gap-5">
    <div>
      <%= f.label :name, class: "block text-xs font-medium text-surface-600 mb-1.5" %>
      <%= f.text_field :name, class: "w-full px-3 py-2.5 bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 placeholder-surface-500 text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-colors", placeholder: "e.g., Cloudflare" %>
    </div>

    <div>
      <%= f.label :organization, class: "block text-xs font-medium text-surface-600 mb-1.5" %>
      <%= f.text_field :organization, class: "w-full px-3 py-2.5 bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 placeholder-surface-500 text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-colors", placeholder: "Parent company (optional)" %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-5">
    <div>
      <%= f.label :contact_type, "Type", class: "block text-xs font-medium text-surface-600 mb-1.5" %>
      <%= f.select :contact_type, options_for_select([["Registrar", "registrar"], ["Hosting Provider", "hosting"], ["Security Vendor", "security_vendor"], ["Other", "other"]], @abuse_contact.contact_type), {}, class: "w-full px-3 py-2.5 bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 text-sm focus:outline-none focus:border-accent" %>
    </div>

    <div>
      <%= f.label :method, "Contact Method", class: "block text-xs font-medium text-surface-600 mb-1.5" %>
      <%= f.select :method, options_for_select([["Email", "email"], ["Web Form", "web_form"], ["API", "api"]], @abuse_contact.method), {}, class: "w-full px-3 py-2.5 bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 text-sm focus:outline-none focus:border-accent" %>
    </div>
  </div>

  <div>
    <%= f.label :email, class: "block text-xs font-medium text-surface-600 mb-1.5" %>
    <%= f.email_field :email, class: "w-full px-3 py-2.5 bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 placeholder-surface-500 text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-colors", placeholder: "abuse@example.com" %>
    <p class="text-xs text-surface-500 mt-1.5">Required if contact method is Email</p>
  </div>

  <div>
    <%= f.label :web_form_url, "Web Form URL", class: "block text-xs font-medium text-surface-600 mb-1.5" %>
    <%= f.url_field :web_form_url, class: "w-full px-3 py-2.5 bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 placeholder-surface-500 text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-colors font-mono", placeholder: "https://example.com/abuse" %>
    <p class="text-xs text-surface-500 mt-1.5">Required if contact method is Web Form</p>
  </div>

  <div class="grid grid-cols-3 gap-5">
    <div>
      <%= f.label :priority, class: "block text-xs font-medium text-surface-600 mb-1.5" %>
      <%= f.number_field :priority, class: "w-full px-3 py-2.5 bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-colors font-mono", min: 1, max: 100 %>
      <p class="text-xs text-surface-500 mt-1.5">Lower = higher priority</p>
    </div>

    <div class="flex items-center pt-6">
      <%= f.check_box :trusted_reporter, class: "w-4 h-4 rounded border-surface-300 bg-surface-200 text-accent focus:ring-accent focus:ring-offset-0" %>
      <%= f.label :trusted_reporter, "Trusted Reporter", class: "ml-2 text-sm text-surface-700" %>
    </div>

    <div class="flex items-center pt-6">
      <%= f.check_box :active, class: "w-4 h-4 rounded border-surface-300 bg-surface-200 text-accent focus:ring-accent focus:ring-offset-0" %>
      <%= f.label :active, "Active", class: "ml-2 text-sm text-surface-700" %>
    </div>
  </div>

  <div>
    <%= f.label :notes, class: "block text-xs font-medium text-surface-600 mb-1.5" %>
    <%= f.text_area :notes, rows: 3, class: "w-full px-3 py-2.5 bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 placeholder-surface-500 text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-colors resize-none", placeholder: "Additional notes..." %>
  </div>

  <div class="flex items-center justify-end gap-3 pt-4 border-t border-surface-200/50">
    <%= link_to "Cancel", admin_report_abuse_contacts_path, class: "px-5 py-2.5 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
    <%= f.submit @abuse_contact.new_record? ? "Create Contact" : "Update Contact", class: "px-5 py-2.5 bg-surface-900 text-surface-0 font-medium text-sm rounded-md hover:bg-surface-800 transition-colors cursor-pointer" %>
  </div>
<% end %>
