<% content_for :title, @service.name %>

<header class="px-10 py-6 border-b border-slate-700/20 flex items-center justify-between bg-pd-secondary sticky top-0 z-40">
  <div class="flex items-center gap-4">
    <%= link_to admin_services_path, class: "text-slate-400 hover:text-slate-100 transition-colors" do %>
      <span class="text-lg">&larr;</span>
    <% end %>
    <div>
      <h1 class="text-2xl font-bold text-slate-100"><%= @service.name %></h1>
      <p class="text-sm text-slate-500 mt-1 font-mono"><%= @service.id %></p>
    </div>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to "Edit", edit_admin_service_path(@service), class: "px-4 py-2 text-sm font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-xl hover:bg-pd-hover hover:border-slate-600/50 transition-all" %>
  </div>
</header>

<div class="p-8 px-10">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <%# Left column - Keys and Webhooks %>
    <div class="lg:col-span-2 space-y-6">
      <%# API Keys %>
      <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl overflow-hidden">
        <div class="px-6 py-5 border-b border-slate-700/20 flex items-center justify-between">
          <div>
            <h2 class="text-lg font-semibold text-slate-100">API Keys</h2>
            <p class="text-sm text-slate-500 mt-1"><%= @keys.count %> keys</p>
          </div>
          <%= form_with url: admin_service_keys_path(@service), method: :post, class: "flex items-center gap-2" do %>
            <%= text_field_tag :notes, nil, placeholder: "Key notes (optional)", class: "px-3 py-2 text-sm bg-pd-elevated border border-slate-700/30 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-accent/50 w-48" %>
            <%= submit_tag "Generate Key", class: "px-4 py-2 text-sm font-medium text-pd-primary bg-cyan-accent rounded-xl hover:shadow-[0_0_20px_rgba(63,196,224,0.4)] transition-all cursor-pointer" %>
          <% end %>
        </div>
        <% if @keys.any? %>
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">API Key</th>
                  <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Notes</th>
                  <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Status</th>
                  <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Created</th>
                  <th class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @keys.each do |key| %>
                  <tr class="hover:bg-pd-tertiary transition-colors">
                    <td class="px-6 py-4 border-b border-slate-700/20">
                      <code class="text-sm text-slate-100 font-mono bg-pd-elevated px-2 py-1 rounded"><%= key.api_key.truncate(20) %></code>
                    </td>
                    <td class="px-6 py-4 border-b border-slate-700/20 text-slate-400 text-sm">
                      <%= key.notes.presence || "—" %>
                    </td>
                    <td class="px-6 py-4 border-b border-slate-700/20">
                      <% case key.status %>
                      <% when 'active' %>
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-emerald-500/15 text-emerald-500">Active</span>
                      <% when 'deprecated' %>
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-amber-500/15 text-amber-500">Deprecated</span>
                      <% when 'revoked' %>
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-red-500/15 text-red-500">Revoked</span>
                      <% end %>
                    </td>
                    <td class="px-6 py-4 border-b border-slate-700/20 text-slate-400 text-sm">
                      <%= key.created_at.strftime("%b %d, %Y") %>
                    </td>
                    <td class="px-6 py-4 border-b border-slate-700/20 text-right">
                      <div class="flex items-center justify-end gap-2">
                        <% if key.may_deprecate? %>
                          <%= button_to "Deprecate", deprecate_admin_service_key_path(@service, key), method: :post, class: "px-3 py-1.5 text-xs font-medium text-amber-500 bg-amber-500/10 border border-amber-500/30 rounded-lg hover:bg-amber-500/20 transition-all cursor-pointer" %>
                        <% end %>
                        <% if key.may_revoke? %>
                          <%= button_to "Revoke", revoke_admin_service_key_path(@service, key), method: :post, class: "px-3 py-1.5 text-xs font-medium text-red-500 bg-red-500/10 border border-red-500/30 rounded-lg hover:bg-red-500/20 transition-all cursor-pointer", data: { turbo_confirm: "Are you sure? This will permanently disable this key." } %>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-10 text-slate-500">
            <div class="text-lg font-semibold text-slate-400 mb-1">No API keys</div>
            <p class="text-sm">Generate a key to enable API access for this service</p>
          </div>
        <% end %>
      </div>

      <%# Webhooks %>
      <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl overflow-hidden">
        <div class="px-6 py-5 border-b border-slate-700/20 flex items-center justify-between">
          <div>
            <h2 class="text-lg font-semibold text-slate-100">Webhooks</h2>
            <p class="text-sm text-slate-500 mt-1"><%= @webhooks.count %> registered</p>
          </div>
          <%= form_with url: admin_service_webhooks_path(@service), method: :post, class: "flex items-center gap-2" do %>
            <%= text_field_tag :url, nil, placeholder: "https://example.com/webhook", class: "px-3 py-2 text-sm bg-pd-elevated border border-slate-700/30 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-accent/50 w-64" %>
            <%= submit_tag "Add Webhook", class: "px-4 py-2 text-sm font-medium text-pd-primary bg-cyan-accent rounded-xl hover:shadow-[0_0_20px_rgba(63,196,224,0.4)] transition-all cursor-pointer" %>
          <% end %>
        </div>
        <% if @webhooks.any? %>
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">URL</th>
                  <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Secret</th>
                  <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Created</th>
                  <th class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @webhooks.each do |webhook| %>
                  <tr class="hover:bg-pd-tertiary transition-colors">
                    <td class="px-6 py-4 border-b border-slate-700/20">
                      <code class="text-sm text-slate-100 font-mono"><%= webhook.url.truncate(50) %></code>
                    </td>
                    <td class="px-6 py-4 border-b border-slate-700/20">
                      <code class="text-sm text-slate-400 font-mono bg-pd-elevated px-2 py-1 rounded"><%= webhook.secret.truncate(16) %>...</code>
                    </td>
                    <td class="px-6 py-4 border-b border-slate-700/20 text-slate-400 text-sm">
                      <%= webhook.created_at.strftime("%b %d, %Y") %>
                    </td>
                    <td class="px-6 py-4 border-b border-slate-700/20 text-right">
                      <%= button_to "Delete", admin_service_webhook_path(@service, webhook), method: :delete, class: "px-3 py-1.5 text-xs font-medium text-red-500 bg-red-500/10 border border-red-500/30 rounded-lg hover:bg-red-500/20 transition-all cursor-pointer", data: { turbo_confirm: "Are you sure you want to delete this webhook?" } %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-10 text-slate-500">
            <div class="text-lg font-semibold text-slate-400 mb-1">No webhooks</div>
            <p class="text-sm">Add a webhook URL to receive event notifications</p>
          </div>
        <% end %>
      </div>
    </div>

    <%# Right column - Status and actions %>
    <div class="space-y-6">
      <%# Status card %>
      <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl overflow-hidden">
        <div class="px-6 py-5 border-b border-slate-700/20">
          <h2 class="text-lg font-semibold text-slate-100">Status</h2>
        </div>
        <div class="p-6 space-y-4">
          <div>
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-2">Service Status</div>
            <% case @service.status %>
            <% when 'active' %>
              <span class="inline-flex items-center px-3 py-1.5 rounded-full text-sm font-semibold font-mono uppercase tracking-wide bg-emerald-500/15 text-emerald-500">Active</span>
            <% when 'suspended' %>
              <span class="inline-flex items-center px-3 py-1.5 rounded-full text-sm font-semibold font-mono uppercase tracking-wide bg-amber-500/15 text-amber-500">Suspended</span>
            <% when 'decommissioned' %>
              <span class="inline-flex items-center px-3 py-1.5 rounded-full text-sm font-semibold font-mono uppercase tracking-wide bg-slate-600/30 text-slate-400">Decommissioned</span>
            <% end %>
          </div>
          <div>
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-1">Active Keys</div>
            <div class="text-slate-100 font-mono text-lg"><%= @service.active_keys.count %></div>
          </div>
          <div>
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-1">Webhooks</div>
            <div class="text-slate-100 font-mono text-lg"><%= @service.service_webhooks.count %></div>
          </div>
        </div>
      </div>

      <%# Activity card %>
      <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl overflow-hidden">
        <div class="px-6 py-5 border-b border-slate-700/20">
          <h2 class="text-lg font-semibold text-slate-100">Details</h2>
        </div>
        <div class="p-6 space-y-4">
          <div>
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-1">Service ID</div>
            <div class="text-slate-100 font-mono text-sm break-all"><%= @service.id %></div>
          </div>
          <div>
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-1">Created</div>
            <div class="text-slate-100"><%= @service.created_at.strftime("%B %d, %Y at %I:%M %p") %></div>
          </div>
          <div>
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-1">Last Updated</div>
            <div class="text-slate-100"><%= @service.updated_at.strftime("%B %d, %Y at %I:%M %p") %></div>
          </div>
        </div>
      </div>

      <%# Actions card %>
      <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl overflow-hidden">
        <div class="px-6 py-5 border-b border-slate-700/20">
          <h2 class="text-lg font-semibold text-slate-100">Actions</h2>
        </div>
        <div class="p-6 space-y-3">
          <% if @service.may_suspend? %>
            <%= button_to "Suspend Service", "#", method: :post, class: "w-full px-4 py-2.5 text-sm font-medium text-amber-500 bg-amber-500/10 border border-amber-500/30 rounded-xl hover:bg-amber-500/20 transition-all cursor-pointer text-left", disabled: true, title: "State transition endpoint not yet implemented" %>
          <% end %>

          <% if @service.may_reactivate? %>
            <%= button_to "Reactivate Service", "#", method: :post, class: "w-full px-4 py-2.5 text-sm font-medium text-emerald-500 bg-emerald-500/10 border border-emerald-500/30 rounded-xl hover:bg-emerald-500/20 transition-all cursor-pointer text-left", disabled: true, title: "State transition endpoint not yet implemented" %>
          <% end %>

          <% if @service.may_decommission? %>
            <%= button_to "Decommission Service", "#", method: :post, class: "w-full px-4 py-2.5 text-sm font-medium text-red-500 bg-red-500/10 border border-red-500/30 rounded-xl hover:bg-red-500/20 transition-all cursor-pointer text-left", disabled: true, title: "State transition endpoint not yet implemented" %>
          <% end %>

          <div class="border-t border-slate-700/20 pt-3 mt-3">
            <div class="text-xs font-semibold text-red-500/70 uppercase tracking-widest mb-3">Danger Zone</div>
            <%= button_to "Delete Service", admin_service_path(@service), method: :delete, class: "w-full px-4 py-2.5 text-sm font-medium text-red-500 bg-red-500/10 border border-red-500/30 rounded-xl hover:bg-red-500/20 transition-all cursor-pointer text-left", data: { turbo_confirm: "Are you sure you want to permanently delete this service? All API keys and webhooks will also be deleted." } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
