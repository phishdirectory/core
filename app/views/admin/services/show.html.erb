<% content_for :title, @service.name %>

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div class="flex items-center gap-4">
    <%= link_to admin_services_path, class: "text-surface-500 hover:text-surface-900 transition-colors" do %>
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"/></svg>
    <% end %>
    <div>
      <h1 class="text-xl font-semibold text-surface-900"><%= @service.name %></h1>
      <p class="text-sm text-surface-500 mt-0.5 font-mono"><%= @service.id %></p>
    </div>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to "Edit", edit_admin_service_path(@service), class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
  </div>
</header>

<div class="p-8">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <%# Left column - Keys and Webhooks %>
    <div class="lg:col-span-2 space-y-6">
      <%# API Keys %>
      <div class="bg-surface-100 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-surface-200/50 flex items-center justify-between">
          <div>
            <h2 class="text-sm font-semibold text-surface-900">API Keys</h2>
            <p class="text-xs text-surface-500 mt-0.5"><%= @keys.count %> keys</p>
          </div>
          <%= form_with url: admin_service_keys_path(@service), method: :post, class: "flex items-center gap-2" do %>
            <%= text_field_tag :notes, nil, placeholder: "Key notes (optional)", class: "px-3 py-2 text-sm bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 placeholder-surface-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 w-48 transition-colors" %>
            <%= submit_tag "Generate Key", class: "px-4 py-2 text-sm font-medium text-surface-0 bg-surface-900 rounded-md hover:bg-surface-800 transition-colors cursor-pointer" %>
          <% end %>
        </div>
        <% if @keys.any? %>
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr class="border-b border-surface-200/50">
                  <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">API Key</th>
                  <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Notes</th>
                  <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Status</th>
                  <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Created</th>
                  <th class="px-5 py-2.5 text-right text-xs font-medium text-surface-500">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @keys.each do |key| %>
                  <tr class="border-b border-surface-200/50 hover:bg-surface-200/30 transition-colors">
                    <td class="px-5 py-3">
                      <code class="text-xs text-surface-700 font-mono bg-surface-200 px-2 py-1 rounded"><%= key.api_key.truncate(20) %></code>
                    </td>
                    <td class="px-5 py-3 text-surface-600 text-sm">
                      <%= key.notes.presence || "—" %>
                    </td>
                    <td class="px-5 py-3">
                      <% case key.status %>
                      <% when 'active' %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-success/10 text-success">Active</span>
                      <% when 'deprecated' %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-warning/10 text-warning">Deprecated</span>
                      <% when 'revoked' %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-danger/10 text-danger">Revoked</span>
                      <% end %>
                    </td>
                    <td class="px-5 py-3 text-surface-600 text-sm">
                      <%= key.created_at.strftime("%b %d, %Y") %>
                    </td>
                    <td class="px-5 py-3 text-right">
                      <div class="flex items-center justify-end gap-2">
                        <% if key.may_deprecate? %>
                          <%= button_to "Deprecate", deprecate_admin_service_key_path(@service, key), method: :post, class: "px-2.5 py-1.5 text-xs font-medium text-warning bg-warning/10 rounded-md hover:bg-warning/20 transition-colors cursor-pointer" %>
                        <% end %>
                        <% if key.may_revoke? %>
                          <%= button_to "Revoke", revoke_admin_service_key_path(@service, key), method: :post, class: "px-2.5 py-1.5 text-xs font-medium text-danger bg-danger/10 rounded-md hover:bg-danger/20 transition-colors cursor-pointer", data: { turbo_confirm: "Are you sure? This will permanently disable this key." } %>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-10 border-t border-surface-200/50">
            <div class="text-sm font-medium text-surface-600 mb-1">No API keys</div>
            <p class="text-xs text-surface-500">Generate a key to enable API access for this service</p>
          </div>
        <% end %>
      </div>

      <%# Webhooks %>
      <div class="bg-surface-100 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-surface-200/50 flex items-center justify-between">
          <div>
            <h2 class="text-sm font-semibold text-surface-900">Webhooks</h2>
            <p class="text-xs text-surface-500 mt-0.5"><%= @webhooks.count %> registered</p>
          </div>
          <%= form_with url: admin_service_webhooks_path(@service), method: :post, class: "flex items-center gap-2" do %>
            <%= text_field_tag :url, nil, placeholder: "https://example.com/webhook", class: "px-3 py-2 text-sm bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 placeholder-surface-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 w-64 transition-colors" %>
            <%= submit_tag "Add Webhook", class: "px-4 py-2 text-sm font-medium text-surface-0 bg-surface-900 rounded-md hover:bg-surface-800 transition-colors cursor-pointer" %>
          <% end %>
        </div>
        <% if @webhooks.any? %>
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr class="border-b border-surface-200/50">
                  <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">URL</th>
                  <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Secret</th>
                  <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Created</th>
                  <th class="px-5 py-2.5 text-right text-xs font-medium text-surface-500">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @webhooks.each do |webhook| %>
                  <tr class="border-b border-surface-200/50 hover:bg-surface-200/30 transition-colors">
                    <td class="px-5 py-3">
                      <code class="text-xs text-surface-700 font-mono"><%= webhook.url.truncate(50) %></code>
                    </td>
                    <td class="px-5 py-3">
                      <code class="text-xs text-surface-500 font-mono bg-surface-200 px-2 py-1 rounded"><%= webhook.secret.truncate(16) %>...</code>
                    </td>
                    <td class="px-5 py-3 text-surface-600 text-sm">
                      <%= webhook.created_at.strftime("%b %d, %Y") %>
                    </td>
                    <td class="px-5 py-3 text-right">
                      <%= button_to "Delete", admin_service_webhook_path(@service, webhook), method: :delete, class: "px-2.5 py-1.5 text-xs font-medium text-danger bg-danger/10 rounded-md hover:bg-danger/20 transition-colors cursor-pointer", data: { turbo_confirm: "Are you sure you want to delete this webhook?" } %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-10 border-t border-surface-200/50">
            <div class="text-sm font-medium text-surface-600 mb-1">No webhooks</div>
            <p class="text-xs text-surface-500">Add a webhook URL to receive event notifications</p>
          </div>
        <% end %>
      </div>
    </div>

    <%# Right column - Status and actions %>
    <div class="space-y-6">
      <%# Status card %>
      <div class="bg-surface-100 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-surface-200/50">
          <h2 class="text-sm font-semibold text-surface-900">Status</h2>
        </div>
        <div class="p-5 space-y-4">
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1.5">Service Status</div>
            <% case @service.status %>
            <% when 'active' %>
              <span class="inline-flex items-center px-2.5 py-1 rounded text-xs font-medium bg-success/10 text-success">Active</span>
            <% when 'suspended' %>
              <span class="inline-flex items-center px-2.5 py-1 rounded text-xs font-medium bg-warning/10 text-warning">Suspended</span>
            <% when 'decommissioned' %>
              <span class="inline-flex items-center px-2.5 py-1 rounded text-xs font-medium bg-surface-300 text-surface-600">Decommissioned</span>
            <% end %>
          </div>
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Active Keys</div>
            <div class="text-sm text-surface-800 font-mono"><%= @service.active_keys.count %></div>
          </div>
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Webhooks</div>
            <div class="text-sm text-surface-800 font-mono"><%= @service.service_webhooks.count %></div>
          </div>
        </div>
      </div>

      <%# Activity card %>
      <div class="bg-surface-100 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-surface-200/50">
          <h2 class="text-sm font-semibold text-surface-900">Details</h2>
        </div>
        <div class="p-5 space-y-4">
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Service ID</div>
            <div class="text-sm text-surface-700 font-mono break-all"><%= @service.id %></div>
          </div>
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Created</div>
            <div class="text-sm text-surface-700"><%= @service.created_at.strftime("%B %d, %Y at %I:%M %p") %></div>
          </div>
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Last Updated</div>
            <div class="text-sm text-surface-700"><%= @service.updated_at.strftime("%B %d, %Y at %I:%M %p") %></div>
          </div>
        </div>
      </div>

      <%# Actions card %>
      <div class="bg-surface-100 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-surface-200/50">
          <h2 class="text-sm font-semibold text-surface-900">Actions</h2>
        </div>
        <div class="p-5 space-y-3">
          <% if @service.may_suspend? %>
            <%= button_to "Suspend Service", "#", method: :post, class: "w-full px-4 py-2.5 text-sm font-medium text-warning bg-warning/10 rounded-md hover:bg-warning/20 transition-colors cursor-pointer text-left", disabled: true, title: "State transition endpoint not yet implemented" %>
          <% end %>

          <% if @service.may_reactivate? %>
            <%= button_to "Reactivate Service", "#", method: :post, class: "w-full px-4 py-2.5 text-sm font-medium text-success bg-success/10 rounded-md hover:bg-success/20 transition-colors cursor-pointer text-left", disabled: true, title: "State transition endpoint not yet implemented" %>
          <% end %>

          <% if @service.may_decommission? %>
            <%= button_to "Decommission Service", "#", method: :post, class: "w-full px-4 py-2.5 text-sm font-medium text-danger bg-danger/10 rounded-md hover:bg-danger/20 transition-colors cursor-pointer text-left", disabled: true, title: "State transition endpoint not yet implemented" %>
          <% end %>

          <div class="border-t border-surface-200/50 pt-3 mt-3">
            <div class="text-xs font-medium text-danger/70 mb-3">Danger Zone</div>
            <%= button_to "Delete Service", admin_service_path(@service), method: :delete, class: "w-full px-4 py-2.5 text-sm font-medium text-danger bg-danger/10 rounded-md hover:bg-danger/20 transition-colors cursor-pointer text-left", data: { turbo_confirm: "Are you sure you want to permanently delete this service? All API keys and webhooks will also be deleted." } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
