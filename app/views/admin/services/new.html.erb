<% content_for :title, "New Service" %>

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div class="flex items-center gap-4">
    <%= link_to admin_services_path, class: "text-surface-500 hover:text-surface-900 transition-colors" do %>
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"/></svg>
    <% end %>
    <div>
      <h1 class="text-xl font-semibold text-surface-900">New Service</h1>
      <p class="text-sm text-surface-500 mt-0.5">Register a new external service</p>
    </div>
  </div>
</header>

<div class="p-8 max-w-2xl">
  <div class="bg-surface-100 rounded-lg overflow-hidden">
    <div class="px-5 py-4 border-b border-surface-200/50">
      <h2 class="text-sm font-semibold text-surface-900">Service Details</h2>
    </div>
    <div class="p-5">
      <%= form_with model: [:admin, @service], class: "space-y-5" do |f| %>
        <% if @service.errors.any? %>
          <div class="bg-danger/10 text-danger rounded-md p-3 text-sm">
            <div class="font-medium mb-2"><%= pluralize(@service.errors.count, "error") %> prevented this service from being saved:</div>
            <ul class="list-disc pl-4 space-y-1">
              <% @service.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= f.label :name, class: "block text-xs font-medium text-surface-600 mb-1.5" %>
          <%= f.text_field :name, class: "w-full px-3 py-2.5 bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 placeholder-surface-500 text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-colors", placeholder: "My Service", autofocus: true %>
          <p class="text-xs text-surface-500 mt-1.5">A unique name to identify this service</p>
        </div>

        <div class="flex items-center justify-end gap-3 pt-4">
          <%= link_to "Cancel", admin_services_path, class: "px-5 py-2.5 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
          <%= f.submit "Create Service", class: "px-5 py-2.5 bg-surface-900 text-surface-0 font-medium text-sm rounded-md hover:bg-surface-800 transition-colors cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="mt-6 bg-surface-100 rounded-lg p-5">
    <h3 class="text-sm font-semibold text-surface-700 mb-3">What happens next?</h3>
    <ul class="space-y-2 text-sm text-surface-600">
      <li class="flex items-start gap-2">
        <span class="text-accent font-medium">1.</span>
        <span>After creating the service, you can generate API keys for authentication</span>
      </li>
      <li class="flex items-start gap-2">
        <span class="text-accent font-medium">2.</span>
        <span>Register webhook URLs to receive event notifications</span>
      </li>
      <li class="flex items-start gap-2">
        <span class="text-accent font-medium">3.</span>
        <span>Use the API key in the <code class="bg-surface-200 px-1.5 py-0.5 rounded text-surface-700 text-xs">Authorization</code> header or <code class="bg-surface-200 px-1.5 py-0.5 rounded text-surface-700 text-xs">X-API-Key</code> header</span>
      </li>
    </ul>
  </div>
</div>
