<% content_for :title, "New Service" %>

<header class="px-10 py-6 border-b border-slate-700/20 flex items-center justify-between bg-pd-secondary sticky top-0 z-40">
  <div class="flex items-center gap-4">
    <%= link_to admin_services_path, class: "text-slate-400 hover:text-slate-100 transition-colors" do %>
      <span class="text-lg">&larr;</span>
    <% end %>
    <div>
      <h1 class="text-2xl font-bold text-slate-100">New Service</h1>
      <p class="text-sm text-slate-500 mt-1">Register a new external service</p>
    </div>
  </div>
</header>

<div class="p-8 px-10 max-w-2xl">
  <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-700/20">
      <h2 class="text-lg font-semibold text-slate-100">Service Details</h2>
    </div>
    <div class="p-6">
      <%= form_with model: [:admin, @service], class: "space-y-6" do |f| %>
        <% if @service.errors.any? %>
          <div class="bg-red-500/15 border border-red-500/30 text-red-400 px-5 py-3.5 rounded-xl text-sm">
            <div class="font-semibold mb-2"><%= pluralize(@service.errors.count, "error") %> prevented this service from being saved:</div>
            <ul class="list-disc list-inside space-y-1">
              <% @service.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= f.label :name, class: "block text-xs font-semibold text-slate-500 uppercase tracking-widest mb-2" %>
          <%= f.text_field :name, class: "w-full px-4 py-3 text-sm bg-pd-elevated border border-slate-700/30 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-accent/50", placeholder: "My Service", autofocus: true %>
          <p class="text-xs text-slate-500 mt-2">A unique name to identify this service</p>
        </div>

        <div class="flex items-center justify-end gap-3 pt-4">
          <%= link_to "Cancel", admin_services_path, class: "px-4 py-2.5 text-sm font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-xl hover:bg-pd-hover hover:border-slate-600/50 transition-all" %>
          <%= f.submit "Create Service", class: "px-5 py-2.5 text-sm font-semibold text-pd-primary bg-cyan-accent rounded-xl hover:shadow-[0_0_20px_rgba(63,196,224,0.4)] transition-all cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="mt-6 bg-pd-secondary border border-slate-700/20 rounded-2xl p-6">
    <h3 class="text-sm font-semibold text-slate-400 mb-3">What happens next?</h3>
    <ul class="space-y-2 text-sm text-slate-500">
      <li class="flex items-start gap-2">
        <span class="text-cyan-accent">1.</span>
        <span>After creating the service, you can generate API keys for authentication</span>
      </li>
      <li class="flex items-start gap-2">
        <span class="text-cyan-accent">2.</span>
        <span>Register webhook URLs to receive event notifications</span>
      </li>
      <li class="flex items-start gap-2">
        <span class="text-cyan-accent">3.</span>
        <span>Use the API key in the <code class="bg-pd-elevated px-1.5 py-0.5 rounded text-slate-400">Authorization</code> header or <code class="bg-pd-elevated px-1.5 py-0.5 rounded text-slate-400">X-API-Key</code> header</span>
      </li>
    </ul>
  </div>
</div>
