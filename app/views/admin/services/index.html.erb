<% content_for :title, "Services" %>

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div>
    <h1 class="text-xl font-semibold text-surface-900">Services</h1>
    <p class="text-sm text-surface-500 mt-0.5"><%= Service.count %> registered services</p>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to "New Service", new_admin_service_path, class: "px-4 py-2.5 text-sm font-medium text-surface-0 bg-surface-900 rounded-md hover:bg-surface-800 transition-colors" %>
  </div>
</header>

<div class="p-8">
  <% if @services.any? %>
    <div class="bg-surface-100 rounded-lg overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-surface-200/50">
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Service</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Status</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">API Keys</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Webhooks</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Created</th>
              <th class="px-5 py-2.5 text-right text-xs font-medium text-surface-500">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @services.each do |service| %>
              <tr class="border-b border-surface-200/50 hover:bg-surface-200/30 transition-colors">
                <td class="px-5 py-3">
                  <div class="font-medium text-sm text-surface-800"><%= service.name %></div>
                  <div class="text-xs text-surface-500 font-mono mt-0.5"><%= service.public_id %></div>
                </td>
                <td class="px-5 py-3">
                  <% case service.status %>
                  <% when 'active' %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-success/10 text-success">Active</span>
                  <% when 'suspended' %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-warning/10 text-warning">Suspended</span>
                  <% when 'decommissioned' %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-surface-300 text-surface-600">Decommissioned</span>
                  <% end %>
                </td>
                <td class="px-5 py-3">
                  <span class="text-sm text-surface-800 font-mono"><%= service.keys_count || service.service_keys.count %></span>
                  <span class="text-xs text-surface-500">keys</span>
                </td>
                <td class="px-5 py-3">
                  <span class="text-sm text-surface-800 font-mono"><%= service.service_webhooks.count %></span>
                  <span class="text-xs text-surface-500">webhooks</span>
                </td>
                <td class="px-5 py-3 text-surface-600 text-sm">
                  <%= service.created_at.strftime("%b %d, %Y") %>
                </td>
                <td class="px-5 py-3 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <%= link_to "View", admin_service_path(service), class: "px-2.5 py-1.5 text-xs font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
                    <%= link_to "Edit", edit_admin_service_path(service), class: "px-2.5 py-1.5 text-xs font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <%# Pagination %>
    <% if @services.respond_to?(:total_pages) && @services.total_pages > 1 %>
      <div class="mt-6 flex items-center justify-center gap-2">
        <% if @services.current_page > 1 %>
          <%= link_to "&larr; Previous".html_safe, admin_services_path(page: @services.current_page - 1), class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
        <% end %>
        <span class="px-4 py-2 text-sm text-surface-500">
          Page <%= @services.current_page %> of <%= @services.total_pages %>
        </span>
        <% if @services.current_page < @services.total_pages %>
          <%= link_to "Next &rarr;".html_safe, admin_services_path(page: @services.current_page + 1), class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="bg-surface-100 rounded-lg p-12 text-center">
      <svg class="w-10 h-10 mx-auto text-surface-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      <div class="text-sm font-medium text-surface-600 mb-1">No services registered</div>
      <p class="text-xs text-surface-500 mb-4">Create your first service to enable API integrations</p>
      <%= link_to "Create Service", new_admin_service_path, class: "px-5 py-2.5 bg-surface-900 text-surface-0 font-medium text-sm rounded-md hover:bg-surface-800 transition-colors" %>
    </div>
  <% end %>
</div>
