<% content_for :title, "Services" %>

<header class="px-10 py-6 border-b border-slate-700/20 flex items-center justify-between bg-pd-secondary sticky top-0 z-40">
  <div>
    <h1 class="text-2xl font-bold text-slate-100">Services</h1>
    <p class="text-sm text-slate-500 mt-1"><%= Service.count %> registered services</p>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to "New Service", new_admin_service_path, class: "px-4 py-2.5 text-sm font-semibold text-pd-primary bg-cyan-accent rounded-xl hover:shadow-[0_0_20px_rgba(63,196,224,0.4)] transition-all" %>
  </div>
</header>

<div class="p-8 px-10">
  <% if @services.any? %>
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Service</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Status</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">API Keys</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Webhooks</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Created</th>
              <th class="px-6 py-4 text-right text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @services.each do |service| %>
              <tr class="hover:bg-pd-tertiary transition-colors">
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <div class="font-semibold text-slate-100"><%= service.name %></div>
                  <div class="text-xs text-slate-500 font-mono mt-1"><%= service.public_id %></div>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <% case service.status %>
                  <% when 'active' %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-emerald-500/15 text-emerald-500">Active</span>
                  <% when 'suspended' %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-amber-500/15 text-amber-500">Suspended</span>
                  <% when 'decommissioned' %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-slate-600/30 text-slate-400">Decommissioned</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <span class="text-slate-100 font-mono"><%= service.keys_count || service.service_keys.count %></span>
                  <span class="text-slate-500 text-sm">keys</span>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <span class="text-slate-100 font-mono"><%= service.service_webhooks.count %></span>
                  <span class="text-slate-500 text-sm">webhooks</span>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20 text-slate-400 text-sm">
                  <%= service.created_at.strftime("%b %d, %Y") %>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <%= link_to "View", admin_service_path(service), class: "px-3 py-1.5 text-xs font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-lg hover:bg-pd-hover transition-all" %>
                    <%= link_to "Edit", edit_admin_service_path(service), class: "px-3 py-1.5 text-xs font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-lg hover:bg-pd-hover transition-all" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <%# Pagination %>
    <% if @services.respond_to?(:total_pages) && @services.total_pages > 1 %>
      <div class="mt-6 flex items-center justify-center gap-2">
        <% if @services.current_page > 1 %>
          <%= link_to "&larr; Previous".html_safe, admin_services_path(page: @services.current_page - 1), class: "px-4 py-2 text-sm font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-xl hover:bg-pd-hover transition-all" %>
        <% end %>
        <span class="px-4 py-2 text-sm text-slate-500">
          Page <%= @services.current_page %> of <%= @services.total_pages %>
        </span>
        <% if @services.current_page < @services.total_pages %>
          <%= link_to "Next &rarr;".html_safe, admin_services_path(page: @services.current_page + 1), class: "px-4 py-2 text-sm font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-xl hover:bg-pd-hover transition-all" %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl p-16 text-center">
      <div class="text-5xl mb-4 opacity-50">&#9881;</div>
      <div class="text-lg font-semibold text-slate-400 mb-2">No services registered</div>
      <p class="text-slate-500 mb-4">Create your first service to enable API integrations</p>
      <%= link_to "Create Service", new_admin_service_path, class: "px-5 py-2.5 bg-cyan-accent text-pd-primary font-semibold rounded-xl hover:shadow-[0_0_20px_rgba(63,196,224,0.4)] transition-all" %>
    </div>
  <% end %>
</div>
