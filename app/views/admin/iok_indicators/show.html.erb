<% content_for :title, @indicator.title %>

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div>
    <%= link_to "Back to indicators", admin_iok_indicators_path, class: "text-xs text-surface-500 hover:text-surface-700 transition-colors" %>
    <h1 class="text-xl font-semibold text-surface-900 mt-1"><%= @indicator.title %></h1>
    <p class="text-sm text-surface-500 mt-0.5 font-mono"><%= @indicator.slug %> &middot; <%= @indicator.public_id %></p>
  </div>
  <div class="flex items-center gap-3">
    <% if @indicator.enabled? %>
      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-success/10 text-success">Enabled</span>
      <%= button_to "Disable", disable_admin_iok_indicator_path(@indicator), method: :post, class: "px-4 py-2.5 text-sm font-medium text-danger bg-danger/10 rounded-md hover:bg-danger/20 transition-colors cursor-pointer" %>
    <% else %>
      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-surface-300/50 text-surface-600">Disabled</span>
      <%= button_to "Enable", enable_admin_iok_indicator_path(@indicator), method: :post, class: "px-4 py-2.5 text-sm font-medium text-surface-0 bg-surface-900 rounded-md hover:bg-surface-800 transition-colors cursor-pointer" %>
    <% end %>
  </div>
</header>

<div class="p-8 space-y-6">
  <% if @indicator.description.present? %>
    <div class="bg-surface-100 rounded-lg p-5">
      <h2 class="text-xs font-medium text-surface-500 mb-2">Description</h2>
      <p class="text-sm text-surface-800 whitespace-pre-line"><%= @indicator.description %></p>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-surface-100 rounded-lg p-5">
      <h2 class="text-xs font-medium text-surface-500 mb-3">Tags</h2>
      <% if @indicator.tags.any? %>
        <div class="flex flex-wrap gap-1">
          <% @indicator.tags.each do |tag| %>
            <%= link_to tag, admin_iok_indicators_path(tag: tag), class: "inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-info/10 text-info hover:bg-info/20 transition-colors" %>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-surface-500">None</p>
      <% end %>
    </div>

    <div class="bg-surface-100 rounded-lg p-5">
      <h2 class="text-xs font-medium text-surface-500 mb-3">Source</h2>
      <dl class="space-y-2 text-sm">
        <div class="flex justify-between gap-4">
          <dt class="text-surface-500">Upstream rule</dt>
          <dd>
            <% if @indicator.source_url.present? %>
              <a href="<%= @indicator.source_url %>" class="text-surface-800 underline hover:text-surface-900" rel="noopener" target="_blank">View YAML</a>
            <% else %>
              <span class="text-surface-500">&mdash;</span>
            <% end %>
          </dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-surface-500">Last synced</dt>
          <dd class="text-surface-800">
            <% if @indicator.synced_at %>
              <%= @indicator.synced_at.strftime("%b %d, %Y %H:%M") %>
            <% else %>
              &mdash;
            <% end %>
          </dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-surface-500">Digest</dt>
          <dd class="text-surface-800 font-mono text-xs truncate max-w-[16rem]"><%= @indicator.content_digest %></dd>
        </div>
      </dl>
    </div>
  </div>

  <% if @indicator.reference_urls.any? %>
    <div class="bg-surface-100 rounded-lg p-5">
      <h2 class="text-xs font-medium text-surface-500 mb-3">References</h2>
      <ul class="space-y-1">
        <% @indicator.reference_urls.each do |url| %>
          <li><a href="<%= url %>" class="text-sm text-surface-700 underline hover:text-surface-900 break-all" rel="noopener" target="_blank"><%= url %></a></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-surface-100 rounded-lg p-5">
    <h2 class="text-xs font-medium text-surface-500 mb-3">Detection</h2>
    <p class="text-xs text-surface-500 mb-3">
      Matched against the fetched page. See the
      <a href="https://phish.report/docs/iok-rule-reference" class="underline hover:text-surface-700" rel="noopener" target="_blank">IOK rule reference</a>.
    </p>
    <pre class="text-xs text-surface-800 font-mono bg-surface-200/50 rounded-md p-4 overflow-x-auto"><%= JSON.pretty_generate(@indicator.detection) %></pre>
  </div>
</div>
