<% content_for :title, "IOK Indicators" %>

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div>
    <h1 class="text-xl font-semibold text-surface-900">IOK Indicators</h1>
    <p class="text-sm text-surface-500 mt-0.5">
      Phishing kit fingerprints from
      <a href="https://github.com/phish-report/IOK" class="underline hover:text-surface-700" rel="noopener" target="_blank">phish-report/IOK</a>
      <% if @last_synced_at %>
        &middot; synced <%= time_ago_in_words(@last_synced_at) %> ago
      <% end %>
    </p>
  </div>
  <div class="flex items-center gap-4">
    <div class="flex items-center gap-2 text-sm">
      <span class="px-2 py-0.5 rounded bg-success/10 text-success font-mono text-xs"><%= @enabled_count %></span>
      <span class="text-surface-500">enabled</span>
      <span class="px-2 py-0.5 rounded bg-surface-300/50 text-surface-600 font-mono text-xs ml-2"><%= @disabled_count %></span>
      <span class="text-surface-500">disabled</span>
    </div>
    <%= button_to "Sync Now", sync_admin_iok_indicators_path, method: :post, class: "ml-4 px-4 py-2.5 text-sm font-medium text-surface-0 bg-surface-900 rounded-md hover:bg-surface-800 transition-colors cursor-pointer" %>
  </div>
</header>

<div class="p-8">
  <%= form_with url: admin_iok_indicators_path, method: :get, class: "flex items-center gap-2 mb-6" do |form| %>
    <%= form.text_field :q, value: @query, placeholder: "Search by title or slug", class: "flex-1 max-w-md px-3 py-2 text-sm bg-surface-100 border border-surface-200/50 rounded-md text-surface-800 placeholder:text-surface-500" %>
    <%= form.hidden_field :tag, value: @tag %>
    <%= form.submit "Search", class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors cursor-pointer" %>
    <% if @query.present? || @tag.present? %>
      <%= link_to "Clear", admin_iok_indicators_path, class: "px-4 py-2 text-sm font-medium text-surface-600 hover:text-surface-900 transition-colors" %>
    <% end %>
  <% end %>

  <% if @indicators.any? %>
    <div class="bg-surface-100 rounded-lg overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-surface-200/50">
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Indicator</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Tags</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Status</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Synced</th>
              <th class="px-5 py-2.5 text-right text-xs font-medium text-surface-500">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @indicators.each do |indicator| %>
              <tr class="border-b border-surface-200/50 hover:bg-surface-200/30 transition-colors">
                <td class="px-5 py-3">
                  <div class="flex items-center gap-2">
                    <span class="text-sm text-surface-800"><%= indicator.title %></span>
                    <% unless indicator.source == "upstream" %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-accent/10 text-accent">local</span>
                    <% end %>
                  </div>
                  <code class="text-xs text-surface-500 font-mono"><%= indicator.slug %></code>
                </td>
                <td class="px-5 py-3">
                  <div class="flex flex-wrap gap-1">
                    <% indicator.tags.first(4).each do |tag| %>
                      <%= link_to tag, admin_iok_indicators_path(tag: tag), class: "inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-info/10 text-info hover:bg-info/20 transition-colors" %>
                    <% end %>
                  </div>
                </td>
                <td class="px-5 py-3">
                  <div class="flex items-center gap-2">
                    <% if indicator.enabled? %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-success/10 text-success">Enabled</span>
                    <% else %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-surface-300/50 text-surface-600">Disabled</span>
                    <% end %>
                    <% case indicator.effective_severity %>
                    <% when Iok::Severity::MALICIOUS %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-danger/10 text-danger">malicious</span>
                    <% when Iok::Severity::SUSPICIOUS %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-warning/10 text-warning">suspicious</span>
                    <% else %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-surface-300/50 text-surface-600">informational</span>
                    <% end %>
                  </div>
                </td>
                <td class="px-5 py-3 text-surface-600 text-sm">
                  <% if indicator.synced_at %>
                    <%= indicator.synced_at.strftime("%b %d, %Y") %>
                  <% else %>
                    &mdash;
                  <% end %>
                </td>
                <td class="px-5 py-3 text-right">
                  <%= link_to "View", admin_iok_indicator_path(indicator), class: "px-2.5 py-1.5 text-xs font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <% if @indicators.respond_to?(:total_pages) && @indicators.total_pages > 1 %>
      <div class="mt-6 flex items-center justify-center gap-2">
        <% if @indicators.current_page > 1 %>
          <%= link_to "Previous", admin_iok_indicators_path(page: @indicators.current_page - 1, tag: @tag, q: @query), class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
        <% end %>
        <span class="px-4 py-2 text-sm text-surface-500">
          Page <%= @indicators.current_page %> of <%= @indicators.total_pages %>
        </span>
        <% if @indicators.current_page < @indicators.total_pages %>
          <%= link_to "Next", admin_iok_indicators_path(page: @indicators.current_page + 1, tag: @tag, q: @query), class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="bg-surface-100 rounded-lg p-12 text-center">
      <svg class="w-10 h-10 mx-auto text-surface-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" />
      </svg>
      <div class="text-sm font-medium text-surface-600 mb-1">No indicators</div>
      <p class="text-xs text-surface-500 mb-4">Run a sync to pull the rule corpus from phish-report/IOK</p>
      <%= button_to "Sync Now", sync_admin_iok_indicators_path, method: :post, class: "px-5 py-2.5 bg-surface-900 text-surface-0 font-medium text-sm rounded-md hover:bg-surface-800 transition-colors cursor-pointer" %>
    </div>
  <% end %>
</div>
