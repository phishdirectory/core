<% content_for :title, "Add Protection" %>

<header class="px-10 py-6 border-b border-slate-700/20 flex items-center justify-between bg-pd-secondary sticky top-0 z-40">
  <div>
    <div class="flex items-center gap-3 mb-2">
      <%= link_to admin_protections_path, class: "text-slate-500 hover:text-slate-300 transition-colors" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      <% end %>
      <h1 class="text-2xl font-bold text-slate-100">Add Protection</h1>
    </div>
    <p class="text-sm text-slate-500">Protect a domain or URL from being flagged as phishing</p>
  </div>
</header>

<div class="p-8 px-10 max-w-2xl">
  <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl p-6">
    <%= form_with model: [:admin, @protection], class: "space-y-6" do |form| %>
      <% if @protection.errors.any? %>
        <div class="bg-red-500/10 border border-red-500/30 rounded-xl p-4">
          <div class="flex items-center gap-2 text-red-400 font-semibold mb-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
            </svg>
            <span><%= pluralize(@protection.errors.count, "error") %> prevented this protection from being saved:</span>
          </div>
          <ul class="list-disc list-inside text-sm text-red-300 space-y-1">
            <% @protection.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <label class="block text-sm font-semibold text-slate-300 mb-2">Type</label>
        <div class="flex gap-4">
          <label class="flex items-center gap-2 cursor-pointer">
            <%= form.radio_button :protectable_type, "Phish::Domain", class: "w-4 h-4 text-sky-500 bg-pd-tertiary border-slate-600 focus:ring-sky-500 focus:ring-offset-pd-secondary" %>
            <span class="text-slate-300">Domain</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <%= form.radio_button :protectable_type, "Phish::Url", class: "w-4 h-4 text-purple-500 bg-pd-tertiary border-slate-600 focus:ring-purple-500 focus:ring-offset-pd-secondary" %>
            <span class="text-slate-300">URL</span>
          </label>
        </div>
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-300 mb-2">Value</label>
        <%= form.text_field :protectable_value, class: "w-full px-4 py-3 bg-pd-tertiary border border-slate-700/30 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-transparent font-mono", placeholder: "example.com or https://example.com/path" %>
        <p class="mt-2 text-sm text-slate-500">Enter the domain or URL exactly as it should be matched</p>
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-300 mb-2">Reason <span class="text-slate-500 font-normal">(optional)</span></label>
        <%= form.text_area :reason, rows: 3, class: "w-full px-4 py-3 bg-pd-tertiary border border-slate-700/30 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-transparent resize-none", placeholder: "Why is this domain/URL being protected?" %>
      </div>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-700/20">
        <%= link_to "Cancel", admin_protections_path, class: "px-4 py-2 text-sm font-medium text-slate-400 hover:text-slate-300 transition-colors" %>
        <%= form.submit "Add Protection", class: "px-6 py-2 text-sm font-semibold text-slate-100 bg-sky-600 hover:bg-sky-700 rounded-lg transition-all cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
