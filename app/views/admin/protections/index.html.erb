<% content_for :title, "Protected Entries" %>

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div>
    <h1 class="text-xl font-semibold text-surface-900">Protected Entries</h1>
    <p class="text-sm text-surface-500 mt-0.5"><%= Phish::Protection.kept.count %> entries protected</p>
  </div>
  <div class="flex items-center gap-4">
    <div class="flex items-center gap-2 text-sm">
      <span class="px-2 py-0.5 rounded bg-info/10 text-info font-mono text-xs"><%= Phish::Protection.kept.for_domains.count %></span>
      <span class="text-surface-500">domains</span>
      <span class="px-2 py-0.5 rounded bg-accent/10 text-accent font-mono text-xs ml-2"><%= Phish::Protection.kept.for_urls.count %></span>
      <span class="text-surface-500">urls</span>
    </div>
    <%= link_to "Add Protection", new_admin_protection_path, class: "ml-4 px-4 py-2.5 text-sm font-medium text-surface-0 bg-surface-900 rounded-md hover:bg-surface-800 transition-colors" %>
  </div>
</header>

<div class="p-8">
  <%# Filter tabs %>
  <div class="flex items-center gap-2 mb-6">
    <%= link_to "All", admin_protections_path, class: "px-4 py-2 text-sm font-medium rounded-md transition-colors #{@filter.nil? ? 'bg-surface-900 text-surface-0' : 'text-surface-600 hover:bg-surface-200'}" %>
    <%= link_to "Domains", admin_protections_path(type: 'domain'), class: "px-4 py-2 text-sm font-medium rounded-md transition-colors #{@filter == 'domain' ? 'bg-info text-surface-0' : 'text-surface-600 hover:bg-surface-200'}" %>
    <%= link_to "URLs", admin_protections_path(type: 'url'), class: "px-4 py-2 text-sm font-medium rounded-md transition-colors #{@filter == 'url' ? 'bg-accent text-surface-0' : 'text-surface-600 hover:bg-surface-200'}" %>
  </div>

  <% if @protections.any? %>
    <div class="bg-surface-100 rounded-lg overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-surface-200/50">
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Type</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Value</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Reason</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Protected By</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Added</th>
              <th class="px-5 py-2.5 text-right text-xs font-medium text-surface-500">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @protections.each do |protection| %>
              <tr class="border-b border-surface-200/50 hover:bg-surface-200/30 transition-colors">
                <td class="px-5 py-3">
                  <% if protection.protectable_type == "Phish::Domain" %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-info/10 text-info">Domain</span>
                  <% else %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-accent/10 text-accent">URL</span>
                  <% end %>
                </td>
                <td class="px-5 py-3">
                  <code class="text-sm text-surface-800 font-mono"><%= protection.protectable_value %></code>
                  <div class="text-xs text-surface-500 font-mono mt-0.5"><%= protection.public_id %></div>
                </td>
                <td class="px-5 py-3 text-surface-600 text-sm max-w-xs truncate">
                  <%= protection.reason.present? ? protection.reason : "—" %>
                </td>
                <td class="px-5 py-3">
                  <% if protection.protected_by %>
                    <%= link_to admin_user_path(protection.protected_by), class: "text-sm text-surface-600 hover:text-surface-900 transition-colors" do %>
                      <%= protection.protected_by.name || protection.protected_by.email %>
                    <% end %>
                  <% else %>
                    <span class="text-surface-500">—</span>
                  <% end %>
                </td>
                <td class="px-5 py-3 text-surface-600 text-sm">
                  <%= protection.created_at.strftime("%b %d, %Y") %>
                </td>
                <td class="px-5 py-3 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <%= link_to "View", admin_protection_path(protection), class: "px-2.5 py-1.5 text-xs font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
                    <%= button_to "Remove", admin_protection_path(protection), method: :delete, data: { turbo_confirm: "Are you sure you want to remove this protection?" }, class: "px-2.5 py-1.5 text-xs font-medium text-danger bg-danger/10 rounded-md hover:bg-danger/20 transition-colors cursor-pointer" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <%# Pagination %>
    <% if @protections.respond_to?(:total_pages) && @protections.total_pages > 1 %>
      <div class="mt-6 flex items-center justify-center gap-2">
        <% if @protections.current_page > 1 %>
          <%= link_to "&larr; Previous".html_safe, admin_protections_path(page: @protections.current_page - 1, type: @filter), class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
        <% end %>
        <span class="px-4 py-2 text-sm text-surface-500">
          Page <%= @protections.current_page %> of <%= @protections.total_pages %>
        </span>
        <% if @protections.current_page < @protections.total_pages %>
          <%= link_to "Next &rarr;".html_safe, admin_protections_path(page: @protections.current_page + 1, type: @filter), class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="bg-surface-100 rounded-lg p-12 text-center">
      <svg class="w-10 h-10 mx-auto text-surface-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
      <div class="text-sm font-medium text-surface-600 mb-1">No protected entries</div>
      <p class="text-xs text-surface-500 mb-4">Protected domains and URLs will not be flagged as phishing</p>
      <%= link_to "Add Protection", new_admin_protection_path, class: "px-5 py-2.5 bg-surface-900 text-surface-0 font-medium text-sm rounded-md hover:bg-surface-800 transition-colors" %>
    </div>
  <% end %>
</div>
