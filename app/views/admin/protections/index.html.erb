<% content_for :title, "Protected Entries" %>

<header class="px-10 py-6 border-b border-slate-700/20 flex items-center justify-between bg-pd-secondary sticky top-0 z-40">
  <div>
    <h1 class="text-2xl font-bold text-slate-100">Protected Entries</h1>
    <p class="text-sm text-slate-500 mt-1"><%= Phish::Protection.kept.count %> entries protected</p>
  </div>
  <div class="flex items-center gap-4">
    <div class="flex items-center gap-2 text-sm">
      <span class="px-2.5 py-1 rounded-full bg-sky-500/15 text-sky-500 font-mono"><%= Phish::Protection.kept.for_domains.count %></span>
      <span class="text-slate-500">domains</span>
      <span class="px-2.5 py-1 rounded-full bg-purple-500/15 text-purple-500 font-mono ml-2"><%= Phish::Protection.kept.for_urls.count %></span>
      <span class="text-slate-500">urls</span>
    </div>
    <%= link_to "Add Protection", new_admin_protection_path, class: "ml-4 px-4 py-2 text-sm font-medium text-slate-100 bg-sky-600 hover:bg-sky-700 rounded-lg transition-all" %>
  </div>
</header>

<div class="p-8 px-10">
  <%# Filter tabs %>
  <div class="flex items-center gap-2 mb-6">
    <%= link_to "All", admin_protections_path, class: "px-4 py-2 text-sm font-medium rounded-lg transition-all #{@filter.nil? ? 'bg-slate-700 text-slate-100' : 'text-slate-400 hover:bg-pd-tertiary'}" %>
    <%= link_to "Domains", admin_protections_path(type: 'domain'), class: "px-4 py-2 text-sm font-medium rounded-lg transition-all #{@filter == 'domain' ? 'bg-sky-600 text-slate-100' : 'text-slate-400 hover:bg-pd-tertiary'}" %>
    <%= link_to "URLs", admin_protections_path(type: 'url'), class: "px-4 py-2 text-sm font-medium rounded-lg transition-all #{@filter == 'url' ? 'bg-purple-600 text-slate-100' : 'text-slate-400 hover:bg-pd-tertiary'}" %>
  </div>

  <% if @protections.any? %>
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Type</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Value</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Reason</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Protected By</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Added</th>
              <th class="px-6 py-4 text-right text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @protections.each do |protection| %>
              <tr class="hover:bg-pd-tertiary transition-colors">
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <% if protection.protectable_type == "Phish::Domain" %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-sky-500/15 text-sky-500">Domain</span>
                  <% else %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-purple-500/15 text-purple-500">URL</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <code class="text-sm text-slate-100 font-mono"><%= protection.protectable_value %></code>
                  <div class="text-xs text-slate-500 font-mono mt-1"><%= protection.public_id %></div>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20 text-slate-400 text-sm max-w-xs truncate">
                  <%= protection.reason.present? ? protection.reason : "—" %>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <% if protection.protected_by %>
                    <%= link_to admin_user_path(protection.protected_by), class: "flex items-center gap-2 hover:text-slate-100 transition-colors" do %>
                      <span class="text-sm text-slate-400"><%= protection.protected_by.name || protection.protected_by.email %></span>
                    <% end %>
                  <% else %>
                    <span class="text-slate-500">—</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20 text-slate-400 text-sm">
                  <%= protection.created_at.strftime("%b %d, %Y") %>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <%= link_to "View", admin_protection_path(protection), class: "px-3 py-1.5 text-xs font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-lg hover:bg-pd-hover transition-all" %>
                    <%= button_to "Remove", admin_protection_path(protection), method: :delete, data: { turbo_confirm: "Are you sure you want to remove this protection?" }, class: "px-3 py-1.5 text-xs font-medium text-red-400 bg-pd-elevated border border-slate-700/30 rounded-lg hover:bg-red-500/20 transition-all" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <%# Pagination %>
    <% if @protections.respond_to?(:total_pages) && @protections.total_pages > 1 %>
      <div class="mt-6 flex items-center justify-center gap-2">
        <% if @protections.current_page > 1 %>
          <%= link_to "&larr; Previous".html_safe, admin_protections_path(page: @protections.current_page - 1, type: @filter), class: "px-4 py-2 text-sm font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-xl hover:bg-pd-hover transition-all" %>
        <% end %>
        <span class="px-4 py-2 text-sm text-slate-500">
          Page <%= @protections.current_page %> of <%= @protections.total_pages %>
        </span>
        <% if @protections.current_page < @protections.total_pages %>
          <%= link_to "Next &rarr;".html_safe, admin_protections_path(page: @protections.current_page + 1, type: @filter), class: "px-4 py-2 text-sm font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-xl hover:bg-pd-hover transition-all" %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl p-16 text-center">
      <div class="text-5xl mb-4 opacity-50">&#128737;</div>
      <div class="text-lg font-semibold text-slate-400 mb-2">No protected entries</div>
      <p class="text-slate-500 mb-4">Protected domains and URLs will not be flagged as phishing</p>
      <%= link_to "Add Protection", new_admin_protection_path, class: "inline-flex px-4 py-2 text-sm font-medium text-slate-100 bg-sky-600 hover:bg-sky-700 rounded-lg transition-all" %>
    </div>
  <% end %>
</div>
