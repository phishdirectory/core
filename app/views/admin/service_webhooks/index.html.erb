<% content_for :title, "#{@service.name} - Webhooks" %>

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div class="flex items-center gap-4">
    <%= link_to admin_service_path(@service), class: "text-surface-500 hover:text-surface-900 transition-colors" do %>
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"/></svg>
    <% end %>
    <div>
      <h1 class="text-xl font-semibold text-surface-900">Webhooks</h1>
      <p class="text-sm text-surface-500 mt-0.5"><%= @service.name %></p>
    </div>
  </div>
  <div class="flex items-center gap-3">
    <%= form_with url: admin_service_webhooks_path(@service), method: :post, class: "flex items-center gap-2" do %>
      <%= text_field_tag :url, nil, placeholder: "https://example.com/webhook", class: "px-3 py-2 text-sm bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 placeholder-surface-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 w-64 transition-colors" %>
      <%= submit_tag "Add Webhook", class: "px-4 py-2.5 text-sm font-medium text-surface-0 bg-surface-900 rounded-md hover:bg-surface-800 transition-colors cursor-pointer" %>
    <% end %>
  </div>
</header>

<div class="p-8">
  <% if @webhooks.any? %>
    <div class="bg-surface-100 rounded-lg overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-surface-200/50">
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">URL</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Secret</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Created</th>
              <th class="px-5 py-2.5 text-right text-xs font-medium text-surface-500">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @webhooks.each do |webhook| %>
              <tr class="border-b border-surface-200/50 hover:bg-surface-200/30 transition-colors">
                <td class="px-5 py-3">
                  <code class="text-xs text-surface-700 font-mono"><%= webhook.url %></code>
                </td>
                <td class="px-5 py-3">
                  <code class="text-xs text-surface-500 font-mono bg-surface-200 px-2 py-1 rounded"><%= webhook.secret %></code>
                </td>
                <td class="px-5 py-3 text-surface-600 text-sm">
                  <%= webhook.created_at.strftime("%b %d, %Y %I:%M %p") %>
                </td>
                <td class="px-5 py-3 text-right">
                  <%= button_to "Delete", admin_service_webhook_path(@service, webhook), method: :delete, class: "px-2.5 py-1.5 text-xs font-medium text-danger bg-danger/10 rounded-md hover:bg-danger/20 transition-colors cursor-pointer", data: { turbo_confirm: "Are you sure you want to delete this webhook?" } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-6 bg-surface-100 rounded-lg p-5">
      <h3 class="text-sm font-semibold text-surface-700 mb-3">Webhook Payload Verification</h3>
      <p class="text-sm text-surface-600 mb-3">
        Each webhook request includes a signature in the <code class="bg-surface-200 px-1.5 py-0.5 rounded text-surface-700 text-xs">X-Signature</code> header.
        Verify the signature using HMAC-SHA256 with your webhook secret:
      </p>
      <div class="bg-surface-200 rounded-md p-4 font-mono text-xs overflow-x-auto">
        <div class="text-surface-500"># Ruby example</div>
        <div class="text-surface-700 mt-2">
          signature = OpenSSL::HMAC.hexdigest("SHA256", secret, payload)<br>
          valid = ActiveSupport::SecurityUtils.secure_compare(signature, request_signature)
        </div>
      </div>
    </div>
  <% else %>
    <div class="bg-surface-100 rounded-lg p-12 text-center">
      <svg class="w-10 h-10 mx-auto text-surface-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
      <div class="text-sm font-medium text-surface-600 mb-1">No webhooks</div>
      <p class="text-xs text-surface-500">Add a webhook URL to receive event notifications</p>
    </div>
  <% end %>
</div>
