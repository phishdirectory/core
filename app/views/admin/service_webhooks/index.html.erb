<% content_for :title, "#{@service.name} - Webhooks" %>

<header class="px-10 py-6 border-b border-slate-700/20 flex items-center justify-between bg-pd-secondary sticky top-0 z-40">
  <div class="flex items-center gap-4">
    <%= link_to admin_service_path(@service), class: "text-slate-400 hover:text-slate-100 transition-colors" do %>
      <span class="text-lg">&larr;</span>
    <% end %>
    <div>
      <h1 class="text-2xl font-bold text-slate-100">Webhooks</h1>
      <p class="text-sm text-slate-500 mt-1"><%= @service.name %></p>
    </div>
  </div>
  <div class="flex items-center gap-3">
    <%= form_with url: admin_service_webhooks_path(@service), method: :post, class: "flex items-center gap-2" do %>
      <%= text_field_tag :url, nil, placeholder: "https://example.com/webhook", class: "px-3 py-2 text-sm bg-pd-elevated border border-slate-700/30 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-accent/50 w-64" %>
      <%= submit_tag "Add Webhook", class: "px-4 py-2.5 text-sm font-semibold text-pd-primary bg-cyan-accent rounded-xl hover:shadow-[0_0_20px_rgba(63,196,224,0.4)] transition-all cursor-pointer" %>
    <% end %>
  </div>
</header>

<div class="p-8 px-10">
  <% if @webhooks.any? %>
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">URL</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Secret</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Created</th>
              <th class="px-6 py-4 text-right text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @webhooks.each do |webhook| %>
              <tr class="hover:bg-pd-tertiary transition-colors">
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <code class="text-sm text-slate-100 font-mono"><%= webhook.url %></code>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <code class="text-sm text-slate-400 font-mono bg-pd-elevated px-2 py-1 rounded"><%= webhook.secret %></code>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20 text-slate-400 text-sm">
                  <%= webhook.created_at.strftime("%b %d, %Y %I:%M %p") %>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20 text-right">
                  <%= button_to "Delete", admin_service_webhook_path(@service, webhook), method: :delete, class: "px-3 py-1.5 text-xs font-medium text-red-500 bg-red-500/10 border border-red-500/30 rounded-lg hover:bg-red-500/20 transition-all cursor-pointer", data: { turbo_confirm: "Are you sure you want to delete this webhook?" } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-6 bg-pd-secondary border border-slate-700/20 rounded-2xl p-6">
      <h3 class="text-sm font-semibold text-slate-400 mb-3">Webhook Payload Verification</h3>
      <p class="text-sm text-slate-500 mb-3">
        Each webhook request includes a signature in the <code class="bg-pd-elevated px-1.5 py-0.5 rounded text-slate-400">X-Signature</code> header.
        Verify the signature using HMAC-SHA256 with your webhook secret:
      </p>
      <div class="bg-pd-primary rounded-xl p-4 font-mono text-sm overflow-x-auto">
        <div class="text-slate-500"># Ruby example</div>
        <div class="text-slate-100 mt-2">
          signature = OpenSSL::HMAC.hexdigest("SHA256", secret, payload)<br>
          valid = ActiveSupport::SecurityUtils.secure_compare(signature, request_signature)
        </div>
      </div>
    </div>
  <% else %>
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl p-16 text-center">
      <div class="text-5xl mb-4 opacity-50">&#128279;</div>
      <div class="text-lg font-semibold text-slate-400 mb-2">No webhooks</div>
      <p class="text-slate-500">Add a webhook URL to receive event notifications</p>
    </div>
  <% end %>
</div>
