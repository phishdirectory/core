<% content_for :title, @service_provider.name %>

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div class="flex items-center gap-4">
    <%= link_to admin_saml_service_providers_path, class: "text-surface-500 hover:text-surface-900 transition-colors" do %>
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"/></svg>
    <% end %>
    <div>
      <h1 class="text-xl font-semibold text-surface-900"><%= @service_provider.name %></h1>
      <p class="text-sm text-surface-500 mt-0.5 font-mono"><%= @service_provider.public_id %></p>
    </div>
  </div>
  <div class="flex items-center gap-3">
    <% unless @service_provider.discarded? %>
      <%= link_to "Edit", edit_admin_saml_service_provider_path(@service_provider), class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
    <% end %>
  </div>
</header>

<div class="p-8">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <%# Left column - Configuration and authentications %>
    <div class="lg:col-span-2 space-y-6">
      <%# SAML Configuration %>
      <div class="bg-surface-100 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-surface-200/50">
          <h2 class="text-sm font-semibold text-surface-900">SAML Configuration</h2>
        </div>
        <div class="p-5 space-y-4">
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Entity ID</div>
            <code class="text-sm text-surface-700 font-mono break-all"><%= @service_provider.entity_id %></code>
          </div>
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Assertion Consumer Service URL</div>
            <code class="text-sm text-surface-700 font-mono break-all"><%= @service_provider.assertion_consumer_service_url %></code>
          </div>
          <% if @service_provider.single_logout_service_url.present? %>
            <div>
              <div class="text-xs font-medium text-surface-500 mb-1">Single Logout Service URL</div>
              <code class="text-sm text-surface-700 font-mono break-all"><%= @service_provider.single_logout_service_url %></code>
            </div>
          <% end %>
          <div class="grid grid-cols-2 gap-4 pt-2">
            <div>
              <div class="text-xs font-medium text-surface-500 mb-1">Name ID Format</div>
              <code class="text-xs text-surface-600 font-mono"><%= @service_provider.name_id_format.split(':').last %></code>
            </div>
            <div>
              <div class="text-xs font-medium text-surface-500 mb-1">Sign Assertions</div>
              <span class="text-sm text-surface-700"><%= @service_provider.sign_assertions? ? 'Yes' : 'No' %></span>
            </div>
            <div>
              <div class="text-xs font-medium text-surface-500 mb-1">Encrypt Assertions</div>
              <span class="text-sm text-surface-700"><%= @service_provider.encrypt_assertions? ? 'Yes' : 'No' %></span>
            </div>
          </div>
        </div>
      </div>

      <%# Recent Authentications %>
      <div class="bg-surface-100 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-surface-200/50 flex items-center justify-between">
          <div>
            <h2 class="text-sm font-semibold text-surface-900">Recent Authentications</h2>
            <p class="text-xs text-surface-500 mt-0.5"><%= @authentications.count %> recent</p>
          </div>
          <%= link_to "View All", admin_saml_authentications_path(service_provider_id: @service_provider.public_id), class: "text-xs text-accent hover:underline" %>
        </div>
        <% if @authentications.any? %>
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr class="border-b border-surface-200/50">
                  <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">User</th>
                  <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Status</th>
                  <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">IP Address</th>
                  <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Time</th>
                </tr>
              </thead>
              <tbody>
                <% @authentications.each do |auth| %>
                  <tr class="border-b border-surface-200/50 hover:bg-surface-200/30 transition-colors">
                    <td class="px-5 py-3">
                      <% if auth.user %>
                        <%= link_to auth.user.email, admin_user_path(auth.user), class: "text-sm text-accent hover:underline" %>
                      <% else %>
                        <span class="text-sm text-surface-500"><%= auth.name_id || '—' %></span>
                      <% end %>
                    </td>
                    <td class="px-5 py-3">
                      <% if auth.successful? %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-success/10 text-success">Success</span>
                      <% else %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-danger/10 text-danger">Failed</span>
                      <% end %>
                    </td>
                    <td class="px-5 py-3 text-sm text-surface-600 font-mono">
                      <%= auth.ip_address || '—' %>
                    </td>
                    <td class="px-5 py-3 text-surface-600 text-sm">
                      <%= time_ago_in_words(auth.created_at) %> ago
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-10 border-t border-surface-200/50">
            <div class="text-sm font-medium text-surface-600 mb-1">No authentication events</div>
            <p class="text-xs text-surface-500">Authentication events will appear here after users sign in via SAML</p>
          </div>
        <% end %>
      </div>
    </div>

    <%# Right column - Status and actions %>
    <div class="space-y-6">
      <%# Status card %>
      <div class="bg-surface-100 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-surface-200/50">
          <h2 class="text-sm font-semibold text-surface-900">Status</h2>
        </div>
        <div class="p-5 space-y-4">
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1.5">Provider Status</div>
            <% if @service_provider.discarded? %>
              <span class="inline-flex items-center px-2.5 py-1 rounded text-xs font-medium bg-surface-300 text-surface-600">Deleted</span>
            <% elsif @service_provider.enabled? %>
              <span class="inline-flex items-center px-2.5 py-1 rounded text-xs font-medium bg-success/10 text-success">Enabled</span>
            <% else %>
              <span class="inline-flex items-center px-2.5 py-1 rounded text-xs font-medium bg-warning/10 text-warning">Disabled</span>
            <% end %>
          </div>
          <% if @service_provider.service %>
            <div>
              <div class="text-xs font-medium text-surface-500 mb-1">Linked Service</div>
              <%= link_to @service_provider.service.name, admin_service_path(@service_provider.service), class: "text-sm text-accent hover:underline" %>
            </div>
          <% end %>
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Total Authentications</div>
            <div class="text-sm text-surface-800 font-mono"><%= @service_provider.authentications.count %></div>
          </div>
        </div>
      </div>

      <%# IdP Metadata %>
      <div class="bg-surface-100 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-surface-200/50">
          <h2 class="text-sm font-semibold text-surface-900">IdP Metadata</h2>
        </div>
        <div class="p-5 space-y-3">
          <p class="text-xs text-surface-500">Share this URL with service provider to configure SSO:</p>
          <div class="bg-surface-200 rounded-md p-3">
            <code class="text-xs text-surface-700 font-mono break-all"><%= saml_metadata_url %></code>
          </div>
        </div>
      </div>

      <%# Details card %>
      <div class="bg-surface-100 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-surface-200/50">
          <h2 class="text-sm font-semibold text-surface-900">Details</h2>
        </div>
        <div class="p-5 space-y-4">
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Created</div>
            <div class="text-sm text-surface-700"><%= @service_provider.created_at.strftime("%B %d, %Y at %I:%M %p") %></div>
          </div>
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Last Updated</div>
            <div class="text-sm text-surface-700"><%= @service_provider.updated_at.strftime("%B %d, %Y at %I:%M %p") %></div>
          </div>
        </div>
      </div>

      <%# Actions card %>
      <% unless @service_provider.discarded? %>
        <div class="bg-surface-100 rounded-lg overflow-hidden">
          <div class="px-5 py-4 border-b border-surface-200/50">
            <h2 class="text-sm font-semibold text-surface-900">Actions</h2>
          </div>
          <div class="p-5 space-y-3">
            <% if @service_provider.enabled? %>
              <%= button_to "Disable", disable_admin_saml_service_provider_path(@service_provider), method: :post, class: "w-full px-4 py-2.5 text-sm font-medium text-warning bg-warning/10 rounded-md hover:bg-warning/20 transition-colors cursor-pointer text-left", data: { turbo_confirm: "Are you sure you want to disable this service provider?" } %>
            <% else %>
              <%= button_to "Enable", enable_admin_saml_service_provider_path(@service_provider), method: :post, class: "w-full px-4 py-2.5 text-sm font-medium text-success bg-success/10 rounded-md hover:bg-success/20 transition-colors cursor-pointer text-left" %>
            <% end %>

            <div class="border-t border-surface-200/50 pt-3 mt-3">
              <div class="text-xs font-medium text-danger/70 mb-3">Danger Zone</div>
              <%= button_to "Delete Service Provider", admin_saml_service_provider_path(@service_provider), method: :delete, class: "w-full px-4 py-2.5 text-sm font-medium text-danger bg-danger/10 rounded-md hover:bg-danger/20 transition-colors cursor-pointer text-left", data: { turbo_confirm: "Are you sure you want to delete this service provider? Users will no longer be able to sign in via SAML." } %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
