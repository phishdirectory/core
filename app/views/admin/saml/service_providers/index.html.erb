<% content_for :title, "SAML Service Providers" %>

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div>
    <h1 class="text-xl font-semibold text-surface-900">SAML Service Providers</h1>
    <p class="text-sm text-surface-500 mt-0.5"><%= Saml::ServiceProvider.count %> configured service providers</p>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to "New Service Provider", new_admin_saml_service_provider_path, class: "px-4 py-2.5 text-sm font-medium text-surface-0 bg-surface-900 rounded-md hover:bg-surface-800 transition-colors" %>
  </div>
</header>

<div class="p-8">
  <% if @service_providers.any? %>
    <div class="bg-surface-100 rounded-lg overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-surface-200/50">
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Service Provider</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Entity ID</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Status</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Linked Service</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Created</th>
              <th class="px-5 py-2.5 text-right text-xs font-medium text-surface-500">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @service_providers.each do |sp| %>
              <tr class="border-b border-surface-200/50 hover:bg-surface-200/30 transition-colors <%= 'opacity-50' if sp.discarded? %>">
                <td class="px-5 py-3">
                  <div class="font-medium text-sm text-surface-800"><%= sp.name %></div>
                  <div class="text-xs text-surface-500 font-mono mt-0.5"><%= sp.public_id %></div>
                </td>
                <td class="px-5 py-3">
                  <code class="text-xs text-surface-600 font-mono"><%= truncate(sp.entity_id, length: 40) %></code>
                </td>
                <td class="px-5 py-3">
                  <% if sp.discarded? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-surface-300 text-surface-600">Deleted</span>
                  <% elsif sp.enabled? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-success/10 text-success">Enabled</span>
                  <% else %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-warning/10 text-warning">Disabled</span>
                  <% end %>
                </td>
                <td class="px-5 py-3">
                  <% if sp.service %>
                    <%= link_to sp.service.name, admin_service_path(sp.service), class: "text-sm text-accent hover:underline" %>
                  <% else %>
                    <span class="text-sm text-surface-500">—</span>
                  <% end %>
                </td>
                <td class="px-5 py-3 text-surface-600 text-sm">
                  <%= sp.created_at.strftime("%b %d, %Y") %>
                </td>
                <td class="px-5 py-3 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <%= link_to "View", admin_saml_service_provider_path(sp), class: "px-2.5 py-1.5 text-xs font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
                    <% unless sp.discarded? %>
                      <%= link_to "Edit", edit_admin_saml_service_provider_path(sp), class: "px-2.5 py-1.5 text-xs font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <%# Pagination %>
    <% if @service_providers.respond_to?(:total_pages) && @service_providers.total_pages > 1 %>
      <div class="mt-6 flex items-center justify-center gap-2">
        <% if @service_providers.current_page > 1 %>
          <%= link_to "&larr; Previous".html_safe, admin_saml_service_providers_path(page: @service_providers.current_page - 1), class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
        <% end %>
        <span class="px-4 py-2 text-sm text-surface-500">
          Page <%= @service_providers.current_page %> of <%= @service_providers.total_pages %>
        </span>
        <% if @service_providers.current_page < @service_providers.total_pages %>
          <%= link_to "Next &rarr;".html_safe, admin_saml_service_providers_path(page: @service_providers.current_page + 1), class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="bg-surface-100 rounded-lg p-12 text-center">
      <svg class="w-10 h-10 mx-auto text-surface-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
      <div class="text-sm font-medium text-surface-600 mb-1">No SAML service providers</div>
      <p class="text-xs text-surface-500 mb-4">Configure your first SAML service provider to enable SSO</p>
      <%= link_to "Add Service Provider", new_admin_saml_service_provider_path, class: "px-5 py-2.5 bg-surface-900 text-surface-0 font-medium text-sm rounded-md hover:bg-surface-800 transition-colors" %>
    </div>
  <% end %>
</div>
