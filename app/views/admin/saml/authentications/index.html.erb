<% content_for :title, "SAML Authentications" %>

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div>
    <h1 class="text-xl font-semibold text-surface-900">SAML Authentications</h1>
    <p class="text-sm text-surface-500 mt-0.5">Authentication events from SAML service providers</p>
  </div>
</header>

<div class="p-8">
  <%# Filters %>
  <div class="bg-surface-100 rounded-lg p-4 mb-6">
    <%= form_with url: admin_saml_authentications_path, method: :get, class: "flex items-center gap-4" do %>
      <div>
        <label class="block text-xs font-medium text-surface-500 mb-1">Status</label>
        <%= select_tag :status, options_for_select([["All", ""], ["Success", "success"], ["Failed", "failure"]], params[:status]), class: "px-3 py-2 text-sm bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-colors" %>
      </div>
      <%= submit_tag "Filter", class: "px-4 py-2 text-sm font-medium text-surface-0 bg-surface-900 rounded-md hover:bg-surface-800 transition-colors cursor-pointer mt-5" %>
      <% if params[:status].present? || params[:user_id].present? || params[:service_provider_id].present? %>
        <%= link_to "Clear", admin_saml_authentications_path, class: "text-sm text-accent hover:underline mt-5" %>
      <% end %>
    <% end %>
  </div>

  <% if @authentications.any? %>
    <div class="bg-surface-100 rounded-lg overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-surface-200/50">
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">User</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Service Provider</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Status</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">IP Address</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Time</th>
              <th class="px-5 py-2.5 text-right text-xs font-medium text-surface-500">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @authentications.each do |auth| %>
              <tr class="border-b border-surface-200/50 hover:bg-surface-200/30 transition-colors">
                <td class="px-5 py-3">
                  <% if auth.user %>
                    <%= link_to auth.user.email, admin_user_path(auth.user), class: "text-sm text-accent hover:underline" %>
                  <% else %>
                    <span class="text-sm text-surface-500"><%= auth.name_id || '—' %></span>
                  <% end %>
                </td>
                <td class="px-5 py-3">
                  <% if auth.service_provider %>
                    <%= link_to auth.service_provider.name, admin_saml_service_provider_path(auth.service_provider), class: "text-sm text-accent hover:underline" %>
                  <% else %>
                    <span class="text-sm text-surface-500">—</span>
                  <% end %>
                </td>
                <td class="px-5 py-3">
                  <% if auth.successful? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-success/10 text-success">Success</span>
                  <% else %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-danger/10 text-danger">Failed</span>
                  <% end %>
                </td>
                <td class="px-5 py-3 text-sm text-surface-600 font-mono">
                  <%= auth.ip_address || '—' %>
                </td>
                <td class="px-5 py-3 text-surface-600 text-sm">
                  <%= auth.created_at.strftime("%b %d, %Y %I:%M %p") %>
                </td>
                <td class="px-5 py-3 text-right">
                  <%= link_to "View", admin_saml_authentication_path(auth), class: "px-2.5 py-1.5 text-xs font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <%# Pagination %>
    <% if @authentications.respond_to?(:total_pages) && @authentications.total_pages > 1 %>
      <div class="mt-6 flex items-center justify-center gap-2">
        <% if @authentications.current_page > 1 %>
          <%= link_to "&larr; Previous".html_safe, admin_saml_authentications_path(page: @authentications.current_page - 1, status: params[:status]), class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
        <% end %>
        <span class="px-4 py-2 text-sm text-surface-500">
          Page <%= @authentications.current_page %> of <%= @authentications.total_pages %>
        </span>
        <% if @authentications.current_page < @authentications.total_pages %>
          <%= link_to "Next &rarr;".html_safe, admin_saml_authentications_path(page: @authentications.current_page + 1, status: params[:status]), class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="bg-surface-100 rounded-lg p-12 text-center">
      <svg class="w-10 h-10 mx-auto text-surface-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
      <div class="text-sm font-medium text-surface-600 mb-1">No authentication events</div>
      <p class="text-xs text-surface-500">Authentication events will appear here when users sign in via SAML</p>
    </div>
  <% end %>
</div>
