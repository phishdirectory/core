<% content_for :title, "Authentication Event" %>

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div class="flex items-center gap-4">
    <%= link_to admin_saml_authentications_path, class: "text-surface-500 hover:text-surface-900 transition-colors" do %>
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"/></svg>
    <% end %>
    <div>
      <h1 class="text-xl font-semibold text-surface-900">Authentication Event</h1>
      <p class="text-sm text-surface-500 mt-0.5"><%= @authentication.created_at.strftime("%B %d, %Y at %I:%M:%S %p") %></p>
    </div>
  </div>
</header>

<div class="p-8">
  <div class="max-w-2xl space-y-6">
    <%# Status %>
    <div class="bg-surface-100 rounded-lg overflow-hidden">
      <div class="px-5 py-4 border-b border-surface-200/50">
        <h2 class="text-sm font-semibold text-surface-900">Status</h2>
      </div>
      <div class="p-5">
        <% if @authentication.successful? %>
          <span class="inline-flex items-center px-3 py-1.5 rounded text-sm font-medium bg-success/10 text-success">Success</span>
        <% else %>
          <span class="inline-flex items-center px-3 py-1.5 rounded text-sm font-medium bg-danger/10 text-danger">Failed</span>
          <% if @authentication.error_message.present? %>
            <p class="text-sm text-danger/80 mt-2"><%= @authentication.error_message %></p>
          <% end %>
        <% end %>
      </div>
    </div>

    <%# Details %>
    <div class="bg-surface-100 rounded-lg overflow-hidden">
      <div class="px-5 py-4 border-b border-surface-200/50">
        <h2 class="text-sm font-semibold text-surface-900">Details</h2>
      </div>
      <div class="p-5 space-y-4">
        <div>
          <div class="text-xs font-medium text-surface-500 mb-1">User</div>
          <% if @authentication.user %>
            <%= link_to @authentication.user.email, admin_user_path(@authentication.user), class: "text-sm text-accent hover:underline" %>
          <% else %>
            <span class="text-sm text-surface-700">—</span>
          <% end %>
        </div>

        <div>
          <div class="text-xs font-medium text-surface-500 mb-1">Service Provider</div>
          <% if @authentication.service_provider %>
            <%= link_to @authentication.service_provider.name, admin_saml_service_provider_path(@authentication.service_provider), class: "text-sm text-accent hover:underline" %>
          <% else %>
            <span class="text-sm text-surface-700">—</span>
          <% end %>
        </div>

        <div>
          <div class="text-xs font-medium text-surface-500 mb-1">Name ID</div>
          <code class="text-sm text-surface-700 font-mono"><%= @authentication.name_id || '—' %></code>
        </div>

        <div>
          <div class="text-xs font-medium text-surface-500 mb-1">Session Index</div>
          <code class="text-sm text-surface-700 font-mono break-all"><%= @authentication.session_index || '—' %></code>
        </div>

        <% if @authentication.authn_context.present? %>
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Authentication Context</div>
            <code class="text-sm text-surface-700 font-mono"><%= @authentication.authn_context %></code>
          </div>
        <% end %>
      </div>
    </div>

    <%# Client Info %>
    <div class="bg-surface-100 rounded-lg overflow-hidden">
      <div class="px-5 py-4 border-b border-surface-200/50">
        <h2 class="text-sm font-semibold text-surface-900">Client Information</h2>
      </div>
      <div class="p-5 space-y-4">
        <div>
          <div class="text-xs font-medium text-surface-500 mb-1">IP Address</div>
          <code class="text-sm text-surface-700 font-mono"><%= @authentication.ip_address || '—' %></code>
        </div>

        <div>
          <div class="text-xs font-medium text-surface-500 mb-1">User Agent</div>
          <p class="text-sm text-surface-700 break-all"><%= @authentication.user_agent || '—' %></p>
        </div>

        <div>
          <div class="text-xs font-medium text-surface-500 mb-1">Time</div>
          <div class="text-sm text-surface-700"><%= @authentication.created_at.strftime("%B %d, %Y at %I:%M:%S %p %Z") %></div>
        </div>
      </div>
    </div>
  </div>
</div>
