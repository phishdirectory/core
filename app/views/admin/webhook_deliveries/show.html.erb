<% content_for :title, "Webhook Delivery Details" %>

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div class="flex items-center gap-4">
    <%= link_to admin_webhook_deliveries_path, class: "text-surface-500 hover:text-surface-900 transition-colors" do %>
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"/></svg>
    <% end %>
    <div>
      <h1 class="text-xl font-semibold text-surface-900">Webhook Delivery</h1>
      <p class="text-sm text-surface-500 mt-0.5"><%= @delivery.event %></p>
    </div>
  </div>
  <% if @delivery.retryable? %>
    <%= button_to "Retry Delivery", retry_admin_webhook_delivery_path(@delivery), method: :post, class: "px-4 py-2.5 text-sm font-medium text-warning bg-warning/10 rounded-md hover:bg-warning/20 transition-colors cursor-pointer" %>
  <% end %>
</header>

<div class="p-8">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <%# Left column - Payload/Response details %>
    <div class="lg:col-span-2 space-y-6">
      <%# Delivery summary card %>
      <div class="bg-surface-100 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-surface-200/50">
          <h2 class="text-sm font-semibold text-surface-900">Delivery Summary</h2>
        </div>
        <div class="p-5">
          <div class="flex items-center gap-6 mb-6">
            <div>
              <div class="text-xs font-medium text-surface-500 mb-1.5">Event</div>
              <span class="inline-flex items-center px-3 py-1.5 rounded-md text-sm font-mono font-medium bg-accent/10 text-accent">
                <%= @delivery.event %>
              </span>
            </div>
            <div>
              <div class="text-xs font-medium text-surface-500 mb-1.5">Status</div>
              <% case @delivery.status %>
              <% when 'pending' %>
                <span class="inline-flex items-center px-3 py-1.5 rounded-md text-sm font-medium bg-surface-300 text-surface-600">Pending</span>
              <% when 'delivering' %>
                <span class="inline-flex items-center px-3 py-1.5 rounded-md text-sm font-medium bg-info/10 text-info">Delivering</span>
              <% when 'delivered' %>
                <span class="inline-flex items-center px-3 py-1.5 rounded-md text-sm font-medium bg-success/10 text-success">Delivered</span>
              <% when 'failed' %>
                <span class="inline-flex items-center px-3 py-1.5 rounded-md text-sm font-medium bg-danger/10 text-danger">Failed</span>
              <% end %>
            </div>
            <div>
              <div class="text-xs font-medium text-surface-500 mb-1.5">Attempts</div>
              <span class="text-xl font-semibold font-mono text-surface-800"><%= @delivery.attempts %>/<%= WebhookDelivery::MAX_ATTEMPTS %></span>
            </div>
          </div>

          <div>
            <div class="text-xs font-medium text-surface-500 mb-1.5">Webhook URL</div>
            <code class="text-sm text-surface-800 font-mono break-all"><%= @delivery.url %></code>
          </div>
        </div>
      </div>

      <%# Payload card %>
      <% payload = @delivery.parsed_payload %>
      <div class="bg-surface-100 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-surface-200/50">
          <h2 class="text-sm font-semibold text-surface-900">Payload</h2>
        </div>
        <div class="p-5">
          <% if payload.any? %>
            <div class="bg-surface-200 rounded-md p-4 font-mono text-xs overflow-x-auto max-h-96 overflow-y-auto">
              <pre class="text-surface-700"><%= JSON.pretty_generate(payload) %></pre>
            </div>
          <% else %>
            <div class="text-center py-8">
              <div class="text-sm text-surface-500">No payload data</div>
            </div>
          <% end %>
        </div>
      </div>

      <%# Response card %>
      <% if @delivery.response.present? %>
        <div class="bg-surface-100 rounded-lg overflow-hidden">
          <div class="px-5 py-4 border-b border-surface-200/50">
            <h2 class="text-sm font-semibold text-surface-900">Response</h2>
          </div>
          <div class="p-5">
            <div class="bg-surface-200 rounded-md p-4 font-mono text-xs overflow-x-auto max-h-96 overflow-y-auto">
              <% begin %>
                <pre class="text-surface-700"><%= JSON.pretty_generate(JSON.parse(@delivery.response)) %></pre>
              <% rescue JSON::ParserError %>
                <pre class="text-surface-700"><%= @delivery.response %></pre>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <%# Right column - Metadata %>
    <div class="space-y-6">
      <%# Details card %>
      <div class="bg-surface-100 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-surface-200/50">
          <h2 class="text-sm font-semibold text-surface-900">Details</h2>
        </div>
        <div class="p-5 space-y-4">
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">ID</div>
            <code class="text-xs text-surface-600 font-mono break-all"><%= @delivery.id %></code>
          </div>
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Status</div>
            <% case @delivery.status %>
            <% when 'pending' %>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-surface-300 text-surface-600">Pending</span>
            <% when 'delivering' %>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-info/10 text-info">Delivering</span>
            <% when 'delivered' %>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-success/10 text-success">Delivered</span>
            <% when 'failed' %>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-danger/10 text-danger">Failed</span>
            <% end %>
          </div>
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Attempts</div>
            <div class="text-sm text-surface-700"><%= @delivery.attempts %> of <%= WebhookDelivery::MAX_ATTEMPTS %> max</div>
          </div>
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Last Attempt</div>
            <div class="text-sm text-surface-700"><%= @delivery.last_attempt_at&.strftime("%B %d, %Y at %I:%M:%S %p") || "—" %></div>
          </div>
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Created</div>
            <div class="text-sm text-surface-700"><%= @delivery.created_at.strftime("%B %d, %Y at %I:%M:%S %p") %></div>
          </div>
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Updated</div>
            <div class="text-sm text-surface-700"><%= @delivery.updated_at.strftime("%B %d, %Y at %I:%M:%S %p") %></div>
          </div>
        </div>
      </div>

      <%# Actions card %>
      <div class="bg-surface-100 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-surface-200/50">
          <h2 class="text-sm font-semibold text-surface-900">Actions</h2>
        </div>
        <div class="p-5 space-y-2">
          <% if @delivery.retryable? %>
            <%= button_to retry_admin_webhook_delivery_path(@delivery), method: :post, class: "w-full flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-medium text-warning bg-warning/10 rounded-md hover:bg-warning/20 transition-colors cursor-pointer" do %>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
              Retry Delivery
            <% end %>
          <% else %>
            <div class="text-center py-4">
              <div class="text-sm text-surface-500">
                <% if @delivery.delivered? %>
                  Successfully delivered
                <% elsif @delivery.attempts >= WebhookDelivery::MAX_ATTEMPTS %>
                  Max attempts reached
                <% else %>
                  Cannot retry
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
