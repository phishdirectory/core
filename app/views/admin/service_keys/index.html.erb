<% content_for :title, "#{@service.name} - API Keys" %>

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div class="flex items-center gap-4">
    <%= link_to admin_service_path(@service), class: "text-surface-500 hover:text-surface-900 transition-colors" do %>
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"/></svg>
    <% end %>
    <div>
      <h1 class="text-xl font-semibold text-surface-900">API Keys</h1>
      <p class="text-sm text-surface-500 mt-0.5"><%= @service.name %></p>
    </div>
  </div>
  <div class="flex items-center gap-3">
    <%= form_with url: admin_service_keys_path(@service), method: :post, class: "flex items-center gap-2" do %>
      <%= text_field_tag :notes, nil, placeholder: "Key notes (optional)", class: "px-3 py-2 text-sm bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 placeholder-surface-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 w-48 transition-colors" %>
      <%= submit_tag "Generate Key", class: "px-4 py-2.5 text-sm font-medium text-surface-0 bg-surface-900 rounded-md hover:bg-surface-800 transition-colors cursor-pointer" %>
    <% end %>
  </div>
</header>

<div class="p-8">
  <% if @keys.any? %>
    <div class="bg-surface-100 rounded-lg overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-surface-200/50">
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">API Key</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Hash Key</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Notes</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Status</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Created</th>
              <th class="px-5 py-2.5 text-right text-xs font-medium text-surface-500">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @keys.each do |key| %>
              <tr class="border-b border-surface-200/50 hover:bg-surface-200/30 transition-colors">
                <td class="px-5 py-3">
                  <code class="text-xs text-surface-700 font-mono bg-surface-200 px-2 py-1 rounded"><%= key.api_key %></code>
                </td>
                <td class="px-5 py-3">
                  <code class="text-xs text-surface-500 font-mono bg-surface-200 px-2 py-1 rounded"><%= key.hash_key.truncate(16) %>...</code>
                </td>
                <td class="px-5 py-3 text-surface-600 text-sm">
                  <%= key.notes.presence || "—" %>
                </td>
                <td class="px-5 py-3">
                  <% case key.status %>
                  <% when 'active' %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-success/10 text-success">Active</span>
                  <% when 'deprecated' %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-warning/10 text-warning">Deprecated</span>
                  <% when 'revoked' %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-danger/10 text-danger">Revoked</span>
                  <% end %>
                </td>
                <td class="px-5 py-3 text-surface-600 text-sm">
                  <%= key.created_at.strftime("%b %d, %Y %I:%M %p") %>
                </td>
                <td class="px-5 py-3 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <% if key.may_deprecate? %>
                      <%= button_to "Deprecate", deprecate_admin_service_key_path(@service, key), method: :post, class: "px-2.5 py-1.5 text-xs font-medium text-warning bg-warning/10 rounded-md hover:bg-warning/20 transition-colors cursor-pointer" %>
                    <% end %>
                    <% if key.may_revoke? %>
                      <%= button_to "Revoke", revoke_admin_service_key_path(@service, key), method: :post, class: "px-2.5 py-1.5 text-xs font-medium text-danger bg-danger/10 rounded-md hover:bg-danger/20 transition-colors cursor-pointer", data: { turbo_confirm: "Are you sure? This will permanently disable this key." } %>
                    <% end %>
                    <%= button_to "Delete", admin_service_key_path(@service, key), method: :delete, class: "px-2.5 py-1.5 text-xs font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors cursor-pointer", data: { turbo_confirm: "Are you sure you want to delete this key?" } %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="bg-surface-100 rounded-lg p-12 text-center">
      <svg class="w-10 h-10 mx-auto text-surface-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
      <div class="text-sm font-medium text-surface-600 mb-1">No API keys</div>
      <p class="text-xs text-surface-500">Generate a key to enable API access for this service</p>
    </div>
  <% end %>
</div>
