<% content_for :title, "#{@service.name} - API Keys" %>

<header class="px-10 py-6 border-b border-slate-700/20 flex items-center justify-between bg-pd-secondary sticky top-0 z-40">
  <div class="flex items-center gap-4">
    <%= link_to admin_service_path(@service), class: "text-slate-400 hover:text-slate-100 transition-colors" do %>
      <span class="text-lg">&larr;</span>
    <% end %>
    <div>
      <h1 class="text-2xl font-bold text-slate-100">API Keys</h1>
      <p class="text-sm text-slate-500 mt-1"><%= @service.name %></p>
    </div>
  </div>
  <div class="flex items-center gap-3">
    <%= form_with url: admin_service_keys_path(@service), method: :post, class: "flex items-center gap-2" do %>
      <%= text_field_tag :notes, nil, placeholder: "Key notes (optional)", class: "px-3 py-2 text-sm bg-pd-elevated border border-slate-700/30 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-accent/50 w-48" %>
      <%= submit_tag "Generate Key", class: "px-4 py-2.5 text-sm font-semibold text-pd-primary bg-cyan-accent rounded-xl hover:shadow-[0_0_20px_rgba(63,196,224,0.4)] transition-all cursor-pointer" %>
    <% end %>
  </div>
</header>

<div class="p-8 px-10">
  <% if @keys.any? %>
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">API Key</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Hash Key</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Notes</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Status</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Created</th>
              <th class="px-6 py-4 text-right text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @keys.each do |key| %>
              <tr class="hover:bg-pd-tertiary transition-colors">
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <code class="text-sm text-slate-100 font-mono bg-pd-elevated px-2 py-1 rounded"><%= key.api_key %></code>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <code class="text-sm text-slate-400 font-mono bg-pd-elevated px-2 py-1 rounded"><%= key.hash_key.truncate(16) %>...</code>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20 text-slate-400 text-sm">
                  <%= key.notes.presence || "—" %>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <% case key.status %>
                  <% when 'active' %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-emerald-500/15 text-emerald-500">Active</span>
                  <% when 'deprecated' %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-amber-500/15 text-amber-500">Deprecated</span>
                  <% when 'revoked' %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-red-500/15 text-red-500">Revoked</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20 text-slate-400 text-sm">
                  <%= key.created_at.strftime("%b %d, %Y %I:%M %p") %>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <% if key.may_deprecate? %>
                      <%= button_to "Deprecate", deprecate_admin_service_key_path(@service, key), method: :post, class: "px-3 py-1.5 text-xs font-medium text-amber-500 bg-amber-500/10 border border-amber-500/30 rounded-lg hover:bg-amber-500/20 transition-all cursor-pointer" %>
                    <% end %>
                    <% if key.may_revoke? %>
                      <%= button_to "Revoke", revoke_admin_service_key_path(@service, key), method: :post, class: "px-3 py-1.5 text-xs font-medium text-red-500 bg-red-500/10 border border-red-500/30 rounded-lg hover:bg-red-500/20 transition-all cursor-pointer", data: { turbo_confirm: "Are you sure? This will permanently disable this key." } %>
                    <% end %>
                    <%= button_to "Delete", admin_service_key_path(@service, key), method: :delete, class: "px-3 py-1.5 text-xs font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-lg hover:bg-pd-hover transition-all cursor-pointer", data: { turbo_confirm: "Are you sure you want to delete this key?" } %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl p-16 text-center">
      <div class="text-5xl mb-4 opacity-50">&#9829;</div>
      <div class="text-lg font-semibold text-slate-400 mb-2">No API keys</div>
      <p class="text-slate-500">Generate a key to enable API access for this service</p>
    </div>
  <% end %>
</div>
