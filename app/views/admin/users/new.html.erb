<% content_for :title, "New User" %>

<header class="px-10 py-6 border-b border-slate-700/20 flex items-center justify-between bg-pd-secondary sticky top-0 z-40">
  <div class="flex items-center gap-4">
    <%= link_to admin_users_path, class: "text-slate-400 hover:text-slate-100 transition-colors" do %>
      <span class="text-lg">&larr;</span>
    <% end %>
    <div>
      <h1 class="text-2xl font-bold text-slate-100">New User</h1>
      <p class="text-sm text-slate-500 mt-1">Create a new user account</p>
    </div>
  </div>
</header>

<div class="p-8 px-10 max-w-2xl">
  <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-700/20">
      <h2 class="text-lg font-semibold text-slate-100">User Details</h2>
    </div>
    <div class="p-6">
      <%= form_with model: [:admin, @user], class: "space-y-6" do |f| %>
        <% if @user.errors.any? %>
          <div class="bg-red-500/15 border border-red-500/30 text-red-400 px-5 py-3.5 rounded-xl text-sm">
            <div class="font-semibold mb-2"><%= pluralize(@user.errors.count, "error") %> prevented this user from being saved:</div>
            <ul class="list-disc list-inside space-y-1">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= f.label :first_name, class: "block text-xs font-semibold text-slate-500 uppercase tracking-widest mb-2" %>
            <%= f.text_field :first_name, class: "w-full px-4 py-3 text-sm bg-pd-elevated border border-slate-700/30 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-accent/50", placeholder: "John" %>
          </div>
          <div>
            <%= f.label :last_name, class: "block text-xs font-semibold text-slate-500 uppercase tracking-widest mb-2" %>
            <%= f.text_field :last_name, class: "w-full px-4 py-3 text-sm bg-pd-elevated border border-slate-700/30 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-accent/50", placeholder: "Doe" %>
          </div>
        </div>

        <div>
          <%= f.label :email, class: "block text-xs font-semibold text-slate-500 uppercase tracking-widest mb-2" %>
          <%= f.email_field :email, class: "w-full px-4 py-3 text-sm bg-pd-elevated border border-slate-700/30 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-accent/50", placeholder: "john@example.com" %>
        </div>

        <% if current_user.superadmin? %>
          <div class="border-t border-slate-700/20 pt-6">
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-4">Advanced Options</div>

            <div class="space-y-4">
              <div>
                <%= f.label :access_level, class: "block text-xs font-semibold text-slate-500 uppercase tracking-widest mb-2" %>
                <%= f.select :access_level, User::ACCESS_LEVELS.map { |l| [l.titleize, l] }, {}, class: "w-full px-4 py-3 text-sm bg-pd-elevated border border-slate-700/30 rounded-xl text-slate-100 focus:outline-none focus:border-cyan-accent/50" %>
              </div>

              <div class="flex items-center gap-6">
                <label class="flex items-center gap-2 cursor-pointer">
                  <%= f.check_box :staff, class: "w-4 h-4 rounded border-slate-700/30 bg-pd-elevated text-cyan-accent focus:ring-cyan-accent/50" %>
                  <span class="text-sm text-slate-400">Staff member</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                  <%= f.check_box :pd_dev, class: "w-4 h-4 rounded border-slate-700/30 bg-pd-elevated text-cyan-accent focus:ring-cyan-accent/50" %>
                  <span class="text-sm text-slate-400">PD Developer</span>
                </label>
              </div>
            </div>
          </div>
        <% end %>

        <div class="flex items-center justify-end gap-3 pt-4">
          <%= link_to "Cancel", admin_users_path, class: "px-4 py-2.5 text-sm font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-xl hover:bg-pd-hover hover:border-slate-600/50 transition-all" %>
          <%= f.submit "Create User", class: "px-5 py-2.5 text-sm font-semibold text-pd-primary bg-cyan-accent rounded-xl hover:shadow-[0_0_20px_rgba(63,196,224,0.4)] transition-all cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
