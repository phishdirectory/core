<% content_for :title, "Users" %>

<header class="px-10 py-6 border-b border-slate-700/20 flex items-center justify-between bg-pd-secondary sticky top-0 z-40">
  <div>
    <h1 class="text-2xl font-bold text-slate-100">Users</h1>
    <p class="text-sm text-slate-500 mt-1"><%= User.count %> total users</p>
  </div>
  <div class="flex items-center gap-3">
    <%= form_with url: search_admin_users_path, method: :get, class: "flex items-center gap-2" do |f| %>
      <%= f.text_field :q, placeholder: "Search users...", value: params[:q], class: "px-4 py-2 text-sm bg-pd-elevated border border-slate-700/30 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-accent/50 w-64" %>
      <%= f.submit "Search", class: "px-4 py-2 text-sm font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-xl hover:bg-pd-hover hover:border-slate-600/50 transition-all cursor-pointer" %>
    <% end %>
    <%= link_to "New User", new_admin_user_path, class: "px-4 py-2.5 text-sm font-semibold text-pd-primary bg-cyan-accent rounded-xl hover:shadow-[0_0_20px_rgba(63,196,224,0.4)] transition-all" %>
  </div>
</header>

<div class="p-8 px-10">
  <% if @users.any? %>
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">User</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Status</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Access</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Verified</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Joined</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Last Seen</th>
              <th class="px-6 py-4 text-right text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @users.each do |user| %>
              <tr class="hover:bg-pd-tertiary transition-colors">
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-gradient-to-br from-pd-elevated to-pd-tertiary border border-slate-700/30 rounded-full flex items-center justify-center font-semibold text-sm text-slate-400">
                      <%= user.initials %>
                    </div>
                    <div>
                      <div class="font-semibold text-slate-100"><%= user.full_name %></div>
                      <div class="text-xs text-slate-500"><%= user.email %></div>
                      <div class="text-xs text-slate-600 font-mono"><%= user.pd_id %> &middot; <%= user.public_id %></div>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <% case user.status %>
                  <% when 'active' %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-emerald-500/15 text-emerald-500">Active</span>
                  <% when 'suspended' %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-red-500/15 text-red-500">Suspended</span>
                  <% when 'deactivated' %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-slate-600/30 text-slate-400">Deactivated</span>
                  <% end %>
                  <% if user.locked? %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-red-500/15 text-red-500 ml-1">Locked</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-blue-500/15 text-blue-400">
                    <%= user.access_level.titleize %>
                  </span>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <% if user.email_verified? %>
                    <span class="text-emerald-500">&#10003;</span>
                  <% else %>
                    <span class="text-slate-500">&mdash;</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20 text-slate-400 text-sm">
                  <%= user.created_at.strftime("%b %d, %Y") %>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20 text-slate-400 text-sm">
                  <%= user.last_seen_at ? time_ago_in_words(user.last_seen_at) + " ago" : "Never" %>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <%= link_to "View", admin_user_path(user), class: "px-3 py-1.5 text-xs font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-lg hover:bg-pd-hover transition-all" %>
                    <%= link_to "Edit", edit_admin_user_path(user), class: "px-3 py-1.5 text-xs font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-lg hover:bg-pd-hover transition-all" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <%# Pagination %>
    <% if @users.respond_to?(:total_pages) && @users.total_pages > 1 %>
      <div class="mt-6 flex items-center justify-center gap-2">
        <% if @users.current_page > 1 %>
          <%= link_to "&larr; Previous".html_safe, admin_users_path(page: @users.current_page - 1, q: params[:q]), class: "px-4 py-2 text-sm font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-xl hover:bg-pd-hover transition-all" %>
        <% end %>
        <span class="px-4 py-2 text-sm text-slate-500">
          Page <%= @users.current_page %> of <%= @users.total_pages %>
        </span>
        <% if @users.current_page < @users.total_pages %>
          <%= link_to "Next &rarr;".html_safe, admin_users_path(page: @users.current_page + 1, q: params[:q]), class: "px-4 py-2 text-sm font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-xl hover:bg-pd-hover transition-all" %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl p-16 text-center">
      <div class="text-5xl mb-4 opacity-50">&#9786;</div>
      <div class="text-lg font-semibold text-slate-400 mb-2">No users found</div>
      <% if params[:q].present? %>
        <p class="text-slate-500 mb-4">No users match your search for "<%= params[:q] %>"</p>
        <%= link_to "Clear search", admin_users_path, class: "px-4 py-2 text-sm font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-xl hover:bg-pd-hover transition-all" %>
      <% else %>
        <p class="text-slate-500">Users will appear here once they sign up</p>
      <% end %>
    </div>
  <% end %>
</div>
