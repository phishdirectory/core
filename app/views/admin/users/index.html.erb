<% content_for :title, "Users" %>

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div>
    <h1 class="text-xl font-semibold text-surface-900">Users</h1>
    <p class="text-sm text-surface-500 mt-0.5"><%= User.count %> total users</p>
  </div>
  <div class="flex items-center gap-3">
    <%= form_with url: search_admin_users_path, method: :get, class: "flex items-center gap-2" do |f| %>
      <%= f.text_field :q, placeholder: "Search users...", value: params[:q], class: "px-3 py-2 text-sm bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 placeholder-surface-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 w-64 transition-colors" %>
      <%= f.submit "Search", class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors cursor-pointer" %>
    <% end %>
    <%= link_to "New User", new_admin_user_path, class: "px-4 py-2.5 text-sm font-medium text-surface-0 bg-surface-900 rounded-md hover:bg-surface-800 transition-colors" %>
  </div>
</header>

<div class="p-8">
  <% if @users.any? %>
    <div class="bg-surface-100 rounded-lg overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-surface-200/50">
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">User</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Status</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Access</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Verified</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Joined</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Last Seen</th>
              <th class="px-5 py-2.5 text-right text-xs font-medium text-surface-500">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @users.each do |user| %>
              <tr class="border-b border-surface-200/50 hover:bg-surface-200/30 transition-colors">
                <td class="px-5 py-3">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-surface-200 rounded-full flex items-center justify-center font-semibold text-sm text-surface-600">
                      <%= user.initials %>
                    </div>
                    <div>
                      <div class="font-medium text-sm text-surface-800"><%= user.full_name %></div>
                      <div class="text-xs text-surface-500"><%= user.email %></div>
                      <div class="text-xs text-surface-500 font-mono"><%= user.pd_id %> &middot; <%= user.public_id %></div>
                    </div>
                  </div>
                </td>
                <td class="px-5 py-3">
                  <% case user.status %>
                  <% when 'active' %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-success/10 text-success">Active</span>
                  <% when 'suspended' %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-danger/10 text-danger">Suspended</span>
                  <% when 'deactivated' %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-surface-300 text-surface-600">Deactivated</span>
                  <% end %>
                  <% if user.locked? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-danger/10 text-danger ml-1">Locked</span>
                  <% end %>
                </td>
                <td class="px-5 py-3">
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-info/10 text-info">
                    <%= user.access_level.titleize %>
                  </span>
                </td>
                <td class="px-5 py-3">
                  <% if user.email_verified? %>
                    <span class="text-success">&#10003;</span>
                  <% else %>
                    <span class="text-surface-500">&mdash;</span>
                  <% end %>
                </td>
                <td class="px-5 py-3 text-surface-600 text-sm">
                  <%= user.created_at.strftime("%b %d, %Y") %>
                </td>
                <td class="px-5 py-3 text-surface-600 text-sm">
                  <%= user.last_seen_at ? time_ago_in_words(user.last_seen_at) + " ago" : "Never" %>
                </td>
                <td class="px-5 py-3 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <%= link_to "View", admin_user_path(user), class: "px-2.5 py-1.5 text-xs font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
                    <%= link_to "Edit", edit_admin_user_path(user), class: "px-2.5 py-1.5 text-xs font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <%# Pagination %>
    <% if @users.respond_to?(:total_pages) && @users.total_pages > 1 %>
      <div class="mt-6 flex items-center justify-center gap-2">
        <% if @users.current_page > 1 %>
          <%= link_to "&larr; Previous".html_safe, admin_users_path(page: @users.current_page - 1, q: params[:q]), class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
        <% end %>
        <span class="px-4 py-2 text-sm text-surface-500">
          Page <%= @users.current_page %> of <%= @users.total_pages %>
        </span>
        <% if @users.current_page < @users.total_pages %>
          <%= link_to "Next &rarr;".html_safe, admin_users_path(page: @users.current_page + 1, q: params[:q]), class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="bg-surface-100 rounded-lg p-12 text-center">
      <svg class="w-10 h-10 mx-auto text-surface-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
      <div class="text-sm font-medium text-surface-600 mb-1">No users found</div>
      <% if params[:q].present? %>
        <p class="text-xs text-surface-500 mb-4">No users match your search for "<%= params[:q] %>"</p>
        <%= link_to "Clear search", admin_users_path, class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
      <% else %>
        <p class="text-xs text-surface-500">Users will appear here once they sign up</p>
      <% end %>
    </div>
  <% end %>
</div>
