<% content_for :title, "Edit #{@user.full_name}" %>

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div class="flex items-center gap-4">
    <%= link_to admin_user_path(@user), class: "text-surface-500 hover:text-surface-900 transition-colors" do %>
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"/></svg>
    <% end %>
    <div>
      <h1 class="text-xl font-semibold text-surface-900">Edit User</h1>
      <p class="text-sm text-surface-500 mt-0.5 font-mono"><%= @user.pd_id %></p>
    </div>
  </div>
</header>

<div class="p-8 max-w-2xl">
  <div class="bg-surface-100 rounded-lg overflow-hidden">
    <div class="px-5 py-4 border-b border-surface-200/50">
      <h2 class="text-sm font-semibold text-surface-900">User Details</h2>
    </div>
    <div class="p-5">
      <%= form_with model: [:admin, @user], class: "space-y-5" do |f| %>
        <% if @user.errors.any? %>
          <div class="bg-danger/10 text-danger rounded-md p-3 text-sm">
            <div class="font-medium mb-2"><%= pluralize(@user.errors.count, "error") %> prevented this user from being saved:</div>
            <ul class="list-disc pl-4 space-y-1">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= f.label :first_name, class: "block text-xs font-medium text-surface-600 mb-1.5" %>
            <%= f.text_field :first_name, class: "w-full px-3 py-2.5 bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 placeholder-surface-500 text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-colors" %>
          </div>
          <div>
            <%= f.label :last_name, class: "block text-xs font-medium text-surface-600 mb-1.5" %>
            <%= f.text_field :last_name, class: "w-full px-3 py-2.5 bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 placeholder-surface-500 text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-colors" %>
          </div>
        </div>

        <div>
          <%= f.label :email, class: "block text-xs font-medium text-surface-600 mb-1.5" %>
          <%= f.email_field :email, class: "w-full px-3 py-2.5 bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 placeholder-surface-500 text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-colors" %>
        </div>

        <% if current_user.superadmin? %>
          <div class="border-t border-surface-200/50 pt-5">
            <div class="text-xs font-medium text-surface-500 mb-4">Advanced Options</div>

            <div class="space-y-4">
              <div>
                <%= f.label :access_level, class: "block text-xs font-medium text-surface-600 mb-1.5" %>
                <%= f.select :access_level, User::ACCESS_LEVELS.map { |l| [l.titleize, l] }, {}, class: "w-full px-3 py-2.5 bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-colors" %>
              </div>

              <div class="flex items-center gap-6">
                <label class="flex items-center gap-2 cursor-pointer">
                  <%= f.check_box :staff, class: "w-4 h-4 rounded border-surface-300 bg-surface-200 text-accent focus:ring-accent/50" %>
                  <span class="text-sm text-surface-600">Staff member</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                  <%= f.check_box :pd_dev, class: "w-4 h-4 rounded border-surface-300 bg-surface-200 text-accent focus:ring-accent/50" %>
                  <span class="text-sm text-surface-600">PD Developer</span>
                </label>
              </div>
            </div>
          </div>
        <% end %>

        <div class="flex items-center justify-end gap-3 pt-4">
          <%= link_to "Cancel", admin_user_path(@user), class: "px-5 py-2.5 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
          <%= f.submit "Save Changes", class: "px-5 py-2.5 bg-surface-900 text-surface-0 font-medium text-sm rounded-md hover:bg-surface-800 transition-colors cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
