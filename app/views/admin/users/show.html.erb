<% content_for :title, @user.full_name %>

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div class="flex items-center gap-4">
    <%= link_to admin_users_path, class: "text-surface-500 hover:text-surface-900 transition-colors" do %>
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"/></svg>
    <% end %>
    <div>
      <h1 class="text-xl font-semibold text-surface-900"><%= @user.full_name %></h1>
      <p class="text-sm text-surface-500 mt-0.5 font-mono"><%= @user.pd_id %></p>
    </div>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to "Edit", edit_admin_user_path(@user), class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
  </div>
</header>

<div class="p-8">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <%# Left column - User details %>
    <div class="lg:col-span-2 space-y-6">
      <%# Basic Info %>
      <div class="bg-surface-100 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-surface-200/50">
          <h2 class="text-sm font-semibold text-surface-900">User Information</h2>
        </div>
        <div class="p-5">
          <div class="flex items-start gap-5">
            <div class="w-16 h-16 bg-surface-200 rounded-lg flex items-center justify-center font-semibold text-xl text-surface-600">
              <%= @user.initials %>
            </div>
            <div class="flex-1 grid grid-cols-2 gap-4">
              <div>
                <div class="text-xs font-medium text-surface-500 mb-1">First Name</div>
                <div class="text-sm text-surface-800"><%= @user.first_name %></div>
              </div>
              <div>
                <div class="text-xs font-medium text-surface-500 mb-1">Last Name</div>
                <div class="text-sm text-surface-800"><%= @user.last_name %></div>
              </div>
              <div>
                <div class="text-xs font-medium text-surface-500 mb-1">Email</div>
                <div class="text-sm text-surface-800"><%= @user.email %></div>
              </div>
              <div>
                <div class="text-xs font-medium text-surface-500 mb-1">Username</div>
                <div class="text-sm text-surface-800 font-mono">@<%= @user.username %></div>
              </div>
              <div>
                <div class="text-xs font-medium text-surface-500 mb-1">PD ID</div>
                <div class="text-sm text-surface-800 font-mono"><%= @user.pd_id %></div>
              </div>
              <div>
                <div class="text-xs font-medium text-surface-500 mb-1">Public ID</div>
                <div class="text-sm text-surface-600 font-mono"><%= @user.public_id %></div>
              </div>
              <div>
                <div class="text-xs font-medium text-surface-500 mb-1">Email Verified</div>
                <div>
                  <% if @user.email_verified? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-success/10 text-success">Verified</span>
                  <% else %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-warning/10 text-warning">Unverified</span>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <%# Sessions %>
      <div class="bg-surface-100 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-surface-200/50 flex items-center justify-between">
          <h2 class="text-sm font-semibold text-surface-900">Active Sessions</h2>
          <span class="text-xs font-medium text-surface-500"><%= @user.user_sessions.active.count %> active</span>
        </div>
        <% if @user.user_sessions.any? %>
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr class="border-b border-surface-200/50">
                  <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Device</th>
                  <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">IP</th>
                  <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Last Seen</th>
                  <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Status</th>
                </tr>
              </thead>
              <tbody>
                <% @user.user_sessions.order(last_seen_at: :desc).limit(5).each do |session| %>
                  <tr class="border-b border-surface-200/50 hover:bg-surface-200/30 transition-colors">
                    <td class="px-5 py-3 text-sm text-surface-800"><%= session.device_info&.truncate(30) || "Unknown" %></td>
                    <td class="px-5 py-3 text-sm text-surface-600 font-mono"><%= session.ip || "Unknown" %></td>
                    <td class="px-5 py-3 text-sm text-surface-600"><%= session.last_seen_at ? time_ago_in_words(session.last_seen_at) + " ago" : "Never" %></td>
                    <td class="px-5 py-3">
                      <% if session.active? %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-success/10 text-success">Active</span>
                      <% else %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-surface-300 text-surface-600">Expired</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-10 border-t border-surface-200/50">
            <div class="text-sm font-medium text-surface-600 mb-1">No sessions</div>
            <p class="text-xs text-surface-500">This user has no active sessions</p>
          </div>
        <% end %>
      </div>

      <%# API Keys %>
      <div class="bg-surface-100 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-surface-200/50 flex items-center justify-between">
          <h2 class="text-sm font-semibold text-surface-900">API Keys</h2>
          <span class="text-xs font-medium text-surface-500"><%= @user.user_api_keys.active.count %> active</span>
        </div>
        <% if @user.user_api_keys.any? %>
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr class="border-b border-surface-200/50">
                  <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Name</th>
                  <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Last Used</th>
                  <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Created</th>
                  <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Status</th>
                </tr>
              </thead>
              <tbody>
                <% @user.user_api_keys.order(created_at: :desc).limit(5).each do |key| %>
                  <tr class="border-b border-surface-200/50 hover:bg-surface-200/30 transition-colors">
                    <td class="px-5 py-3 text-sm font-medium text-surface-800"><%= key.name %></td>
                    <td class="px-5 py-3 text-sm text-surface-600"><%= key.last_used_at ? time_ago_in_words(key.last_used_at) + " ago" : "Never" %></td>
                    <td class="px-5 py-3 text-sm text-surface-600"><%= key.created_at.strftime("%b %d, %Y") %></td>
                    <td class="px-5 py-3">
                      <% if key.usable? %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-success/10 text-success">Active</span>
                      <% elsif key.expired? %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-warning/10 text-warning">Expired</span>
                      <% else %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-danger/10 text-danger">Revoked</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-10 border-t border-surface-200/50">
            <div class="text-sm font-medium text-surface-600 mb-1">No API keys</div>
            <p class="text-xs text-surface-500">This user hasn't created any API keys</p>
          </div>
        <% end %>
      </div>

      <%# Service Roles %>
      <div class="bg-surface-100 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-surface-200/50 flex items-center justify-between">
          <div>
            <h2 class="text-sm font-semibold text-surface-900">Service Roles</h2>
            <p class="text-xs text-surface-500 mt-0.5">Per-service role overrides (global: <%= @user.access_level %>)</p>
          </div>
        </div>
        <% if @user.service_roles.kept.any? %>
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr class="border-b border-surface-200/50">
                  <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Service</th>
                  <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Role</th>
                  <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Granted</th>
                  <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">By</th>
                  <th class="px-5 py-2.5 text-right text-xs font-medium text-surface-500"></th>
                </tr>
              </thead>
              <tbody>
                <% @user.service_roles.kept.includes(:service, :granted_by).each do |role| %>
                  <tr class="border-b border-surface-200/50 hover:bg-surface-200/30 transition-colors">
                    <td class="px-5 py-3">
                      <% if role.service %>
                        <%= link_to role.service.name, admin_service_path(role.service), class: "text-sm text-accent hover:underline" %>
                      <% else %>
                        <span class="text-sm text-surface-500">Unknown</span>
                      <% end %>
                    </td>
                    <td class="px-5 py-3">
                      <% case role.role %>
                      <% when 'owner' %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-purple-500/10 text-purple-500">Owner</span>
                      <% when 'superadmin' %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-danger/10 text-danger">Superadmin</span>
                      <% when 'admin' %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-warning/10 text-warning">Admin</span>
                      <% when 'trusted' %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-info/10 text-info">Trusted</span>
                      <% else %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-surface-300 text-surface-600">User</span>
                      <% end %>
                    </td>
                    <td class="px-5 py-3 text-sm text-surface-600">
                      <%= role.granted_at&.strftime("%b %d, %Y") || role.created_at.strftime("%b %d, %Y") %>
                    </td>
                    <td class="px-5 py-3 text-sm text-surface-600">
                      <% if role.granted_by %>
                        <%= link_to role.granted_by.full_name, admin_user_path(role.granted_by), class: "text-accent hover:underline" %>
                      <% else %>
                        <span class="text-surface-500">System</span>
                      <% end %>
                    </td>
                    <td class="px-5 py-3 text-right">
                      <%= button_to remove_service_role_admin_user_path(@user, role_id: role.id), method: :delete, class: "text-danger/70 hover:text-danger transition-colors", data: { turbo_confirm: "Remove this service role?" } do %>
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-6">
            <div class="text-sm font-medium text-surface-600 mb-1">No service-specific roles</div>
            <p class="text-xs text-surface-500">This user uses their global access level (<%= @user.access_level %>) for all services</p>
          </div>
        <% end %>

        <%# Add service role form %>
        <% available_services = Service.kept.where.not(id: @user.service_roles.kept.select(:service_id)) %>
        <% if available_services.any? %>
          <div class="px-5 py-4 border-t border-surface-200/50">
            <%= form_with url: add_service_role_admin_user_path(@user), method: :post, class: "flex items-center gap-3" do |f| %>
              <div class="flex-1">
                <%= f.select :service_id, available_services.map { |s| [s.name, s.id] }, { prompt: "Select service..." }, class: "w-full px-3 py-2 text-sm bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-colors" %>
              </div>
              <div class="w-36">
                <%= f.select :role, UserServiceRole::ROLES.map { |r| [r.titleize, r] }, {}, class: "w-full px-3 py-2 text-sm bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-colors" %>
              </div>
              <%= f.submit "Add Role", class: "px-4 py-2.5 text-sm font-medium text-surface-0 bg-surface-900 rounded-md hover:bg-surface-800 transition-colors cursor-pointer" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <%# Right column - Status and actions %>
    <div class="space-y-6">
      <%# Status card %>
      <div class="bg-surface-100 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-surface-200/50">
          <h2 class="text-sm font-semibold text-surface-900">Status</h2>
        </div>
        <div class="p-5 space-y-4">
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1.5">Account Status</div>
            <% case @user.status %>
            <% when 'active' %>
              <span class="inline-flex items-center px-2.5 py-1 rounded text-xs font-medium bg-success/10 text-success">Active</span>
            <% when 'suspended' %>
              <span class="inline-flex items-center px-2.5 py-1 rounded text-xs font-medium bg-danger/10 text-danger">Suspended</span>
            <% when 'deactivated' %>
              <span class="inline-flex items-center px-2.5 py-1 rounded text-xs font-medium bg-surface-300 text-surface-600">Deactivated</span>
            <% end %>
          </div>
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1.5">Access Level</div>
            <span class="inline-flex items-center px-2.5 py-1 rounded text-xs font-medium bg-info/10 text-info"><%= @user.access_level.titleize %></span>
          </div>
          <% if @user.locked? %>
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1.5">Lock Status</div>
            <span class="inline-flex items-center px-2.5 py-1 rounded text-xs font-medium bg-danger/10 text-danger">Locked</span>
          </div>
          <% end %>
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Staff Member</div>
            <span class="text-sm text-surface-700"><%= @user.staff? ? "Yes" : "No" %></span>
          </div>
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">PD Developer</div>
            <span class="text-sm text-surface-700"><%= @user.pd_dev? ? "Yes" : "No" %></span>
          </div>
        </div>
      </div>

      <%# Activity card %>
      <div class="bg-surface-100 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-surface-200/50">
          <h2 class="text-sm font-semibold text-surface-900">Activity</h2>
        </div>
        <div class="p-5 space-y-4">
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Joined</div>
            <div class="text-sm text-surface-700"><%= @user.created_at.strftime("%B %d, %Y") %></div>
          </div>
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Last Seen</div>
            <div class="text-sm text-surface-700"><%= @user.last_seen_at ? time_ago_in_words(@user.last_seen_at) + " ago" : "Never" %></div>
          </div>
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Last Login</div>
            <div class="text-sm text-surface-700"><%= @user.last_login_at ? time_ago_in_words(@user.last_login_at) + " ago" : "Never" %></div>
          </div>
        </div>
      </div>

      <%# Actions card %>
      <div class="bg-surface-100 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-surface-200/50">
          <h2 class="text-sm font-semibold text-surface-900">Actions</h2>
        </div>
        <div class="p-5 space-y-3">
          <%# Impersonation %>
          <% if current_user.can_impersonate? && @user.impersonatable_by?(current_user) %>
            <%= button_to "Impersonate User", impersonate_admin_user_path(@user), method: :post, class: "w-full px-4 py-2.5 text-sm font-medium text-surface-700 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors cursor-pointer text-left" %>
          <% end %>

          <%# Status actions %>
          <% if @user.may_suspend? %>
            <%= button_to "Suspend User", suspend_admin_user_path(@user), method: :post, class: "w-full px-4 py-2.5 text-sm font-medium text-warning bg-warning/10 rounded-md hover:bg-warning/20 transition-colors cursor-pointer text-left", data: { turbo_confirm: "Are you sure you want to suspend this user?" } %>
          <% end %>

          <% if @user.may_reactivate? %>
            <%= button_to "Reactivate User", reactivate_admin_user_path(@user), method: :post, class: "w-full px-4 py-2.5 text-sm font-medium text-success bg-success/10 rounded-md hover:bg-success/20 transition-colors cursor-pointer text-left" %>
          <% end %>

          <%# Lock actions %>
          <% if @user.locked? %>
            <%= button_to "Unlock Account", unlock_admin_user_path(@user), method: :post, class: "w-full px-4 py-2.5 text-sm font-medium text-success bg-success/10 rounded-md hover:bg-success/20 transition-colors cursor-pointer text-left" %>
          <% else %>
            <%= button_to "Lock Account", lock_admin_user_path(@user), method: :post, class: "w-full px-4 py-2.5 text-sm font-medium text-warning bg-warning/10 rounded-md hover:bg-warning/20 transition-colors cursor-pointer text-left", data: { turbo_confirm: "Are you sure you want to lock this account?" } %>
          <% end %>

          <%# Role actions (superadmin only) %>
          <% if current_user.superadmin? && @user != current_user %>
            <div class="border-t border-surface-200/50 pt-3 mt-3">
              <div class="text-xs font-medium text-surface-500 mb-3">Role Management</div>
              <% if @user.access_level != 'admin' && @user.access_level != 'superadmin' && @user.access_level != 'owner' %>
                <%= button_to "Promote to Admin", make_admin_admin_user_path(@user), method: :post, class: "w-full px-4 py-2.5 text-sm font-medium text-info bg-info/10 rounded-md hover:bg-info/20 transition-colors cursor-pointer text-left", data: { turbo_confirm: "Are you sure you want to promote this user to admin?" } %>
              <% end %>
              <% if @user.access_level != 'user' %>
                <%= button_to "Remove Privileges", remove_privileges_admin_user_path(@user), method: :post, class: "w-full px-4 py-2.5 text-sm font-medium text-danger bg-danger/10 rounded-md hover:bg-danger/20 transition-colors cursor-pointer text-left mt-2", data: { turbo_confirm: "Are you sure you want to remove all privileges from this user?" } %>
              <% end %>
            </div>
          <% end %>

          <%# Danger zone %>
          <div class="border-t border-surface-200/50 pt-3 mt-3">
            <div class="text-xs font-medium text-danger/70 mb-3">Danger Zone</div>
            <%= button_to "Delete User", admin_user_path(@user), method: :delete, class: "w-full px-4 py-2.5 text-sm font-medium text-danger bg-danger/10 rounded-md hover:bg-danger/20 transition-colors cursor-pointer text-left", data: { turbo_confirm: "Are you sure you want to permanently delete this user? This action cannot be undone." } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
