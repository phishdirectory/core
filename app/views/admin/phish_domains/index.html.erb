<% content_for :title, "Domains" %>

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div>
    <h1 class="text-xl font-semibold text-surface-900">Phishing Domains</h1>
    <p class="text-sm text-surface-500 mt-0.5"><%= Phish::Domain.count %> domains tracked</p>
  </div>
  <div class="flex items-center gap-4">
    <div class="flex items-center gap-2 text-sm">
      <span class="px-2 py-0.5 rounded bg-danger/10 text-danger font-mono text-xs"><%= Phish::Domain.phishing.count %></span>
      <span class="text-surface-500">phishing</span>
      <span class="px-2 py-0.5 rounded bg-warning/10 text-warning font-mono text-xs ml-2"><%= Phish::Domain.suspicious.count %></span>
      <span class="text-surface-500">suspicious</span>
      <span class="px-2 py-0.5 rounded bg-success/10 text-success font-mono text-xs ml-2"><%= Phish::Domain.clean.count %></span>
      <span class="text-surface-500">clean</span>
    </div>
  </div>
</header>

<div class="p-8">
  <% if @domains.any? %>
    <div class="bg-surface-100 rounded-lg overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-surface-200/50">
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Domain</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Classification</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Confidence</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Last Checked</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Added</th>
              <th class="px-5 py-2.5 text-right text-xs font-medium text-surface-500">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @domains.each do |domain| %>
              <tr class="border-b border-surface-200/50 hover:bg-surface-200/30 transition-colors">
                <td class="px-5 py-3">
                  <code class="text-sm text-surface-800 font-mono"><%= domain.domain %></code>
                  <div class="text-xs text-surface-500 font-mono mt-0.5"><%= domain.public_id %></div>
                </td>
                <td class="px-5 py-3">
                  <% if domain.verdict %>
                    <% case domain.classification %>
                    <% when 'phishing' %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-danger/10 text-danger">Phishing</span>
                    <% when 'suspicious' %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-warning/10 text-warning">Suspicious</span>
                    <% when 'clean' %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-success/10 text-success">Clean</span>
                    <% when 'unknown' %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-surface-300 text-surface-600">Unknown</span>
                    <% end %>
                  <% else %>
                    <span class="text-surface-500">—</span>
                  <% end %>
                </td>
                <td class="px-5 py-3">
                  <% if domain.confidence_score %>
                    <div class="flex items-center gap-2">
                      <div class="w-16 h-1.5 bg-surface-200 rounded-full overflow-hidden">
                        <div class="h-full rounded-full <%= domain.confidence_score >= 0.8 ? 'bg-success' : domain.confidence_score >= 0.5 ? 'bg-warning' : 'bg-danger' %>" style="width: <%= (domain.confidence_score * 100).to_i %>%"></div>
                      </div>
                      <span class="text-surface-600 text-sm font-mono"><%= (domain.confidence_score * 100).to_i %>%</span>
                    </div>
                  <% else %>
                    <span class="text-surface-500">—</span>
                  <% end %>
                </td>
                <td class="px-5 py-3 text-surface-600 text-sm">
                  <%= domain.last_checked_at ? time_ago_in_words(domain.last_checked_at) + " ago" : "Never" %>
                </td>
                <td class="px-5 py-3 text-surface-600 text-sm">
                  <%= domain.created_at.strftime("%b %d, %Y") %>
                </td>
                <td class="px-5 py-3 text-right">
                  <%= link_to "View", admin_domain_path(domain), class: "px-2.5 py-1.5 text-xs font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <%# Pagination %>
    <% if @domains.respond_to?(:total_pages) && @domains.total_pages > 1 %>
      <div class="mt-6 flex items-center justify-center gap-2">
        <% if @domains.current_page > 1 %>
          <%= link_to "&larr; Previous".html_safe, admin_domains_path(page: @domains.current_page - 1), class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
        <% end %>
        <span class="px-4 py-2 text-sm text-surface-500">
          Page <%= @domains.current_page %> of <%= @domains.total_pages %>
        </span>
        <% if @domains.current_page < @domains.total_pages %>
          <%= link_to "Next &rarr;".html_safe, admin_domains_path(page: @domains.current_page + 1), class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="bg-surface-100 rounded-lg p-12 text-center">
      <svg class="w-10 h-10 mx-auto text-surface-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
      <div class="text-sm font-medium text-surface-600 mb-1">No domains tracked</div>
      <p class="text-xs text-surface-500">Domains will appear here as they are checked via the API</p>
    </div>
  <% end %>
</div>
