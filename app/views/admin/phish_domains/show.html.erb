<% content_for :title, @domain.domain %>

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div class="flex items-center gap-4">
    <%= link_to admin_domains_path, class: "text-surface-500 hover:text-surface-900 transition-colors" do %>
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"/></svg>
    <% end %>
    <div>
      <h1 class="text-xl font-semibold text-surface-900 font-mono"><%= @domain.domain %></h1>
      <p class="text-sm text-surface-500 mt-0.5 font-mono"><%= @domain.public_id %></p>
    </div>
  </div>
</header>

<div class="p-8">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <%# Left column - Verdict details %>
    <div class="lg:col-span-2 space-y-6">
      <%# Verdict card %>
      <div class="bg-surface-100 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-surface-200/50">
          <h2 class="text-sm font-semibold text-surface-900">Verdict</h2>
        </div>
        <div class="p-5">
          <% if @domain.verdict %>
            <div class="flex items-center gap-6 mb-6">
              <div>
                <div class="text-xs font-medium text-surface-500 mb-1.5">Classification</div>
                <% case @domain.classification %>
                <% when 'phishing' %>
                  <span class="inline-flex items-center px-3 py-1.5 rounded-md text-sm font-medium bg-danger/10 text-danger">Phishing</span>
                <% when 'suspicious' %>
                  <span class="inline-flex items-center px-3 py-1.5 rounded-md text-sm font-medium bg-warning/10 text-warning">Suspicious</span>
                <% when 'clean' %>
                  <span class="inline-flex items-center px-3 py-1.5 rounded-md text-sm font-medium bg-success/10 text-success">Clean</span>
                <% when 'unknown' %>
                  <span class="inline-flex items-center px-3 py-1.5 rounded-md text-sm font-medium bg-surface-300 text-surface-600">Unknown</span>
                <% end %>
              </div>
              <div>
                <div class="text-xs font-medium text-surface-500 mb-1.5">Confidence</div>
                <div class="flex items-center gap-3">
                  <div class="w-24 h-2 bg-surface-200 rounded-full overflow-hidden">
                    <div class="h-full rounded-full <%= @domain.confidence_score && @domain.confidence_score >= 0.8 ? 'bg-success' : @domain.confidence_score && @domain.confidence_score >= 0.5 ? 'bg-warning' : 'bg-danger' %>" style="width: <%= @domain.confidence_score ? (@domain.confidence_score * 100).to_i : 0 %>%"></div>
                  </div>
                  <span class="text-xl font-semibold font-mono text-surface-800"><%= @domain.confidence_score ? "#{(@domain.confidence_score * 100).to_i}%" : "—" %></span>
                </div>
              </div>
            </div>

            <%# Sources %>
            <% if @domain.verdict.sources_list.any? %>
              <div class="border-t border-surface-200/50 pt-5">
                <div class="text-xs font-medium text-surface-500 mb-3">Detection Sources</div>
                <div class="space-y-3">
                  <% @domain.verdict.sources_list.each do |source| %>
                    <div class="bg-surface-200 rounded-md p-4 flex items-center justify-between">
                      <div>
                        <div class="font-medium text-sm text-surface-800"><%= source["name"] || source[:name] %></div>
                        <div class="text-xs text-surface-500 mt-0.5">
                          Checked <%= source["checked_at"] ? time_ago_in_words(Time.parse(source["checked_at"])) + " ago" : "unknown" %>
                        </div>
                      </div>
                      <div class="text-sm text-surface-600 font-mono">
                        <%= source["result"] || source[:result] %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <%# Metadata %>
            <% if @domain.verdict.metadata_hash.any? %>
              <div class="border-t border-surface-200/50 pt-5 mt-5">
                <div class="text-xs font-medium text-surface-500 mb-3">Additional Metadata</div>
                <div class="bg-surface-200 rounded-md p-4 font-mono text-xs overflow-x-auto">
                  <pre class="text-surface-700"><%= JSON.pretty_generate(@domain.verdict.metadata_hash) %></pre>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="text-center py-10">
              <div class="text-sm font-medium text-surface-600 mb-1">No verdict yet</div>
              <p class="text-xs text-surface-500">This domain has not been checked by any detection services</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# Right column - Details %>
    <div class="space-y-6">
      <%# Info card %>
      <div class="bg-surface-100 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-surface-200/50">
          <h2 class="text-sm font-semibold text-surface-900">Details</h2>
        </div>
        <div class="p-5 space-y-4">
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Domain</div>
            <code class="text-sm text-surface-800 font-mono"><%= @domain.domain %></code>
          </div>
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Public ID</div>
            <code class="text-xs text-surface-600 font-mono break-all"><%= @domain.public_id %></code>
          </div>
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">First Seen</div>
            <div class="text-sm text-surface-700"><%= @domain.created_at.strftime("%B %d, %Y at %I:%M %p") %></div>
          </div>
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Last Checked</div>
            <div class="text-sm text-surface-700"><%= @domain.last_checked_at ? @domain.last_checked_at.strftime("%B %d, %Y at %I:%M %p") : "Never" %></div>
          </div>
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Status</div>
            <% if @domain.stale? %>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-warning/10 text-warning">Stale</span>
            <% elsif @domain.checked? %>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-success/10 text-success">Current</span>
            <% else %>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-surface-300 text-surface-600">Unchecked</span>
            <% end %>
          </div>
        </div>
      </div>

      <%# External links %>
      <div class="bg-surface-100 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-surface-200/50">
          <h2 class="text-sm font-semibold text-surface-900">External Tools</h2>
        </div>
        <div class="p-5 space-y-2">
          <a href="https://www.virustotal.com/gui/domain/<%= @domain.domain %>" target="_blank" rel="noopener" class="flex items-center justify-between px-4 py-3 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors">
            <span class="text-sm text-surface-800">VirusTotal</span>
            <svg class="w-4 h-4 text-surface-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
          <a href="https://urlscan.io/search/#domain:<%= @domain.domain %>" target="_blank" rel="noopener" class="flex items-center justify-between px-4 py-3 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors">
            <span class="text-sm text-surface-800">urlscan.io</span>
            <svg class="w-4 h-4 text-surface-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
          <a href="https://transparencyreport.google.com/safe-browsing/search?url=<%= @domain.domain %>" target="_blank" rel="noopener" class="flex items-center justify-between px-4 py-3 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors">
            <span class="text-sm text-surface-800">Google Safe Browsing</span>
            <svg class="w-4 h-4 text-surface-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
