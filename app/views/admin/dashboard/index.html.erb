<% content_for :title, "Dashboard" %>

<header class="px-10 py-6 border-b border-slate-700/20 flex items-center justify-between bg-pd-secondary sticky top-0 z-40">
  <div>
    <h1 class="text-2xl font-bold text-slate-100">Admin Dashboard</h1>
    <p class="text-sm text-slate-500 mt-1">System overview and monitoring</p>
  </div>
</header>

<div class="p-8 px-10">
  <%# Quick stats %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5 mb-8">
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl p-6">
      <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-2">Total Users</div>
      <div class="text-3xl font-bold font-mono text-cyan-accent"><%= number_with_delimiter(@users_count) %></div>
    </div>
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl p-6">
      <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-2">Online Now</div>
      <div class="text-3xl font-bold font-mono text-emerald-500"><%= number_with_delimiter(@online_users) %></div>
    </div>
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl p-6">
      <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-2">Services</div>
      <div class="text-3xl font-bold font-mono text-slate-100"><%= number_with_delimiter(@services_count) %></div>
    </div>
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl p-6">
      <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-2">Domains Tracked</div>
      <div class="text-3xl font-bold font-mono text-slate-100"><%= number_with_delimiter(@domains_count) %></div>
    </div>
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl p-6">
      <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-2">Version</div>
      <div class="text-xl font-bold font-mono text-slate-400"><%= PhishDirectory::VERSION %></div>
      <div class="text-xs text-slate-600 font-mono mt-1"><%= PhishDirectory::GIT_SHA %></div>
    </div>
  </div>

  <%# Recent Users %>
  <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl overflow-hidden mb-6">
    <div class="px-6 py-5 border-b border-slate-700/20 flex items-center justify-between">
      <h2 class="text-lg font-semibold text-slate-100">Recent Users</h2>
      <%= link_to "View all", admin_users_path, class: "px-4 py-2 text-sm font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-xl hover:bg-pd-hover hover:border-slate-600/50 transition-all" %>
    </div>

    <% if @recent_users.any? %>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">User</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Status</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Access Level</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Joined</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_users.each do |user| %>
              <tr class="hover:bg-pd-tertiary transition-colors">
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 bg-gradient-to-br from-pd-elevated to-pd-tertiary border border-slate-700/30 rounded-full flex items-center justify-center font-semibold text-sm text-slate-400">
                      <%= user.initials %>
                    </div>
                    <div>
                      <span class="font-semibold text-slate-100"><%= user.full_name %></span>
                      <div class="text-xs text-slate-500"><%= user.email %></div>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <% case user.status %>
                  <% when 'active' %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-emerald-500/15 text-emerald-500">Active</span>
                  <% when 'pending' %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-amber-500/15 text-amber-500">Pending</span>
                  <% when 'suspended' %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-red-500/15 text-red-500">Suspended</span>
                  <% when 'locked' %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-red-500/15 text-red-500">Locked</span>
                  <% when 'deactivated' %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-slate-600/30 text-slate-400">Deactivated</span>
                  <% else %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-slate-600/30 text-slate-400"><%= user.status.titleize %></span>
                  <% end %>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-blue-500/15 text-blue-400">
                    <%= user.access_level.titleize %>
                  </span>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20 text-slate-400 text-sm">
                  <%= user.created_at.strftime("%b %d, %Y") %>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <%= link_to "View", admin_user_path(user), class: "px-3 py-1.5 text-xs font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-lg hover:bg-pd-hover transition-all" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-16 text-slate-500">
        <div class="text-5xl mb-4 opacity-50">&#9786;</div>
        <div class="text-lg font-semibold text-slate-400 mb-2">No users yet</div>
        <p class="text-slate-500">Users will appear here once they sign up</p>
      </div>
    <% end %>
  </div>

  <%# Quick Links %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
    <a href="/admin/flipper" class="bg-pd-secondary border border-slate-700/20 rounded-2xl p-6 hover:border-slate-600/50 transition-all group">
      <div class="text-2xl mb-3 opacity-70 group-hover:opacity-100 transition-opacity">&#9873;</div>
      <div class="font-semibold text-slate-100 mb-1">Feature Flags</div>
      <div class="text-sm text-slate-500">Manage Flipper feature toggles</div>
    </a>
    <a href="/admin/jobs" class="bg-pd-secondary border border-slate-700/20 rounded-2xl p-6 hover:border-slate-600/50 transition-all group">
      <div class="text-2xl mb-3 opacity-70 group-hover:opacity-100 transition-opacity">&#9889;</div>
      <div class="font-semibold text-slate-100 mb-1">Background Jobs</div>
      <div class="text-sm text-slate-500">Monitor Solid Queue jobs</div>
    </a>
    <a href="/admin/blazer" class="bg-pd-secondary border border-slate-700/20 rounded-2xl p-6 hover:border-slate-600/50 transition-all group">
      <div class="text-2xl mb-3 opacity-70 group-hover:opacity-100 transition-opacity">&#128200;</div>
      <div class="font-semibold text-slate-100 mb-1">Analytics</div>
      <div class="text-sm text-slate-500">Run SQL queries and view dashboards</div>
    </a>
    <a href="/admin/console_audits" class="bg-pd-secondary border border-slate-700/20 rounded-2xl p-6 hover:border-slate-600/50 transition-all group">
      <div class="text-2xl mb-3 opacity-70 group-hover:opacity-100 transition-opacity">&#128221;</div>
      <div class="font-semibold text-slate-100 mb-1">Console Audits</div>
      <div class="text-sm text-slate-500">Review Rails console activity</div>
    </a>
  </div>
</div>
