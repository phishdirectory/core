<% content_for :title, "Dashboard" %>

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div>
    <h1 class="text-xl font-semibold text-surface-900">Admin Dashboard</h1>
    <p class="text-sm text-surface-500 mt-0.5">System overview and monitoring</p>
  </div>
</header>

<div class="p-8">
  <%# Quick stats %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5 mb-6">
    <div class="bg-surface-100 rounded-lg p-5">
      <div class="text-xs font-medium text-surface-500 mb-1">Total Users</div>
      <div class="text-2xl font-semibold font-mono text-accent"><%= number_with_delimiter(@users_count) %></div>
    </div>
    <div class="bg-surface-100 rounded-lg p-5">
      <div class="text-xs font-medium text-surface-500 mb-1">Online Now</div>
      <div class="text-2xl font-semibold font-mono text-success"><%= number_with_delimiter(@online_users) %></div>
    </div>
    <div class="bg-surface-100 rounded-lg p-5">
      <div class="text-xs font-medium text-surface-500 mb-1">Services</div>
      <div class="text-2xl font-semibold font-mono text-surface-900"><%= number_with_delimiter(@services_count) %></div>
    </div>
    <div class="bg-surface-100 rounded-lg p-5">
      <div class="text-xs font-medium text-surface-500 mb-1">Domains Tracked</div>
      <div class="text-2xl font-semibold font-mono text-surface-900"><%= number_with_delimiter(@domains_count) %></div>
    </div>
    <div class="bg-surface-100 rounded-lg p-5">
      <div class="text-xs font-medium text-surface-500 mb-1">Version</div>
      <div class="text-lg font-semibold font-mono text-surface-600"><%= PhishDirectory::VERSION %></div>
      <div class="text-xs text-surface-500 font-mono mt-0.5"><%= PhishDirectory::GIT_SHA %></div>
    </div>
  </div>

  <%# Quick Links %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
    <a href="/admin/flipper" class="bg-surface-100 rounded-lg p-5 hover:bg-surface-200/70 transition-colors group">
      <svg class="w-6 h-6 text-surface-400 mb-3 group-hover:text-surface-600 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
      <div class="font-medium text-sm text-surface-800 mb-1">Feature Flags</div>
      <div class="text-xs text-surface-500">Manage Flipper feature toggles</div>
    </a>
    <a href="/admin/jobs" class="bg-surface-100 rounded-lg p-5 hover:bg-surface-200/70 transition-colors group">
      <svg class="w-6 h-6 text-surface-400 mb-3 group-hover:text-surface-600 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
      <div class="font-medium text-sm text-surface-800 mb-1">Background Jobs</div>
      <div class="text-xs text-surface-500">Monitor Solid Queue jobs</div>
    </a>
    <a href="/admin/blazer" class="bg-surface-100 rounded-lg p-5 hover:bg-surface-200/70 transition-colors group">
      <svg class="w-6 h-6 text-surface-400 mb-3 group-hover:text-surface-600 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
      <div class="font-medium text-sm text-surface-800 mb-1">Analytics</div>
      <div class="text-xs text-surface-500">Run SQL queries and view dashboards</div>
    </a>
    <a href="/admin/console_audits" class="bg-surface-100 rounded-lg p-5 hover:bg-surface-200/70 transition-colors group">
      <svg class="w-6 h-6 text-surface-400 mb-3 group-hover:text-surface-600 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      <div class="font-medium text-sm text-surface-800 mb-1">Console Audits</div>
      <div class="text-xs text-surface-500">Review Rails console activity</div>
    </a>
  </div>
</div>
