<% content_for :title, @check.heading %>

<header class="px-6 sm:px-8 py-6 border-b border-surface-200/50 bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <h1 class="text-xl font-semibold text-surface-900"><%= @check.heading %></h1>
  <p class="text-sm text-surface-500 mt-0.5"><%= @check.subheading %></p>
</header>

<div class="p-6 sm:p-8 max-w-3xl">
  <div class="mb-6">
    <%= render "shared/card", title: "#{@check.field_label} lookup" do %>
      <div class="p-5">
        <%= form_with url: send(@check.submit_path_helper), method: :post, class: "flex flex-col sm:flex-row gap-3" do |f| %>
          <div class="flex-1">
            <%# A placeholder is not a label: it disappears the moment someone
                types, and is not reliably announced. %>
            <%= f.label @check.param, @check.field_label, class: "sr-only" %>
            <%= f.text_field @check.param,
                  value: @value,
                  placeholder: @check.placeholder,
                  class: "w-full px-3 py-2.5 bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 placeholder-surface-500 text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 font-mono transition-colors",
                  autocomplete: "off",
                  autocapitalize: "off",
                  spellcheck: "false",
                  autofocus: true %>
          </div>
          <%# Turbo disables the button while the request is in flight, which
              matters here: the check calls external services synchronously. %>
          <%= f.submit @check.submit_label,
                data: { turbo_submits_with: "Checking…" },
                class: "px-5 py-2.5 bg-surface-900 text-surface-0 font-medium text-sm rounded-md hover:bg-surface-800 transition-colors cursor-pointer whitespace-nowrap disabled:opacity-60" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @result.nil? %>
    <%= render "shared/card", title: "Results" do %>
      <%= render "shared/empty_state",
            title: "Enter #{@check.field_label.downcase} to check",
            subtitle: @check.empty_hint,
            icon: :search %>
    <% end %>

  <% elsif @result.failed? %>
    <%# An outage and a genuine no-data answer used to render the same badge. %>
    <%= render "shared/card", title: "Results", meta: @result.value do %>
      <div class="p-5">
        <div class="bg-warning/10 border border-warning/30 rounded-md p-4">
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-warning shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            <div>
              <p class="text-sm font-medium text-surface-800">The check could not be completed</p>
              <p class="text-xs text-surface-600 mt-1">
                We could not reach our threat intelligence sources just now. This is not a verdict:
                it means we do not know. Try again in a moment.
              </p>
            </div>
          </div>
        </div>
      </div>
    <% end %>

  <% else %>
    <%= render "shared/card", title: "Results", meta: @result.value do %>
      <div class="p-5">
        <% if @result.note.present? %>
          <p class="text-xs text-surface-500 bg-surface-200/60 rounded-md px-3 py-2 mb-5"><%= @result.note %></p>
        <% end %>

        <div class="flex flex-wrap items-center gap-4 mb-6">
          <span class="text-xs font-medium text-surface-500 uppercase tracking-wide">Verdict</span>
          <%= render "dashboard/checks/verdict", verdict: @result.verdict %>
          <% unless @result.verdict_known? %>
            <span class="text-xs text-surface-500">No source had anything on this yet</span>
          <% end %>
        </div>

        <dl class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-6">
          <div class="bg-surface-200 rounded-md p-4">
            <dt class="text-xs font-medium text-surface-500 mb-1">Confidence</dt>
            <dd class="text-xl font-semibold font-mono text-surface-900 tabular-nums">
              <%= @result.confidence ? "#{(@result.confidence * 100).round}%" : "--" %>
            </dd>
          </div>
          <div class="bg-surface-200 rounded-md p-4">
            <dt class="text-xs font-medium text-surface-500 mb-1">Last checked</dt>
            <dd class="text-sm font-medium text-surface-900">
              <%= @result.last_checked ? "#{time_ago_in_words(@result.last_checked)} ago" : "Never" %>
            </dd>
          </div>
          <div class="bg-surface-200 rounded-md p-4">
            <dt class="text-xs font-medium text-surface-500 mb-1">First seen</dt>
            <dd class="text-sm font-medium text-surface-900"><%= @result.created_at.strftime("%b %d, %Y") %></dd>
          </div>

          <% @result.details.each do |detail| %>
            <div class="bg-surface-200 rounded-md p-4">
              <dt class="text-xs font-medium text-surface-500 mb-1"><%= detail[:label] %></dt>
              <dd class="text-sm font-medium <%= detail[:tone] ? "text-#{detail[:tone] == :neutral ? "surface-700" : detail[:tone]}" : "text-surface-900" %>">
                <%= detail[:value] %>
              </dd>
            </div>
          <% end %>
        </dl>

        <% if @result.sources.present? %>
          <div class="border-t border-surface-200/50 pt-5">
            <h3 class="text-xs font-medium text-surface-500 uppercase tracking-wide mb-3">Sources</h3>
            <div class="flex flex-wrap gap-2">
              <% @result.sources.each do |source| %>
                <% name = source.is_a?(Hash) ? (source["service"] || source[:service] || source["name"] || source[:name]) : source %>
                <%= render "shared/badge", label: name, tone: :neutral %>
              <% end %>
            </div>
          </div>
        <% end %>

        <div class="border-t border-surface-200/50 pt-5 mt-5">
          <h3 class="text-xs font-medium text-surface-500 uppercase tracking-wide mb-3">Same check via the API</h3>
          <pre class="bg-surface-200 rounded-md p-4 font-mono text-xs overflow-x-auto text-surface-700"><code>curl -X POST https://phish.directory<%= @check.api_path %> \
  -H "Authorization: Bearer YOUR_API_KEY" \
  -H "Content-Type: application/json" \
  -d '{"<%= @check.api_field %>": "<%= @result.value %>"}'</code></pre>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
