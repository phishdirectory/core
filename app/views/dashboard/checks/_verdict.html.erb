<%#
  The verdict pill.

  Each check page had its own copy of this case statement and they had drifted:
  the same "phishing" classification rendered as "Phishing", "Fraudulent" and
  "Scam/Fraud" depending on the page.
%>
<% labels = { "phishing" => "Phishing", "suspicious" => "Suspicious", "clean" => "Clean", "protected" => "Protected" } %>
<% tones = { danger: "bg-danger/10 text-danger", warning: "bg-warning/10 text-warning",
             success: "bg-success/10 text-success", info: "bg-info/10 text-info",
             neutral: "bg-surface-200 text-surface-600" } %>
<% tone = verdict_tone(verdict) %>
<span class="inline-flex items-center px-3 py-1.5 rounded-md text-sm font-medium <%= tones[tone] %>">
  <svg class="w-4 h-4 mr-1.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
    <% if verdict == "clean" %>
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
    <% elsif %w[phishing suspicious].include?(verdict) %>
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
    <% else %>
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
    <% end %>
  </svg>
  <%= labels.fetch(verdict, "Unknown") %>
</span>
