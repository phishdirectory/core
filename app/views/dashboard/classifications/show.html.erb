<% content_for :title, "Classify Item" %>

<% type = @classifiable.is_a?(Phish::Domain) ? "domain" : "url" %>
<% value = @classifiable.is_a?(Phish::Domain) ? @classifiable.domain : @classifiable.url %>

<div data-controller="classification-picker"
     data-classification-picker-taxonomy-value="<%= @taxonomy.to_json %>">

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div>
    <div class="flex items-center gap-2 mb-1">
      <%= link_to dashboard_classifications_path, class: "text-surface-500 hover:text-surface-700 transition-colors" do %>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      <% end %>
      <h1 class="text-xl font-semibold text-surface-900">Classify <%= type.titleize %></h1>
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-500/10 text-amber-600 uppercase tracking-wide">
        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M5 2a1 1 0 011 1v1h1a1 1 0 010 2H6v1a1 1 0 01-2 0V6H3a1 1 0 010-2h1V3a1 1 0 011-1zm0 10a1 1 0 011 1v1h1a1 1 0 110 2H6v1a1 1 0 11-2 0v-1H3a1 1 0 110-2h1v-1a1 1 0 011-1zM12 2a1 1 0 01.967.744L14.146 7.2 17.5 9.134a1 1 0 010 1.732l-3.354 1.935-1.18 4.455a1 1 0 01-1.933 0L9.854 12.8 6.5 10.866a1 1 0 010-1.732l3.354-1.935 1.18-4.455A1 1 0 0112 2z" clip-rule="evenodd"/>
        </svg>
        Trusted
      </span>
    </div>
    <p class="text-sm text-surface-500 mt-0.5 font-mono break-all"><%= value %></p>
  </div>
</header>

<div class="p-8">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <%# Main classification form %>
    <div class="lg:col-span-2">
      <div class="bg-surface-100 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-surface-200/50">
          <h2 class="text-sm font-semibold text-surface-900">Classification Details</h2>
        </div>

        <div class="p-5">
          <%# Item details %>
          <div class="mb-6">
            <div class="flex items-center gap-3 mb-4">
              <span class="inline-flex items-center px-2.5 py-1 rounded text-xs font-medium <%= type == 'domain' ? 'bg-info/10 text-info' : 'bg-warning/10 text-warning' %>">
                <%= type.titleize %>
              </span>
              <% if @classifiable.verdict&.phishing? %>
                <span class="inline-flex items-center px-2.5 py-1 rounded text-xs font-medium bg-danger/10 text-danger">Phishing</span>
              <% elsif @classifiable.verdict&.suspicious? %>
                <span class="inline-flex items-center px-2.5 py-1 rounded text-xs font-medium bg-warning/10 text-warning">Suspicious</span>
              <% end %>
              <% if @classifiable.verdict&.confidence_score %>
                <span class="text-xs text-surface-500">
                  <%= (@classifiable.verdict.confidence_score * 100).round %>% confidence
                </span>
              <% end %>
            </div>

            <div class="bg-surface-200/50 rounded-md p-4 font-mono text-sm break-all">
              <%= value %>
            </div>
          </div>

          <%# Mark as clean option for suspicious items %>
          <% if @classifiable.verdict&.suspicious? %>
            <div class="mb-6 p-4 bg-success/5 border border-success/20 rounded-md">
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-success mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <div class="flex-1">
                  <div class="text-sm font-medium text-surface-800 mb-1">This item is suspicious</div>
                  <p class="text-xs text-surface-600 mb-3">If you believe this is actually a legitimate site, you can mark it as clean instead of classifying it.</p>
                  <div class="flex items-center gap-2">
                    <%= button_to "Mark Clean & Next", dashboard_mark_clean_classification_path(type: type, id: @classifiable.public_id, commit: "next"),
                        method: :post,
                        class: "px-3 py-1.5 bg-success text-white text-xs font-medium rounded-md hover:bg-success/90 transition-colors",
                        data: { turbo_confirm: "Are you sure this is a legitimate site? This will skip scam classification." } %>
                    <%= button_to "Mark Clean & Finish", dashboard_mark_clean_classification_path(type: type, id: @classifiable.public_id, commit: "finish"),
                        method: :post,
                        class: "px-3 py-1.5 bg-success/20 text-success text-xs font-medium rounded-md hover:bg-success/30 transition-colors",
                        data: { turbo_confirm: "Are you sure this is a legitimate site? This will skip scam classification." } %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <%# Classification form %>
          <%= form_tag dashboard_create_classification_path(type: type, id: @classifiable.public_id), method: :post, class: "space-y-5" do %>
            <div>
              <label for="scam_category" class="block text-sm font-medium text-surface-700 mb-2">Scam Category *</label>
              <select name="scam_category" id="scam_category" required
                      class="w-full px-3 py-2 border border-surface-200/50 rounded-md text-sm bg-surface-50 text-surface-900 focus:ring-2 focus:ring-surface-400 focus:border-surface-400 outline-none"
                      data-classification-picker-target="category"
                      data-action="classification-picker#filterSubcategories">
                <option value="">Select a category...</option>
                <% @taxonomy.each do |category| %>
                  <option value="<%= category[:value] %>"><%= category[:label] %></option>
                <% end %>
              </select>
            </div>

            <div>
              <label for="scam_subcategory" class="block text-sm font-medium text-surface-700 mb-2">Subcategory</label>
              <select name="scam_subcategory" id="scam_subcategory"
                      data-classification-picker-target="subcategory"
                      class="w-full px-3 py-2 border border-surface-200/50 rounded-md text-sm bg-surface-50 text-surface-900 focus:ring-2 focus:ring-surface-400 focus:border-surface-400 outline-none">
                <option value="">Select a subcategory (optional)...</option>
                <%# Subcategories will be populated by JavaScript based on category selection %>
                <% @taxonomy.each do |category| %>
                  <% category[:subcategories].each do |sub| %>
                    <option value="<%= sub[:value] %>" data-category="<%= category[:value] %>" class="hidden">
                      <%= sub[:label] %>
                    </option>
                  <% end %>
                <% end %>
              </select>
            </div>

            <div>
              <label for="notes" class="block text-sm font-medium text-surface-700 mb-2">Notes</label>
              <textarea name="notes" id="notes" rows="3"
                        data-classification-picker-target="notes"
                        placeholder="Optional notes about this classification..."
                        class="w-full px-3 py-2 border border-surface-200/50 rounded-md text-sm bg-surface-50 text-surface-900 placeholder-surface-500 focus:ring-2 focus:ring-surface-400 focus:border-surface-400 outline-none"></textarea>
            </div>

            <div class="flex items-center gap-3 pt-2">
              <button type="submit" name="commit" value="next" class="px-4 py-2 bg-surface-900 text-surface-0 text-sm font-medium rounded-md hover:bg-surface-800 transition-colors">
                Classify & Next
              </button>
              <button type="submit" name="commit" value="finish" class="px-4 py-2 bg-surface-200 text-surface-700 text-sm font-medium rounded-md hover:bg-surface-300 transition-colors">
                Classify & Finish
              </button>
            </div>
          <% end %>

          <%= button_to "Skip", dashboard_skip_classification_path(type: type, id: @classifiable.public_id),
              method: :post,
              class: "mt-3 px-4 py-2 text-surface-500 text-sm font-medium hover:text-surface-700 transition-colors" %>
        </div>
      </div>
    </div>

    <%# Sidebar with category reference (clickable for modal) %>
    <div>
      <div class="bg-surface-100 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-surface-200/50">
          <h2 class="text-sm font-semibold text-surface-900">Category Reference</h2>
          <p class="text-xs text-surface-500 mt-1">Click a category for details</p>
        </div>
        <div class="px-5 py-3 max-h-96 overflow-y-auto">
          <ul class="text-xs space-y-1">
            <% @taxonomy.each do |category| %>
              <li>
                <button type="button"
                        data-action="classification-picker#openCategory"
                        data-classification-picker-category-param="<%= category[:value] %>"
                        class="w-full text-left px-2 py-1.5 rounded hover:bg-surface-200/50 transition-colors group">
                  <span class="font-medium text-surface-700 group-hover:text-surface-900"><%= category[:label] %></span>
                  <span class="text-surface-400 ml-1">(<%= category[:subcategories].count %>)</span>
                  <svg class="w-3 h-3 inline-block ml-1 text-surface-400 group-hover:text-surface-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </button>
              </li>
            <% end %>
          </ul>
        </div>
      </div>

      <%# Quick tips %>
      <div class="bg-surface-100 rounded-lg overflow-hidden mt-4">
        <div class="px-5 py-4 border-b border-surface-200/50">
          <h2 class="text-sm font-semibold text-surface-900">Quick Tips</h2>
        </div>
        <div class="px-5 py-3">
          <ul class="text-xs text-surface-600 space-y-2">
            <li class="flex items-start gap-2">
              <svg class="w-3 h-3 mt-0.5 text-surface-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span>Choose the most specific category that applies</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-3 h-3 mt-0.5 text-surface-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span>If unsure, skip and return later</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-3 h-3 mt-0.5 text-surface-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span>Add notes for edge cases</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<%# Category Documentation Modal %>
<div data-classification-picker-target="modal" class="fixed inset-0 z-[100] hidden" aria-modal="true" role="dialog" aria-labelledby="modal-title" aria-hidden="true">
  <%# Backdrop %>
  <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" data-action="click->classification-picker#close"></div>

  <%# Modal %>
  <div class="absolute inset-0 flex items-start justify-center pt-[12vh] px-4">
    <div data-classification-picker-target="modalContainer" class="w-full max-w-lg bg-surface-100 rounded-lg shadow-2xl overflow-hidden transform scale-95 opacity-0 transition-all duration-150 flex flex-col max-h-[75vh]">
      <%# Header %>
      <div class="px-4 py-3 border-b border-surface-200/50 flex items-center justify-between flex-shrink-0">
        <h3 id="modal-title" data-classification-picker-target="modalTitle" class="text-sm font-semibold text-surface-900">Category Details</h3>
        <button type="button" data-action="classification-picker#close" class="text-surface-400 hover:text-surface-600 transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <%# Body %>
      <div class="p-4 overflow-y-auto flex-1">
        <p data-classification-picker-target="modalDescription" class="text-sm text-surface-600 mb-4"></p>

        <div class="flex items-center justify-between mb-2">
          <div class="text-[10px] font-semibold text-surface-500 uppercase tracking-wider">Subcategories</div>
          <div class="text-[10px] text-surface-400 flex items-center gap-1">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"/>
            </svg>
            Click to select
          </div>
        </div>
        <div data-classification-picker-target="modalSubcategories" class="space-y-1.5">
          <%# Populated by JavaScript %>
        </div>
      </div>

      <%# Footer %>
      <div class="px-4 py-2.5 border-t border-surface-200/50 flex items-center justify-between text-[10px] text-surface-500 flex-shrink-0">
        <span>Press <kbd class="px-1 py-0.5 bg-surface-200 rounded text-surface-600">esc</kbd> to close</span>
        <button type="button" data-action="classification-picker#close" class="px-3 py-1.5 bg-surface-200 text-surface-700 text-xs font-medium rounded hover:bg-surface-300 transition-colors">
          Close
        </button>
      </div>
    </div>
  </div>
</div>
</div>
