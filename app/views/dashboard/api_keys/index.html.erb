<% content_for :title, "API Keys" %>

<header class="px-10 py-6 border-b border-slate-700/20 flex items-center justify-between bg-pd-secondary sticky top-0 z-40">
  <div>
    <h1 class="text-2xl font-bold text-slate-100">API Keys</h1>
    <p class="text-sm text-slate-500 mt-1">Manage your API keys for authentication</p>
  </div>
</header>

<div class="p-8 px-10">
  <% if flash[:api_key] %>
    <div class="bg-pd-tertiary border-2 border-cyan-accent rounded-2xl p-6 mb-6 animate-pulse-glow" id="new-api-key-reveal">
      <div class="flex items-start justify-between gap-4 mb-4">
        <div>
          <div class="text-xs font-bold text-cyan-accent uppercase tracking-widest mb-1">Your New API Key</div>
          <div class="text-sm text-slate-400">Copy this key now - it won't be shown again!</div>
        </div>
        <button id="copy-key-btn" class="px-4 py-2 bg-cyan-accent text-pd-primary font-semibold text-sm rounded-lg hover:shadow-[0_0_15px_rgba(63,196,224,0.4)] transition-all">
          Copy Key
        </button>
      </div>
      <div class="bg-pd-primary rounded-xl p-4 font-mono text-base text-slate-100 break-all select-all" id="api-key-value">
        <%= flash[:api_key] %>
      </div>
    </div>
    <script>
      document.getElementById('copy-key-btn').addEventListener('click', function() {
        const key = document.getElementById('api-key-value').textContent.trim();
        const btn = this;
        navigator.clipboard.writeText(key).then(function() {
          btn.textContent = 'Copied!';
          btn.style.backgroundColor = '#10b981';
          setTimeout(function() {
            btn.textContent = 'Copy Key';
            btn.style.backgroundColor = '';
          }, 2000);
        }).catch(function() {
          // Fallback for older browsers
          const textarea = document.createElement('textarea');
          textarea.value = key;
          document.body.appendChild(textarea);
          textarea.select();
          document.execCommand('copy');
          document.body.removeChild(textarea);
          btn.textContent = 'Copied!';
          btn.style.backgroundColor = '#10b981';
          setTimeout(function() {
            btn.textContent = 'Copy Key';
            btn.style.backgroundColor = '';
          }, 2000);
        });
      });
      // Auto-scroll to show the key
      document.getElementById('new-api-key-reveal').scrollIntoView({ behavior: 'smooth', block: 'center' });
    </script>
  <% end %>

  <%# Create new key form %>
  <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl overflow-hidden mb-6">
    <div class="px-6 py-5 border-b border-slate-700/20">
      <h2 class="text-lg font-semibold text-slate-100">Create New Key</h2>
    </div>
    <div class="p-6">
      <%= form_with url: dashboard_api_keys_path, method: :post do |f| %>
        <div class="flex flex-wrap gap-4 items-end">
          <div class="flex-1 min-w-[200px]">
            <label for="api_key_name" class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Key Name</label>
            <%= text_field_tag "api_key[name]", nil,
              class: "w-full px-4 py-3 bg-pd-primary border border-slate-600/40 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-accent focus:ring-2 focus:ring-cyan-accent/20 transition-all",
              placeholder: "e.g., Production API",
              required: true,
              id: "api_key_name" %>
          </div>
          <div>
            <label for="api_key_expires_at" class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Expires (optional)</label>
            <%= date_field_tag "api_key[expires_at]", nil,
              class: "px-4 py-3 bg-pd-primary border border-slate-600/40 rounded-xl text-slate-100 focus:outline-none focus:border-cyan-accent focus:ring-2 focus:ring-cyan-accent/20 transition-all w-[180px]",
              id: "api_key_expires_at",
              min: Date.tomorrow.to_s %>
          </div>
          <%= submit_tag "Create Key", class: "px-5 py-3 bg-cyan-accent text-pd-primary font-semibold rounded-xl hover:shadow-[0_0_20px_rgba(63,196,224,0.4)] hover:-translate-y-0.5 transition-all cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>

  <%# API Keys list %>
  <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl overflow-hidden mb-6">
    <div class="px-6 py-5 border-b border-slate-700/20 flex items-center justify-between">
      <h2 class="text-lg font-semibold text-slate-100">Your API Keys</h2>
      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-slate-600/30 text-slate-400"><%= @api_keys.count %> keys</span>
    </div>

    <% if @api_keys.any? %>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Name</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Key</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Status</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Last Used</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Expires</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @api_keys.each do |key| %>
              <tr class="hover:bg-pd-tertiary transition-colors">
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <span class="font-semibold text-slate-100"><%= key.name %></span>
                  <div class="text-xs text-slate-500 mt-1">Created <%= key.created_at.strftime("%b %d, %Y") %></div>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <code class="font-mono text-sm text-slate-400 bg-pd-primary px-2 py-1 rounded-lg">pdat_****<%= key.key_digest.last(8) %></code>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <% if key.usable? %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-emerald-500/15 text-emerald-500">Active</span>
                  <% elsif key.expired? %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-amber-500/15 text-amber-500">Expired</span>
                  <% else %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-red-500/15 text-red-500">Revoked</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20 text-slate-400 text-sm">
                  <%= key.last_used_at ? time_ago_in_words(key.last_used_at) + " ago" : "Never" %>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20 text-sm">
                  <% if key.expires_at %>
                    <% if key.expired? %>
                      <span class="text-red-400"><%= key.expires_at.strftime("%b %d, %Y") %></span>
                    <% else %>
                      <span class="text-slate-400"><%= key.expires_at.strftime("%b %d, %Y") %></span>
                    <% end %>
                  <% else %>
                    <span class="text-slate-500">Never</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <div class="flex gap-2">
                    <% if key.usable? %>
                      <%= button_to "Regenerate", regenerate_dashboard_api_key_path(key), method: :post, class: "px-3 py-1.5 text-xs font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-lg hover:bg-pd-hover transition-all cursor-pointer", data: { confirm: "This will revoke the current key and create a new one. Continue?" } %>
                    <% end %>
                    <%= button_to "Delete", dashboard_api_key_path(key), method: :delete, class: "px-3 py-1.5 text-xs font-medium text-red-400 bg-red-500/15 border border-red-500/30 rounded-lg hover:bg-red-500/25 transition-all cursor-pointer", data: { confirm: "Are you sure? This cannot be undone." } %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-16 text-slate-500">
        <div class="text-5xl mb-4 opacity-50">&#9829;</div>
        <div class="text-lg font-semibold text-slate-400 mb-2">No API keys yet</div>
        <p class="text-slate-500">Create your first API key above to start making requests</p>
      </div>
    <% end %>
  </div>

  <%# Usage info %>
  <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-700/20">
      <h2 class="text-lg font-semibold text-slate-100">Using Your API Key</h2>
    </div>
    <div class="p-6">
      <p class="text-slate-400 mb-4">
        Include your API key in the <code class="font-mono text-cyan-accent">Authorization</code> header:
      </p>
      <div class="bg-pd-primary rounded-xl p-4 font-mono text-sm">
        <span class="text-slate-500">Authorization:</span>
        <span class="text-cyan-accent"> Bearer pdat_your_api_key_here</span>
      </div>
      <p class="text-slate-500 text-sm mt-3">
        Alternatively, you can use the <code class="font-mono text-slate-400">X-API-Key</code> header.
      </p>
    </div>
  </div>
</div>
