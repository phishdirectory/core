<% content_for :title, "Dashboard" %>

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div>
    <h1 class="text-xl font-semibold text-surface-900">Dashboard</h1>
    <p class="text-sm text-surface-500 mt-0.5">Welcome back, <%= current_user.first_name %></p>
  </div>
</header>

<div class="p-8">
  <%# Quick stats %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="bg-surface-100 rounded-lg p-5">
      <div class="text-xs font-medium text-surface-500 uppercase tracking-wide mb-1">API Keys</div>
      <div class="text-2xl font-semibold font-mono text-surface-900"><%= current_user.user_api_keys.active.count %></div>
    </div>
    <div class="bg-surface-100 rounded-lg p-5">
      <div class="text-xs font-medium text-surface-500 uppercase tracking-wide mb-1">Active Sessions</div>
      <div class="text-2xl font-semibold font-mono text-surface-900"><%= current_user.user_sessions.active.count %></div>
    </div>
    <div class="bg-surface-100 rounded-lg p-5">
      <div class="text-xs font-medium text-surface-500 uppercase tracking-wide mb-1">Account Status</div>
      <div class="mt-1.5">
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-success/10 text-success"><%= current_user.status.titleize %></span>
      </div>
    </div>
    <div class="bg-surface-100 rounded-lg p-5">
      <div class="text-xs font-medium text-surface-500 uppercase tracking-wide mb-1">Access Level</div>
      <div class="mt-1.5">
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-info/10 text-info"><%= current_user.access_level.titleize %></span>
      </div>
    </div>
  </div>

  <%# Recent API Keys %>
  <div class="bg-surface-100 rounded-lg overflow-hidden mb-6">
    <div class="px-5 py-4 flex items-center justify-between">
      <h2 class="text-sm font-semibold text-surface-900">API Keys</h2>
      <%= link_to "Manage", dashboard_api_keys_path, class: "text-xs font-medium text-surface-500 hover:text-surface-700 transition-colors" %>
    </div>

    <% if @api_keys.any? %>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-t border-surface-200/50">
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Name</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Status</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Last Used</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Created</th>
            </tr>
          </thead>
          <tbody>
            <% @api_keys.each do |key| %>
              <tr class="border-t border-surface-200/50 hover:bg-surface-200/30 transition-colors">
                <td class="px-5 py-3">
                  <span class="font-medium text-sm text-surface-800"><%= key.name %></span>
                  <div class="text-xs text-surface-500 font-mono mt-0.5">pdat_****<%= key.key_digest.last(8) %></div>
                </td>
                <td class="px-5 py-3">
                  <% if key.usable? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-success/10 text-success">Active</span>
                  <% elsif key.expired? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-warning/10 text-warning">Expired</span>
                  <% else %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-danger/10 text-danger">Revoked</span>
                  <% end %>
                </td>
                <td class="px-5 py-3 text-surface-600 text-sm">
                  <%= key.last_used_at ? time_ago_in_words(key.last_used_at) + " ago" : "Never" %>
                </td>
                <td class="px-5 py-3 text-surface-600 text-sm">
                  <%= key.created_at.strftime("%b %d, %Y") %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-12 border-t border-surface-200/50">
        <svg class="w-10 h-10 mx-auto text-surface-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
        <div class="text-sm font-medium text-surface-600 mb-1">No API keys yet</div>
        <p class="text-xs text-surface-500 mb-4">Create your first API key to start making requests</p>
        <%= link_to "Create API Key", dashboard_api_keys_path, class: "px-4 py-2 bg-surface-900 text-surface-0 text-sm font-medium rounded-md hover:bg-surface-800 transition-colors inline-block" %>
      </div>
    <% end %>
  </div>

  <%# Recent Sessions %>
  <div class="bg-surface-100 rounded-lg overflow-hidden mb-6">
    <div class="px-5 py-4 flex items-center justify-between">
      <h2 class="text-sm font-semibold text-surface-900">Recent Sessions</h2>
      <%= link_to "View all", dashboard_sessions_path, class: "text-xs font-medium text-surface-500 hover:text-surface-700 transition-colors" %>
    </div>

    <% if @recent_sessions.any? %>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-t border-surface-200/50">
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Device</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Location</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Last Active</th>
              <th class="px-5 py-2.5 text-left text-xs font-medium text-surface-500">Status</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_sessions.each do |session| %>
              <tr class="border-t border-surface-200/50 hover:bg-surface-200/30 transition-colors">
                <td class="px-5 py-3">
                  <span class="font-medium text-sm text-surface-800"><%= session.device_info&.truncate(40) || "Unknown device" %></span>
                  <div class="text-xs text-surface-500 mt-0.5"><%= session.ip || "Unknown IP" %></div>
                </td>
                <td class="px-5 py-3 text-surface-600 text-sm">
                  <% if session.latitude && session.longitude %>
                    <%= session.latitude.round(2) %>, <%= session.longitude.round(2) %>
                  <% else %>
                    Unknown
                  <% end %>
                </td>
                <td class="px-5 py-3 text-surface-600 text-sm">
                  <%= session.last_seen_at ? time_ago_in_words(session.last_seen_at) + " ago" : "Just now" %>
                </td>
                <td class="px-5 py-3">
                  <% if session == current_session %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-success/10 text-success">Current</span>
                  <% elsif session.active? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-info/10 text-info">Active</span>
                  <% else %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-surface-300 text-surface-600">Expired</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-12 border-t border-surface-200/50">
        <svg class="w-10 h-10 mx-auto text-surface-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        <div class="text-sm font-medium text-surface-600 mb-1">No sessions</div>
        <p class="text-xs text-surface-500">Your session history will appear here</p>
      </div>
    <% end %>
  </div>

  <%# Quick start guide %>
  <div class="bg-surface-100 rounded-lg overflow-hidden">
    <div class="px-5 py-4">
      <h2 class="text-sm font-semibold text-surface-900">Quick Start</h2>
    </div>
    <div class="px-5 pb-5 border-t border-surface-200/50 pt-4">
      <p class="text-sm text-surface-600 mb-4">
        Use your API key to check domains and URLs for phishing threats:
      </p>
      <div class="bg-surface-200 rounded-md p-4 font-mono text-xs overflow-x-auto">
        <div class="text-surface-500 mb-2"># Check a domain</div>
        <div class="text-surface-700">
          curl -X POST https://phish.directory/api/v1/domain/check \<br>
          <span class="pl-4">-H "Authorization: Bearer YOUR_API_KEY" \</span><br>
          <span class="pl-4">-H "Content-Type: application/json" \</span><br>
          <span class="pl-4">-d '{"domain": "example.com"}'</span>
        </div>
      </div>
      <div class="mt-4">
        <a href="/docs" class="text-sm font-medium text-surface-600 hover:text-surface-800 transition-colors">
          View documentation &rarr;
        </a>
      </div>
    </div>
  </div>
</div>
