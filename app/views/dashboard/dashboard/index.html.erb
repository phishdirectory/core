<% content_for :title, "Dashboard" %>

<header class="px-10 py-6 border-b border-slate-700/20 flex items-center justify-between bg-pd-secondary sticky top-0 z-40">
  <div>
    <h1 class="text-2xl font-bold text-slate-100">Dashboard</h1>
    <p class="text-sm text-slate-500 mt-1">Welcome back, <%= current_user.first_name %></p>
  </div>
</header>

<div class="p-8 px-10">
  <%# Quick stats %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl p-6">
      <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-2">API Keys</div>
      <div class="text-3xl font-bold font-mono text-cyan-accent"><%= current_user.user_api_keys.active.count %></div>
    </div>
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl p-6">
      <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-2">Active Sessions</div>
      <div class="text-3xl font-bold font-mono text-slate-100"><%= current_user.user_sessions.active.count %></div>
    </div>
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl p-6">
      <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-2">Account Status</div>
      <div class="mt-1">
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-emerald-500/15 text-emerald-500"><%= current_user.status.titleize %></span>
      </div>
    </div>
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl p-6">
      <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-2">Access Level</div>
      <div class="mt-1">
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-blue-500/15 text-blue-400"><%= current_user.access_level.titleize %></span>
      </div>
    </div>
  </div>

  <%# Recent API Keys %>
  <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl overflow-hidden mb-6">
    <div class="px-6 py-5 border-b border-slate-700/20 flex items-center justify-between">
      <h2 class="text-lg font-semibold text-slate-100">Recent API Keys</h2>
      <%= link_to "Manage all", dashboard_api_keys_path, class: "px-4 py-2 text-sm font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-xl hover:bg-pd-hover hover:border-slate-600/50 transition-all" %>
    </div>

    <% if @api_keys.any? %>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Name</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Status</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Last Used</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Created</th>
            </tr>
          </thead>
          <tbody>
            <% @api_keys.each do |key| %>
              <tr class="hover:bg-pd-tertiary transition-colors">
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <span class="font-semibold text-slate-100"><%= key.name %></span>
                  <div class="text-xs text-slate-500 font-mono mt-1">pdat_****<%= key.key_digest.last(8) %></div>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <% if key.usable? %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-emerald-500/15 text-emerald-500">Active</span>
                  <% elsif key.expired? %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-amber-500/15 text-amber-500">Expired</span>
                  <% else %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-red-500/15 text-red-500">Revoked</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20 text-slate-400 text-sm">
                  <%= key.last_used_at ? time_ago_in_words(key.last_used_at) + " ago" : "Never" %>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20 text-slate-400 text-sm">
                  <%= key.created_at.strftime("%b %d, %Y") %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-16 text-slate-500">
        <div class="text-5xl mb-4 opacity-50">&#9829;</div>
        <div class="text-lg font-semibold text-slate-400 mb-2">No API keys yet</div>
        <p class="text-slate-500 mb-4">Create your first API key to start making requests</p>
        <%= link_to "Create API Key", dashboard_api_keys_path, class: "px-5 py-2.5 bg-cyan-accent text-pd-primary font-semibold rounded-xl hover:shadow-[0_0_20px_rgba(63,196,224,0.4)] transition-all" %>
      </div>
    <% end %>
  </div>

  <%# Recent Sessions %>
  <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl overflow-hidden mb-6">
    <div class="px-6 py-5 border-b border-slate-700/20 flex items-center justify-between">
      <h2 class="text-lg font-semibold text-slate-100">Recent Sessions</h2>
      <%= link_to "View all", dashboard_sessions_path, class: "px-4 py-2 text-sm font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-xl hover:bg-pd-hover hover:border-slate-600/50 transition-all" %>
    </div>

    <% if @recent_sessions.any? %>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Device</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Location</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Last Active</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-widest border-b border-slate-700/20">Status</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_sessions.each do |session| %>
              <tr class="hover:bg-pd-tertiary transition-colors">
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <span class="font-semibold text-slate-100"><%= session.device_info&.truncate(40) || "Unknown device" %></span>
                  <div class="text-xs text-slate-500 mt-1"><%= session.ip || "Unknown IP" %></div>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20 text-slate-400 text-sm">
                  <% if session.latitude && session.longitude %>
                    <%= session.latitude.round(2) %>, <%= session.longitude.round(2) %>
                  <% else %>
                    Unknown
                  <% end %>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20 text-slate-400 text-sm">
                  <%= session.last_seen_at ? time_ago_in_words(session.last_seen_at) + " ago" : "Just now" %>
                </td>
                <td class="px-6 py-4 border-b border-slate-700/20">
                  <% if session == current_session %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-emerald-500/15 text-emerald-500">Current</span>
                  <% elsif session.active? %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-blue-500/15 text-blue-400">Active</span>
                  <% else %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-slate-600/30 text-slate-400">Expired</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-16 text-slate-500">
        <div class="text-5xl mb-4 opacity-50">&#9788;</div>
        <div class="text-lg font-semibold text-slate-400 mb-2">No sessions</div>
        <p class="text-slate-500">Your session history will appear here</p>
      </div>
    <% end %>
  </div>

  <%# Quick start guide %>
  <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-700/20">
      <h2 class="text-lg font-semibold text-slate-100">Quick Start</h2>
    </div>
    <div class="p-6">
      <p class="text-slate-400 mb-4">
        Use your API key to check domains and URLs for phishing threats:
      </p>
      <div class="bg-pd-primary rounded-xl p-4 font-mono text-sm overflow-x-auto">
        <div class="text-slate-500"># Check a domain</div>
        <div class="text-slate-100 mt-2">
          curl -X POST https://api.phish.directory/v1/domain/check \<br>
          <span class="pl-4">-H "Authorization: Bearer YOUR_API_KEY" \</span><br>
          <span class="pl-4">-H "Content-Type: application/json" \</span><br>
          <span class="pl-4">-d '{"domain": "example.com"}'</span>
        </div>
      </div>
      <div class="mt-4">
        <a href="https://docs.phish.directory" class="px-4 py-2 text-sm font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-xl hover:bg-pd-hover hover:border-slate-600/50 transition-all inline-block">
          View full documentation
        </a>
      </div>
    </div>
  </div>
</div>
