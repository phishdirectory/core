<% content_for :title, "Check Domain" %>

<header class="px-10 py-6 border-b border-slate-700/20 flex items-center justify-between bg-pd-secondary sticky top-0 z-40">
  <div>
    <h1 class="text-2xl font-bold text-slate-100">Check Domain</h1>
    <p class="text-sm text-slate-500 mt-1">Analyze domains for phishing threats</p>
  </div>
</header>

<div class="p-8 px-10">
  <%# Domain check form %>
  <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl overflow-hidden mb-6">
    <div class="px-6 py-5 border-b border-slate-700/20">
      <h2 class="text-lg font-semibold text-slate-100">Domain Lookup</h2>
    </div>
    <div class="p-6">
      <%= form_with url: dashboard_domain_check_path, method: :post, local: true, class: "flex gap-4" do |f| %>
        <div class="flex-1">
          <%= f.text_field :domain,
            value: @domain,
            placeholder: "Enter a domain (e.g., example.com)",
            class: "w-full px-4 py-3 bg-pd-primary border border-slate-700/30 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-accent/50 focus:ring-1 focus:ring-cyan-accent/30 font-mono text-sm",
            autocomplete: "off",
            autofocus: true %>
        </div>
        <%= f.submit "Check Domain",
          class: "px-6 py-3 bg-cyan-accent text-pd-primary font-semibold rounded-xl hover:shadow-[0_0_20px_rgba(63,196,224,0.4)] transition-all cursor-pointer" %>
      <% end %>
    </div>
  </div>

  <% if @result %>
    <%# Results %>
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl overflow-hidden">
      <div class="px-6 py-5 border-b border-slate-700/20 flex items-center justify-between">
        <h2 class="text-lg font-semibold text-slate-100">Results</h2>
        <span class="font-mono text-sm text-slate-400"><%= @result[:domain] %></span>
      </div>
      <div class="p-6">
        <%# Verdict badge %>
        <div class="flex items-center gap-4 mb-6">
          <div class="text-sm font-semibold text-slate-500 uppercase tracking-widest">Verdict</div>
          <% verdict = @result[:verdict] %>
          <% case verdict %>
          <% when "phishing" %>
            <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-bold font-mono uppercase tracking-wide bg-red-500/15 text-red-500 border border-red-500/30">
              <span class="mr-2">&#9888;</span> Phishing
            </span>
          <% when "suspicious" %>
            <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-bold font-mono uppercase tracking-wide bg-amber-500/15 text-amber-500 border border-amber-500/30">
              <span class="mr-2">&#9888;</span> Suspicious
            </span>
          <% when "clean" %>
            <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-bold font-mono uppercase tracking-wide bg-emerald-500/15 text-emerald-500 border border-emerald-500/30">
              <span class="mr-2">&#10003;</span> Clean
            </span>
          <% else %>
            <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-bold font-mono uppercase tracking-wide bg-slate-600/30 text-slate-400 border border-slate-600/30">
              <span class="mr-2">?</span> Unknown
            </span>
            <span class="text-xs text-slate-500 ml-3">No threat intelligence sources returned results</span>
          <% end %>
        </div>

        <%# Details grid %>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
          <div class="bg-pd-primary rounded-xl p-4">
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-1">Confidence</div>
            <div class="text-2xl font-bold font-mono text-slate-100">
              <% if @result[:confidence] %>
                <%= (@result[:confidence] * 100).round %>%
              <% else %>
                --
              <% end %>
            </div>
          </div>
          <div class="bg-pd-primary rounded-xl p-4">
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-1">Last Checked</div>
            <div class="text-sm font-medium text-slate-100">
              <% if @result[:last_checked] %>
                <%= time_ago_in_words(@result[:last_checked]) %> ago
              <% else %>
                Never
              <% end %>
            </div>
          </div>
          <div class="bg-pd-primary rounded-xl p-4">
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-1">First Seen</div>
            <div class="text-sm font-medium text-slate-100">
              <%= @result[:created_at].strftime("%b %d, %Y") %>
            </div>
          </div>
        </div>

        <% if @result[:sources].present? %>
          <%# Sources %>
          <div class="border-t border-slate-700/20 pt-6">
            <div class="text-sm font-semibold text-slate-500 uppercase tracking-widest mb-3">Sources</div>
            <div class="flex flex-wrap gap-2">
              <% @result[:sources].each do |source| %>
                <% source_name = source.is_a?(Hash) ? (source["name"] || source[:name]) : source %>
                <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-medium font-mono bg-pd-primary border border-slate-700/30 text-slate-400">
                  <%= source_name %>
                </span>
              <% end %>
            </div>
          </div>
        <% end %>

        <%# API usage hint %>
        <div class="border-t border-slate-700/20 pt-6 mt-6">
          <div class="text-sm font-semibold text-slate-500 uppercase tracking-widest mb-3">API Usage</div>
          <div class="bg-pd-primary rounded-xl p-4 font-mono text-sm overflow-x-auto">
            <div class="text-slate-500"># Check this domain via API</div>
            <div class="text-slate-100 mt-2">
              curl -X POST https://phish.directory/api/v1/domain/check \<br>
              <span class="pl-4">-H "Authorization: Bearer YOUR_API_KEY" \</span><br>
              <span class="pl-4">-H "Content-Type: application/json" \</span><br>
              <span class="pl-4">-d '{"domain": "<%= @result[:domain] %>"}'</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <%# Empty state %>
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl overflow-hidden">
      <div class="text-center py-16">
        <div class="text-5xl mb-4 opacity-50">&#128269;</div>
        <div class="text-lg font-semibold text-slate-400 mb-2">Enter a domain to check</div>
        <p class="text-slate-500 max-w-md mx-auto">
          We'll analyze it against multiple threat intelligence sources including Google Safe Browsing, VirusTotal, URLScan, and more.
        </p>
      </div>
    </div>
  <% end %>
</div>
