<% content_for :title, "Profile" %>

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div>
    <h1 class="text-xl font-semibold text-surface-900">Profile</h1>
    <p class="text-sm text-surface-500 mt-0.5">Your account information</p>
  </div>
  <%= link_to "Edit Profile", edit_dashboard_profile_path, class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-100 rounded-md hover:bg-surface-200 transition-colors" %>
</header>

<div class="p-8">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <%# Profile info card %>
    <div class="bg-surface-100 rounded-lg overflow-hidden">
      <div class="px-5 py-4 border-b border-surface-200/50">
        <h2 class="text-sm font-semibold text-surface-900">Account Details</h2>
      </div>
      <div class="p-5">
        <div class="flex items-center gap-4 mb-5">
          <div class="w-16 h-16 bg-surface-200 rounded-full flex items-center justify-center font-semibold text-xl text-surface-600">
            <% if @user.has_profile_photo? %>
              <%= image_tag @user.profile_photo_url(variant: :medium), class: "w-full h-full object-cover rounded-full" %>
            <% else %>
              <%= @user.initials %>
            <% end %>
          </div>
          <div>
            <div class="text-lg font-semibold text-surface-900"><%= @user.full_name %></div>
            <div class="text-sm text-surface-500">@<%= @user.username %></div>
          </div>
        </div>

        <div class="space-y-4">
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Email</div>
            <div class="text-sm text-surface-700 flex items-center gap-2">
              <%= @user.email %>
              <% if @user.email_verified? %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-success/10 text-success">Verified</span>
              <% else %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-warning/10 text-warning">Unverified</span>
              <% end %>
            </div>
          </div>

          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">User ID</div>
            <div class="font-mono text-sm text-surface-600"><%= @user.pd_id %></div>
          </div>

          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Member Since</div>
            <div class="text-sm text-surface-600"><%= @user.created_at.strftime("%B %d, %Y") %></div>
          </div>
        </div>
      </div>
    </div>

    <%# Account status card %>
    <div class="bg-surface-100 rounded-lg overflow-hidden">
      <div class="px-5 py-4 border-b border-surface-200/50">
        <h2 class="text-sm font-semibold text-surface-900">Account Status</h2>
      </div>
      <div class="p-5">
        <div class="space-y-4">
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Status</div>
            <div>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= @user.active? ? 'bg-success/10 text-success' : 'bg-warning/10 text-warning' %>"><%= @user.status.titleize %></span>
            </div>
          </div>

          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Access Level</div>
            <div>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-info/10 text-info"><%= @user.access_level.titleize %></span>
            </div>
          </div>

          <% if @user.staff? %>
          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Staff Status</div>
            <div>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-info/10 text-info">Staff Member</span>
            </div>
          </div>
          <% end %>

          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Last Active</div>
            <div class="text-sm text-surface-600">
              <%= @user.last_seen_at ? time_ago_in_words(@user.last_seen_at) + " ago" : "Just now" %>
            </div>
          </div>

          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">Active Sessions</div>
            <div class="text-sm text-surface-600"><%= @user.user_sessions.active.count %></div>
          </div>

          <div>
            <div class="text-xs font-medium text-surface-500 mb-1">API Keys</div>
            <div class="text-sm text-surface-600"><%= @user.user_api_keys.active.count %> active</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
