<% content_for :title, "Profile" %>

<header class="px-10 py-6 border-b border-slate-700/20 flex items-center justify-between bg-pd-secondary sticky top-0 z-40">
  <div>
    <h1 class="text-2xl font-bold text-slate-100">Profile</h1>
    <p class="text-sm text-slate-500 mt-1">Your account information</p>
  </div>
  <%= link_to "Edit Profile", edit_dashboard_profile_path, class: "px-4 py-2 text-sm font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-xl hover:bg-pd-hover hover:border-slate-600/50 transition-all" %>
</header>

<div class="p-8 px-10">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <%# Profile info card %>
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl overflow-hidden">
      <div class="px-6 py-5 border-b border-slate-700/20">
        <h2 class="text-lg font-semibold text-slate-100">Account Details</h2>
      </div>
      <div class="p-6">
        <div class="flex items-center gap-5 mb-6">
          <div class="w-20 h-20 bg-gradient-to-br from-pd-elevated to-pd-tertiary border-2 border-slate-700/30 rounded-full flex items-center justify-center font-bold text-2xl text-slate-400">
            <% if @user.has_profile_photo? %>
              <%= image_tag @user.profile_photo_url(variant: :medium), class: "w-full h-full object-cover rounded-full" %>
            <% else %>
              <%= @user.initials %>
            <% end %>
          </div>
          <div>
            <div class="text-xl font-bold text-slate-100"><%= @user.full_name %></div>
            <div class="text-slate-400">@<%= @user.username %></div>
          </div>
        </div>

        <div class="space-y-4">
          <div>
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-1">Email</div>
            <div class="text-slate-400 flex items-center gap-2">
              <%= @user.email %>
              <% if @user.email_verified? %>
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-emerald-500/15 text-emerald-500">Verified</span>
              <% else %>
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-amber-500/15 text-amber-500">Unverified</span>
              <% end %>
            </div>
          </div>

          <div>
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-1">User ID</div>
            <div class="font-mono text-slate-400"><%= @user.pd_id %></div>
          </div>

          <div>
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-1">Member Since</div>
            <div class="text-slate-400"><%= @user.created_at.strftime("%B %d, %Y") %></div>
          </div>
        </div>
      </div>
    </div>

    <%# Account status card %>
    <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl overflow-hidden">
      <div class="px-6 py-5 border-b border-slate-700/20">
        <h2 class="text-lg font-semibold text-slate-100">Account Status</h2>
      </div>
      <div class="p-6">
        <div class="space-y-4">
          <div>
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-1">Status</div>
            <div>
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide <%= @user.active? ? 'bg-emerald-500/15 text-emerald-500' : 'bg-amber-500/15 text-amber-500' %>"><%= @user.status.titleize %></span>
            </div>
          </div>

          <div>
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-1">Access Level</div>
            <div>
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-blue-500/15 text-blue-400"><%= @user.access_level.titleize %></span>
            </div>
          </div>

          <% if @user.staff? %>
          <div>
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-1">Staff Status</div>
            <div>
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-blue-500/15 text-blue-400">Staff Member</span>
            </div>
          </div>
          <% end %>

          <div>
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-1">Last Active</div>
            <div class="text-slate-400">
              <%= @user.last_seen_at ? time_ago_in_words(@user.last_seen_at) + " ago" : "Just now" %>
            </div>
          </div>

          <div>
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-1">Active Sessions</div>
            <div class="text-slate-400"><%= @user.user_sessions.active.count %></div>
          </div>

          <div>
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-1">API Keys</div>
            <div class="text-slate-400"><%= @user.user_api_keys.active.count %> active</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
