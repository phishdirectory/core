<% content_for :title, "Edit Profile" %>

<header class="px-10 py-6 border-b border-slate-700/20 flex items-center justify-between bg-pd-secondary sticky top-0 z-40">
  <div>
    <h1 class="text-2xl font-bold text-slate-100">Edit Profile</h1>
    <p class="text-sm text-slate-500 mt-1">Update your account information</p>
  </div>
  <%= link_to "Cancel", dashboard_profile_path, class: "px-4 py-2 text-sm font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-xl hover:bg-pd-hover hover:border-slate-600/50 transition-all" %>
</header>

<div class="p-8 px-10">
  <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl overflow-hidden max-w-xl mb-6">
    <div class="p-6">
      <%= form_with model: @user, url: dashboard_profile_path, method: :patch do |f| %>
        <% if @user.errors.any? %>
          <div class="bg-red-500/15 border border-red-500/30 rounded-xl p-4 mb-6 text-red-400 text-sm">
            <ul class="list-disc pl-5 space-y-1">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="grid grid-cols-2 gap-4 mb-5">
          <div>
            <label for="user_first_name" class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">First Name</label>
            <%= f.text_field :first_name, class: "w-full px-4 py-3 bg-pd-primary border border-slate-600/40 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-accent focus:ring-2 focus:ring-cyan-accent/20 transition-all", required: true %>
          </div>
          <div>
            <label for="user_last_name" class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Last Name</label>
            <%= f.text_field :last_name, class: "w-full px-4 py-3 bg-pd-primary border border-slate-600/40 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-accent focus:ring-2 focus:ring-cyan-accent/20 transition-all", required: true %>
          </div>
        </div>

        <div class="mb-5">
          <label for="user_profile_photo" class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Profile Photo</label>
          <% if @user.has_profile_photo? %>
            <div class="flex items-center gap-4 mb-3">
              <%= image_tag @user.profile_photo_url(:thumb), class: "w-14 h-14 object-cover rounded-full border-2 border-slate-700/30" %>
              <span class="text-sm text-slate-400">Current photo</span>
            </div>
          <% end %>
          <%= f.file_field :profile_photo, class: "w-full px-4 py-2.5 bg-pd-primary border border-slate-600/40 rounded-xl text-slate-100 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-pd-elevated file:text-slate-300 hover:file:bg-pd-hover transition-all", accept: "image/jpeg,image/png,image/webp" %>
          <p class="text-xs text-slate-500 mt-2">JPEG, PNG, or WebP. Max 5MB.</p>
        </div>

        <div class="flex gap-3 mt-6">
          <%= f.submit "Save Changes", class: "px-5 py-3 bg-cyan-accent text-pd-primary font-semibold rounded-xl hover:shadow-[0_0_20px_rgba(63,196,224,0.4)] hover:-translate-y-0.5 transition-all cursor-pointer" %>
          <%= link_to "Cancel", dashboard_profile_path, class: "px-5 py-3 text-sm font-medium text-slate-400 bg-pd-elevated border border-slate-700/30 rounded-xl hover:bg-pd-hover hover:border-slate-600/50 transition-all" %>
        </div>
      <% end %>
    </div>
  </div>

  <%# Read-only info %>
  <div class="bg-pd-secondary border border-slate-700/20 rounded-2xl overflow-hidden max-w-xl">
    <div class="px-6 py-5 border-b border-slate-700/20 flex items-center justify-between">
      <h2 class="text-lg font-semibold text-slate-100">Account Information</h2>
      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold font-mono uppercase tracking-wide bg-slate-600/30 text-slate-400">Read-only</span>
    </div>
    <div class="p-6">
      <p class="text-slate-400 text-sm mb-4">
        These fields cannot be changed. Contact support if you need assistance.
      </p>
      <div class="space-y-4">
        <div>
          <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-1">Email</div>
          <div class="text-slate-400"><%= @user.email %></div>
        </div>
        <div>
          <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-1">Username</div>
          <div class="text-slate-400">@<%= @user.username %></div>
        </div>
        <div>
          <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-1">User ID</div>
          <div class="font-mono text-slate-400"><%= @user.pd_id %></div>
        </div>
      </div>
    </div>
  </div>
</div>
