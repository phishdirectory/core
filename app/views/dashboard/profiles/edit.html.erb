<% content_for :title, "Edit Profile" %>

<header class="px-8 py-6 border-b border-surface-200/50 flex items-center justify-between bg-surface-50/50 sticky top-0 z-40 backdrop-blur-sm">
  <div>
    <h1 class="text-xl font-semibold text-surface-900">Edit Profile</h1>
    <p class="text-sm text-surface-500 mt-0.5">Update your account information</p>
  </div>
  <%= link_to "Cancel", dashboard_profile_path, class: "px-4 py-2 text-sm font-medium text-surface-600 bg-surface-100 rounded-md hover:bg-surface-200 transition-colors" %>
</header>

<div class="p-8">
  <div class="bg-surface-100 rounded-lg overflow-hidden max-w-xl mb-6">
    <div class="p-5">
      <%= form_with model: @user, url: dashboard_profile_path, method: :patch do |f| %>
        <% if @user.errors.any? %>
          <div class="bg-danger/10 text-danger rounded-md p-3 mb-5 text-sm">
            <ul class="list-disc pl-4 space-y-1">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="grid grid-cols-2 gap-4 mb-4">
          <div>
            <label for="user_first_name" class="block text-xs font-medium text-surface-600 mb-1.5">First Name</label>
            <%= f.text_field :first_name, class: "w-full px-3 py-2.5 bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 placeholder-surface-500 text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-colors", required: true %>
          </div>
          <div>
            <label for="user_last_name" class="block text-xs font-medium text-surface-600 mb-1.5">Last Name</label>
            <%= f.text_field :last_name, class: "w-full px-3 py-2.5 bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 placeholder-surface-500 text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-colors", required: true %>
          </div>
        </div>

        <div class="mb-4">
          <label for="user_profile_photo" class="block text-xs font-medium text-surface-600 mb-1.5">Profile Photo</label>
          <% if @user.has_profile_photo? %>
            <div class="flex items-center gap-3 mb-3">
              <%= image_tag @user.profile_photo_url(:thumb), class: "w-12 h-12 object-cover rounded-full" %>
              <span class="text-xs text-surface-500">Current photo</span>
            </div>
          <% end %>
          <%= f.file_field :profile_photo, class: "w-full px-3 py-2 bg-surface-200 border border-surface-300/50 rounded-md text-surface-900 text-sm file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-xs file:font-medium file:bg-surface-300 file:text-surface-700 hover:file:bg-surface-400 transition-colors", accept: "image/jpeg,image/png,image/webp" %>
          <p class="text-xs text-surface-500 mt-1.5">JPEG, PNG, or WebP. Max 5MB.</p>
        </div>

        <div class="flex gap-3 mt-5">
          <%= f.submit "Save Changes", class: "px-5 py-2.5 bg-surface-900 text-surface-0 font-medium text-sm rounded-md hover:bg-surface-800 transition-colors cursor-pointer" %>
          <%= link_to "Cancel", dashboard_profile_path, class: "px-5 py-2.5 text-sm font-medium text-surface-600 bg-surface-200 rounded-md hover:bg-surface-300 transition-colors" %>
        </div>
      <% end %>
    </div>
  </div>

  <%# Read-only info %>
  <div class="bg-surface-100 rounded-lg overflow-hidden max-w-xl">
    <div class="px-5 py-4 border-b border-surface-200/50 flex items-center justify-between">
      <h2 class="text-sm font-semibold text-surface-900">Account Information</h2>
      <span class="text-xs font-medium text-surface-500">Read-only</span>
    </div>
    <div class="p-5">
      <p class="text-sm text-surface-600 mb-4">
        These fields cannot be changed. Contact support if you need assistance.
      </p>
      <div class="space-y-4">
        <div>
          <div class="text-xs font-medium text-surface-500 mb-1">Email</div>
          <div class="text-sm text-surface-700"><%= @user.email %></div>
        </div>
        <div>
          <div class="text-xs font-medium text-surface-500 mb-1">Username</div>
          <div class="text-sm text-surface-700">@<%= @user.username %></div>
        </div>
        <div>
          <div class="text-xs font-medium text-surface-500 mb-1">User ID</div>
          <div class="font-mono text-sm text-surface-600"><%= @user.pd_id %></div>
        </div>
      </div>
    </div>
  </div>
</div>
