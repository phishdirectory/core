<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Redirecting...</title>
</head>
<body onload="document.forms[0].submit();">
  <noscript>
    <p>JavaScript is required to complete this authentication. Please enable JavaScript and try again.</p>
  </noscript>

  <form method="post" action="<%= @service_provider.assertion_consumer_service_url %>">
    <%# saml_idp already returns a base64 string, so encoding again produced a
        SAMLResponse no service provider could read. %>
    <input type="hidden" name="SAMLResponse" value="<%= @saml_response %>">
    <% if saml_relay_state.present? %>
      <input type="hidden" name="RelayState" value="<%= saml_relay_state %>">
    <% end %>

    <noscript>
      <p>Click the button below to continue:</p>
      <input type="submit" value="Continue">
    </noscript>
  </form>
</body>
</html>
